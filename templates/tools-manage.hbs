<div class="fwmb-tool-content">
    {{#*inline "mapNode"}}
        <div class="fwmb-accordion-group">
            <div class="fwmb-map-card" data-id="{{this.id}}">
                <div class="fwmb-map-card-info">
                    {{this.name}}
                </div>

                <div class="fwmb-map-card-actions">
                    <button type="button" data-action="manageMap" data-action-type="load" data-tooltip="{{localize 'FILRODENSWMB.UI.Load'}}">
                        <i class="fwmb-icon fwmb-icon--file-open"></i>
                    </button>

                    <div class="fwmb-dropdown" tabindex="0">
                        <button type="button" aria-label="{{localize 'FILRODENSWMB.UI.MapActions'}}" data-tooltip="{{localize 'FILRODENSWMB.UI.MapActions'}}">
                            <i class="fwmb-icon fwmb-icon--more-vert"></i>
                        </button>

                        <div class="fwmb-dropdown-menu">
                            <button type="button" data-action="manageMap" data-action-type="rename">
                                <i class="fwmb-icon fwmb-icon--edit"></i>
                                {{localize "FILRODENSWMB.UI.Rename"}}
                            </button>
                            <button type="button" data-action="manageMap" data-action-type="duplicate">
                                <i class="fwmb-icon fwmb-icon--content-copy"></i>
                                {{localize "FILRODENSWMB.UI.Duplicate"}}
                            </button>
                            {{!-- Only a regional map has a parent to leave; a top map's copy is Duplicate --}}
                            {{#if this.parentId}}
                            <button type="button" data-action="manageMap" data-action-type="promote">
                                <i class="fwmb-icon fwmb-icon--upgrade"></i>
                                {{localize "FILRODENSWMB.UI.Promote"}}
                            </button>
                            {{/if}}
                            <button type="button" data-action="manageMap" data-action-type="export">
                                <i class="fwmb-icon fwmb-icon--file-export"></i>
                                {{localize "FILRODENSWMB.UI.Export"}}
                            </button>
                            <button type="button" data-action="manageMap" data-action-type="delete" class="fwmb-danger fwmb-menu-item--separated">
                                <i class="fwmb-icon fwmb-icon--delete"></i>
                                {{localize "FILRODENSWMB.UI.Delete"}}
                            </button>
                        </div>
                    </div>
                </div>
            </div>

            {{#if this.children.length}}
                <div class="fwmb-accordion-content fwmb-accordion-content--nested">
                    {{#each this.children}}
                        {{> mapNode this}}
                    {{/each}}
                </div>
            {{/if}}
        </div>
    {{/inline}}

    <div class="fwmb-panel-header">
        <h3>{{localize "FILRODENSWMB.UI.SavedMaps"}}</h3>
    </div>

    <div class="fwmb-map-list fwmb-scrollable fwmb-scrollable--stable">
        {{#each savedMaps}}
            {{> mapNode this}}
        {{else}}
            <div class="fwmb-empty-state">
                <p>{{localize "FILRODENSWMB.UI.NoSavedMaps"}}</p>
            </div>
        {{/each}}
    </div>

    <div class="fwmb-divider"></div>

    <button type="button" class="fwmb-btn" data-action="importMapJson">
        <i class="fwmb-icon fwmb-icon--upload-file"></i>
        {{localize "FILRODENSWMB.UI.ImportJSON"}}
    </button>
</div>