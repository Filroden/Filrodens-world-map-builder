{{!--
    The inspector's river (see RiverEditor): its name and width, on a map from terrain revision 3
    on its corridor width and whether it cuts through high ground, and Focus view and Delete. Every
    field applies when committed, one undo step each (see Inspector); all but the name carve the
    river again.
--}}
<div class="fwmb-group">
    <div class="fwmb-form-group">
        <label class="fwmb-label" for="fwmb-inspector-name">{{localize "FILRODENSWMB.UI.Name"}}</label>
        <div class="fwmb-form-fields">
            <input type="text" id="fwmb-inspector-name" name="riverName" maxlength="{{fwmbTextLimit 'name'}}" value="{{river.name}}" />
        </div>
    </div>
    <div class="fwmb-form-group">
        <label class="fwmb-label" for="fwmb-inspector-river-width">{{localize "FILRODENSWMB.UI.RiverWidth"}}</label>
        <div class="fwmb-form-fields">
            <select id="fwmb-inspector-river-width" name="riverWidth">
                {{#each widths}}
                <option value="{{this.value}}" {{#if this.selected}}selected{{/if}}>{{localize this.label}}</option>
                {{/each}}
            </select>
        </div>
    </div>
    {{#if guided}}
    {{> "modules/filrodens-world-map-builder/templates/parts/shared-range.hbs" name="riverCorridor" label="FILRODENSWMB.UI.RiverCorridor" hint="FILRODENSWMB.UI.RiverCorridorHint" value=corridor.value min=corridor.min max=corridor.max step=1 unit="FILRODENSWMB.UI.RiverCorridorUnit" unitShort="FILRODENSWMB.UI.RiverCorridorUnitShort"}}
    <label class="fwmb-checkbox-label" data-tooltip="{{localize 'FILRODENSWMB.UI.RiverCutThroughHint'}}">
        <input type="checkbox" class="fwmb-checkbox" name="riverCutThrough" {{#if river.cutThrough}}checked{{/if}} />
        {{localize "FILRODENSWMB.UI.RiverCutThrough"}}
    </label>
    {{/if}}
</div>

<div class="fwmb-inspector-actions">
    <button type="button" class="fwmb-btn fwmb-btn--subtle" data-inspector-action="zoom"><i class="fwmb-icon fwmb-icon--center-focus" aria-hidden="true"></i>{{localize "FILRODENSWMB.UI.ZoomTo"}}</button>
    <button type="button" class="fwmb-btn fwmb-btn--danger-quiet fwmb-inspector-delete" data-inspector-action="delete"><i class="fwmb-icon fwmb-icon--delete" aria-hidden="true"></i>{{localize "FILRODENSWMB.UI.Delete"}}</button>
</div>
<p class="fwmb-hint fwmb-inspector-hint">{{localize "FILRODENSWMB.UI.InspectorApplyHint"}}</p>
