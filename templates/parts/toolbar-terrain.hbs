<div class="fwmb-toolbar-content">
    <div class="fwmb-brush-settings">
        {{> "modules/filrodens-world-map-builder/templates/parts/toolbar-shared-brush-size.hbs"}}

        <div class="fwmb-brush-setting">
            <label>{{localize "FILRODENSWMB.UI.BrushStrength"}}</label>
            <div class="fwmb-slider-group">
                <input type="range" name="brushStrength" value="{{lookup uiState 'brushStrength'}}" min="0.01" max="0.05" step="0.01" />
                <output>{{lookup uiState 'brushStrength'}}</output>
            </div>
        </div>

        <div class="fwmb-brush-setting">
            <label>{{localize "FILRODENSWMB.UI.BrushFeather"}}</label>
            <div class="fwmb-slider-group">
                <input type="range" name="brushFeather" value="{{lookup uiState 'brushFeather'}}" min="0" max="0.8" step="0.1" />
                <output>{{lookup uiState 'brushFeather'}}</output>
            </div>
        </div>
    </div>

    <div class="fwmb-divider-vertical"></div>

    <div class="fwmb-brush-tools">
        <button type="button" data-action="setBrushTool" data-tool="raise" class="fwmb-btn {{#if (eq uiState.terrainBrushTool 'raise')}}active{{/if}}" data-tooltip="{{localize 'FILRODENSWMB.UI.ToolRaise'}}">
            <i class="fwmb-icon edit-arrow-up"></i>
        </button>
        <button type="button" data-action="setBrushTool" data-tool="lower" class="fwmb-btn {{#if (eq uiState.terrainBrushTool 'lower')}}active{{/if}}" data-tooltip="{{localize 'FILRODENSWMB.UI.ToolLower'}}">
            <i class="fwmb-icon edit-arrow-down"></i>
        </button>
        <button type="button" data-action="setBrushTool" data-tool="smooth" class="fwmb-btn {{#if (eq uiState.terrainBrushTool 'smooth')}}active{{/if}}" data-tooltip="{{localize 'FILRODENSWMB.UI.ToolSmooth'}}">
            <i class="fwmb-icon landscape"></i>
        </button>
        <button type="button" data-action="setBrushTool" data-tool="slopeUp" class="fwmb-btn {{#if (eq uiState.terrainBrushTool 'slopeUp')}}active{{/if}}" data-tooltip="{{localize 'FILRODENSWMB.UI.ToolSlopeUp'}}">
            <i class="fwmb-icon slope"></i>
        </button>
        <button type="button" data-action="setBrushTool" data-tool="level" class="fwmb-btn {{#if (eq uiState.terrainBrushTool 'level')}}active{{/if}}" data-tooltip="{{localize 'FILRODENSWMB.UI.ToolLevel'}}">
            <i class="fwmb-icon plateau"></i>
        </button>
        <button type="button" data-action="setBrushTool" data-tool="slopeDown" class="fwmb-btn {{#if (eq uiState.terrainBrushTool 'slopeDown')}}active{{/if}}" data-tooltip="{{localize 'FILRODENSWMB.UI.ToolSlopeDown'}}">
            <i class="fwmb-icon slope reverse"></i>
        </button>
    </div>
</div>