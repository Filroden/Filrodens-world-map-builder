<div class="fwmb-toolbar-content">

    {{#if (eq uiState.generationEngine "guided")}}
        <label>{{localize "FILRODENSWMB.UI.LandMaskHint"}}</label>
        <div class="fwmb-mask-settings">
            <button type="button" class="fwmb-btn {{#if (eq uiState.sceneMode 'addMask')}}active{{/if}}" data-action="setSceneMode" data-mode="addMask" data-tooltip="{{localize 'FILRODENSWMB.UI.DrawLandMaskHint'}}">
                <i class="fwmb-icon add"></i>
            </button>

            <button type="button" class="fwmb-btn {{#if (eq uiState.sceneMode 'subtractMask')}}active{{/if}}" data-action="setSceneMode" data-mode="subtractMask" data-tooltip="{{localize 'FILRODENSWMB.UI.DrawOceanMaskHint'}}">
                <i class="fwmb-icon remove"></i>
            </button>
        </div>

        <div class="fwmb-divider-vertical"></div>

        <button type="button" class="fwmb-btn subtle danger" data-action="deleteAllLandMasks" data-tooltip="{{localize 'FILRODENSWMB.UI.DeleteAllLandMasksHint'}}" {{#unless landMasks.length}}disabled{{/unless}}>
            <i class="fwmb-icon delete"></i>
        </button>

        <div class="fwmb-divider-vertical"></div>

        <button type="button" class="fwmb-btn primary" data-action="toggleEditMode">
            <i class="fwmb-icon edit-off"></i> {{localize "FILRODENSWMB.UI.EndEdit"}}
        </button>
    {{else}}
        <div class="fwmb-brush-settings">
            <button type="button" data-action="setBrushTool" data-tool="crop" class="fwmb-btn {{#if (eq uiState.sceneBrushTool 'crop')}}active{{/if}}" data-tooltip="{{localize 'FILRODENSWMB.UI.ToolRegionalMap'}}">
                <i class="fwmb-icon crop"></i>
            </button>
            <div class="fwmb-brush-setting">
                <label>{{localize "FILRODENSWMB.UI.RegionalResolution"}}</label>
                <div class="fwmb-flex-row">
                    <input type="number" name="regionalTargetWidth" value="{{lookup uiState 'regionalTargetWidth'}}" class="fwmb-flex-1" title="{{localize 'FILRODENSWMB.UI.TargetWidth'}}" step="100" min="500" />
                    <span style="align-self: center; margin: 0 4px;">x</span>
                    <input type="number" name="regionalTargetHeight" value="{{lookup uiState 'regionalTargetHeight'}}" class="fwmb-flex-1" disabled title="{{localize 'FILRODENSWMB.UI.CalculatedHeight'}}" />
                </div>
            </div>
            <div class="fwmb-brush-setting">
                <label>{{localize "FILRODENSWMB.UI.RegionalLatitude"}}</label>
                <div class="fwmb-setting-row" style="justify-content: space-between; font-size: 0.9em;">
                    <span>{{localize "FILRODENSWMB.UI.LatTop"}}: <strong id="fwmb-readout-lat-top">--&deg;</strong></span>
                    <span>{{localize "FILRODENSWMB.UI.LatBottom"}}: <strong id="fwmb-readout-lat-bottom">--&deg;</strong></span>
                </div>
            </div>
        </div>
        <div class="fwmb-divider-vertical"></div>
        <button type="button" data-action="generateRegionalMap" class="fwmb-btn primary wide">
            <i class="fwmb-icon map"></i> {{localize "FILRODENSWMB.UI.GenerateMap"}}
        </button>
    {{/if}}

</div>