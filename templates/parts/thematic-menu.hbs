{{!--
    The Thematic layers menu's rows (see ThematicView): a note when the map's run cannot show
    them, the colour layers as one choice with None first, the line layers (each on or off), and
    the colour layer's opacity. Their state is written by MapControls.syncMapControls; the opacity
    slider has no name, so a save's read of the panel never takes it for a map setting (the
    setting is uiState.thematic).

    Parameters: thematic (ThematicView.menuContext).
--}}
<div class="fwmb-layer-menu-label fwmb-layer-menu-note fwmb-hidden" role="presentation" data-thematic-note></div>
<button type="button" role="menuitemradio" aria-checked="true" data-action="setThematicFill" data-thematic-layer="{{thematic.none}}">
    <span class="fwmb-layer-check" aria-hidden="true"></span>{{localize "FILRODENSWMB.UI.ThematicNone"}}
</button>
{{#each thematic.layers}}
<button type="button" role="menuitemradio" aria-checked="false" data-action="setThematicFill" data-thematic-layer="{{this.id}}">
    <span class="fwmb-layer-check" aria-hidden="true"></span>{{localize this.label}}
</button>
{{/each}}
{{!-- The line layers, shown beside the colour layer, each on or off --}}
<div class="fwmb-layer-menu-sep" role="separator"></div>
{{#each thematic.lines}}
<button type="button" role="menuitemcheckbox" aria-checked="false" data-action="toggleThematicLine" data-thematic-line="{{this.id}}">
    <span class="fwmb-layer-check" aria-hidden="true"></span>{{localize this.label}}
</button>
{{/each}}
<div class="fwmb-range fwmb-layer-menu-range" role="none">
    <div class="fwmb-range-header">
        <label class="fwmb-range-label"><span class="fwmb-range-name">{{localize "FILRODENSWMB.UI.ThematicOpacity"}}</span></label>
        <span class="fwmb-range-reading"><output class="fwmb-range-value">{{thematic.opacity.value}}</output></span>
    </div>
    <input type="range" class="fwmb-range-input" data-thematic-opacity value="{{thematic.opacity.value}}" min="{{thematic.opacity.min}}" max="{{thematic.opacity.max}}" step="{{thematic.opacity.step}}" aria-label="{{localize 'FILRODENSWMB.UI.ThematicOpacity'}}" />
</div>
