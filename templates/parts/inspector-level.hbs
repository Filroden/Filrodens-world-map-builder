{{!--
    The inspector's level (see LevelEditor): its name and title template; its parent, nesting and
    visibility; its opacity and territorial waters; its borders (with Copy style from another
    level); and Delete. Every field applies when committed, one undo step each (see Inspector).
--}}
<div class="fwmb-group">
    <div class="fwmb-form-group">
        <label class="fwmb-label" for="fwmb-inspector-name">{{localize "FILRODENSWMB.UI.Name"}}</label>
        <div class="fwmb-form-fields">
            <input type="text" id="fwmb-inspector-name" name="levelName" maxlength="{{fwmbTextLimit 'name'}}" value="{{level.name}}" />
        </div>
    </div>
    <div class="fwmb-form-group">
        <label class="fwmb-label" for="fwmb-inspector-level-title">{{localize "FILRODENSWMB.UI.LevelTitleTemplate"}}</label>
        <div class="fwmb-form-fields">
            <input type="text" id="fwmb-inspector-level-title" name="levelTitleTemplate" maxlength="{{fwmbTextLimit 'name'}}" value="{{level.titleTemplate}}" />
            <i class="fwmb-icon fwmb-icon--info" data-tooltip="{{localize 'FILRODENSWMB.UI.LevelTitleTemplateHint'}}" aria-label="{{localize 'FILRODENSWMB.UI.LevelTitleTemplateHint'}}"></i>
        </div>
    </div>
    <div class="fwmb-form-group">
        <label class="fwmb-label" for="fwmb-inspector-level-parent">{{localize "FILRODENSWMB.UI.LevelParent"}}</label>
        <div class="fwmb-form-fields">
            <select id="fwmb-inspector-level-parent" name="levelParent">
                <option value="" {{#unless level.parentLevelId}}selected{{/unless}}>{{localize "FILRODENSWMB.UI.LevelNoParent"}}</option>
                {{#each parents}}
                <option value="{{this.id}}" {{#if this.selected}}selected{{/if}}>{{this.name}}</option>
                {{/each}}
            </select>
        </div>
    </div>
    <div class="fwmb-form-group">
        <label class="fwmb-label" for="fwmb-inspector-level-nesting">{{localize "FILRODENSWMB.UI.LevelNesting"}}</label>
        <div class="fwmb-form-fields">
            <select id="fwmb-inspector-level-nesting" name="levelNesting">
                {{#each nestingModes}}
                <option value="{{this.value}}" {{#if this.selected}}selected{{/if}}>{{localize this.label}}</option>
                {{/each}}
            </select>
            <i class="fwmb-icon fwmb-icon--info" data-tooltip="{{localize 'FILRODENSWMB.UI.LevelNestingHint'}}" aria-label="{{localize 'FILRODENSWMB.UI.LevelNestingHint'}}"></i>
        </div>
    </div>
    <div class="fwmb-form-group">
        <label class="fwmb-label" for="fwmb-inspector-visibility">{{localize "FILRODENSWMB.UI.Visibility"}}</label>
        <div class="fwmb-form-fields">
            <select id="fwmb-inspector-visibility" name="levelVisibility">
                {{#each visibilities}}
                <option value="{{this.value}}" {{#if this.selected}}selected{{/if}}>{{localize this.label}}</option>
                {{/each}}
            </select>
        </div>
    </div>
    {{> "modules/filrodens-world-map-builder/templates/parts/shared-range.hbs" name="levelOpacity" label="FILRODENSWMB.UI.LevelOpacity" value=level.opacity min=0 max=1 step=0.05}}
    {{> "modules/filrodens-world-map-builder/templates/parts/shared-range.hbs" name="levelWatersPx" label="FILRODENSWMB.UI.LevelWaters" hint="FILRODENSWMB.UI.LevelWatersHint" value=level.watersPx min=0 max=waters.MAX_PX step=waters.STEP_PX displayScale=waters.kmPerPx display=waters.display unitText=waters.unit}}
</div>

<div class="fwmb-group">
    <div class="fwmb-section-title">{{localize "FILRODENSWMB.UI.LevelBorders"}}</div>
    {{#if copySources.length}}
    <div class="fwmb-form-group">
        <label class="fwmb-label" for="fwmb-inspector-level-copy">{{localize "FILRODENSWMB.UI.LevelCopyStyle"}}</label>
        <div class="fwmb-form-fields">
            <select id="fwmb-inspector-level-copy" name="levelCopyStyle">
                <option value="" selected>{{localize "FILRODENSWMB.UI.LevelCopyStyleChoose"}}</option>
                {{#each copySources}}
                <option value="{{this.id}}">{{this.name}}</option>
                {{/each}}
            </select>
        </div>
    </div>
    {{/if}}
    <div class="fwmb-form-group">
        <label class="fwmb-label" for="fwmb-inspector-level-color">{{localize "FILRODENSWMB.UI.LineColor"}}</label>
        <div class="fwmb-form-fields">
            <input type="color" id="fwmb-inspector-level-color" class="fwmb-swatch" name="levelLineColor" value="{{level.style.lineColor}}" />
        </div>
    </div>
    {{> "modules/filrodens-world-map-builder/templates/parts/shared-range.hbs" name="levelLineThickness" label="FILRODENSWMB.UI.LandBorderThickness" value=level.style.lineThickness min=0 max=8 step=thicknessStep}}
    <div class="fwmb-form-group">
        <label class="fwmb-label" for="fwmb-inspector-level-line">{{localize "FILRODENSWMB.UI.LandBorderStyle"}}</label>
        <div class="fwmb-form-fields">
            <select id="fwmb-inspector-level-line" name="levelLineStyle">
                {{#each lineStyles}}
                <option value="{{this.value}}" {{#if this.selected}}selected{{/if}}>{{localize this.label}}</option>
                {{/each}}
            </select>
        </div>
    </div>
    {{> "modules/filrodens-world-map-builder/templates/parts/shared-range.hbs" name="levelSeaLineThickness" label="FILRODENSWMB.UI.SeaBorderThickness" value=level.style.seaLineThickness min=0 max=8 step=thicknessStep}}
    <div class="fwmb-form-group">
        <label class="fwmb-label" for="fwmb-inspector-level-sea-line">{{localize "FILRODENSWMB.UI.SeaBorderStyle"}}</label>
        <div class="fwmb-form-fields">
            <select id="fwmb-inspector-level-sea-line" name="levelSeaLineStyle">
                {{#each seaLineStyles}}
                <option value="{{this.value}}" {{#if this.selected}}selected{{/if}}>{{localize this.label}}</option>
                {{/each}}
            </select>
        </div>
    </div>
    <label class="fwmb-checkbox-label" data-tooltip="{{localize 'FILRODENSWMB.UI.LevelScaleWithMapHint'}}">
        <input type="checkbox" class="fwmb-checkbox" name="levelScaleWithMap" {{#if level.style.scaleWithMap}}checked{{/if}} />
        {{localize "FILRODENSWMB.UI.LevelScaleWithMap"}}
    </label>
</div>

<div class="fwmb-inspector-actions">
    <button type="button" class="fwmb-btn fwmb-btn--danger-quiet fwmb-inspector-delete" data-inspector-action="delete"><i class="fwmb-icon fwmb-icon--delete" aria-hidden="true"></i>{{localize "FILRODENSWMB.UI.Delete"}}</button>
</div>
<p class="fwmb-hint fwmb-inspector-hint">{{localize "FILRODENSWMB.UI.InspectorApplyHint"}}</p>
