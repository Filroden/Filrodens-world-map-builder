{{!-- The Regions tool's bar (see RegionPainter.toolbarContext): Select (which does not edit) and the
     painting modes, the brush size for the brush modes, whether every level is drawn while painting,
     and the style new regions start with. The region being painted is in the readout. --}}
{{#each bar.modeGroups}}{{> "modules/filrodens-world-map-builder/templates/parts/bar-modes.hbs" group=this}}{{/each}}
{{#if regionToolbar.usesBrush}}
    <span class="fwmb-sep"></span>
    {{> "modules/filrodens-world-map-builder/templates/parts/toolbar-shared-brush-size.hbs"}}
{{/if}}
<span class="fwmb-sep"></span>
<button type="button" data-action="toggleRegionShowAll" class="fwmb-btn fwmb-btn--subtle" aria-pressed="{{#if regionToolbar.showAll}}true{{else}}false{{/if}}" data-tooltip="{{localize 'FILRODENSWMB.UI.ShowAllLevelsHint'}}">
    <i class="fwmb-icon fwmb-icon--layers" aria-hidden="true"></i> {{localize "FILRODENSWMB.UI.ShowAllLevels"}}
</button>
<label class="fwmb-bar-field">
    <span class="fwmb-label">{{localize "FILRODENSWMB.UI.NewRegionStyle"}}</span>
    <select name="activeRegionQuickStyle">
        <option value="custom" {{#if (eq uiState.activeRegionQuickStyle "custom")}}selected{{/if}}>{{localize "FILRODENSWMB.UI.PresetColors"}}</option>
        {{#each regionStyles}}
            <option value="{{this.id}}" {{#if (eq ../uiState.activeRegionQuickStyle this.id)}}selected{{/if}}>{{this.label}}</option>
        {{/each}}
    </select>
</label>
