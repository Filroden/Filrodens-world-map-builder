{{!--
    The style picker beside a styled kind's fields in the inspector (see InspectorFields): the
    style the object follows, or Custom, and Save as…, which makes a style from the object's
    fields and connects the object to it.

    Parameters:
      name: the select's name (regionQuickStyle, routeQuickStyle, labelQuickStyle)
      choices: InspectorFields.styleChoices: { value, name, selected }, Custom first
      type: the style type Save as… makes (Region, Route, Label; see InspectorFields.STYLE_TYPES)
--}}
<div class="fwmb-form-group">
    <label class="fwmb-label" for="fwmb-inspector-{{name}}">{{localize "FILRODENSWMB.UI.InspectorStyle"}}</label>
    <div class="fwmb-form-fields">
        <select id="fwmb-inspector-{{name}}" name="{{name}}">
            {{#each choices}}
            <option value="{{this.value}}" {{#if this.selected}}selected{{/if}}>{{#if this.name}}{{this.name}}{{else}}{{localize "FILRODENSWMB.UI.Custom"}}{{/if}}</option>
            {{/each}}
        </select>
        <button type="button" class="fwmb-btn fwmb-btn--secondary" data-inspector-action="saveStyle" data-style-type="{{type}}" data-tooltip="{{localize 'FILRODENSWMB.UI.SaveStyleAsHint'}}">{{localize "FILRODENSWMB.UI.SaveStyleAs"}}</button>
    </div>
</div>
