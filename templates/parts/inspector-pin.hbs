{{!--
    The inspector's pin (see PinEditor): its name, description and visibility; its look (a pin
    style, or its own icon, colour and scale); its label; and Focus view and Delete. Every field
    applies when committed, one undo step each (see Inspector). The icon grid is a disclosure: a
    choice in it applies at once and closes it.
--}}
<datalist id="fwmb-inspector-colors">
    {{#each palette}}
    <option value="{{this}}"></option>
    {{/each}}
</datalist>
<div class="fwmb-group">
    <div class="fwmb-form-group">
        <label class="fwmb-label" for="fwmb-inspector-name">{{localize "FILRODENSWMB.UI.Name"}}</label>
        <div class="fwmb-form-fields">
            <input type="text" id="fwmb-inspector-name" name="pinName" maxlength="{{fwmbTextLimit 'name'}}" value="{{pin.name}}" />
        </div>
    </div>
    <div class="fwmb-form-group fwmb-form-group--stacked">
        <label class="fwmb-label" for="fwmb-inspector-description">{{localize "FILRODENSWMB.UI.Description"}}</label>
        <div class="fwmb-form-fields">
            <textarea id="fwmb-inspector-description" class="fwmb-scrollable" name="pinDesc" maxlength="{{fwmbTextLimit 'description'}}" rows="3">{{pin.description}}</textarea>
        </div>
    </div>
    <div class="fwmb-form-group">
        <label class="fwmb-label" for="fwmb-inspector-visibility">{{localize "FILRODENSWMB.UI.Visibility"}}</label>
        <div class="fwmb-form-fields">
            <select id="fwmb-inspector-visibility" name="pinVisibility">
                {{#each visibilities}}
                <option value="{{this.value}}" {{#if this.selected}}selected{{/if}}>{{localize this.label}}</option>
                {{/each}}
            </select>
        </div>
    </div>
</div>

<div class="fwmb-group">
    <div class="fwmb-section-title">{{localize "FILRODENSWMB.UI.InspectorPinLook"}}{{#if pinStyleName}} <span class="fwmb-badge fwmb-badge--style">{{pinStyleName}}</span>{{/if}}</div>
    {{> "modules/filrodens-world-map-builder/templates/parts/style-picker.hbs" name="pinStyle" choices=pinStyles type="Pin"}}
    <div class="fwmb-form-group">
        <span class="fwmb-label">{{localize "FILRODENSWMB.UI.InspectorIcon"}}</span>
        <div class="fwmb-form-fields">
            <details class="fwmb-icon-picker">
                <summary class="fwmb-btn" aria-label="{{localize 'FILRODENSWMB.UI.InspectorChooseIcon'}}" data-tooltip-text="{{icon.label}}">
                    <i class="fwmb-icon {{#unless icon.isCustom}}fwmb-icon--{{icon.key}}{{/unless}}" {{#if icon.isCustom}}style="--fwmb-mask: url('{{icon.path}}');"{{/if}} aria-hidden="true"></i>
                    <span>{{icon.label}}</span>
                    <i class="fwmb-icon fwmb-icon--arrow-drop-down" aria-hidden="true"></i>
                </summary>
                <div class="fwmb-icon-grid fwmb-scrollable" role="listbox" aria-label="{{localize 'FILRODENSWMB.UI.InspectorIcon'}}">
                    {{#each icons}}
                    <button type="button" class="fwmb-btn fwmb-btn--square" role="option" aria-selected="{{#if this.selected}}true{{else}}false{{/if}}" data-inspector-action="pickIcon" data-icon="{{this.key}}" aria-label="{{this.label}}" data-tooltip-text="{{this.label}}">
                        <i class="fwmb-icon {{#unless this.isCustom}}fwmb-icon--{{this.key}}{{/unless}}" {{#if this.isCustom}}style="--fwmb-mask: url('{{this.path}}');"{{/if}} aria-hidden="true"></i>
                    </button>
                    {{/each}}
                </div>
            </details>
        </div>
    </div>
    <div class="fwmb-form-group">
        <label class="fwmb-label" for="fwmb-inspector-pin-color">{{localize "FILRODENSWMB.UI.InspectorColor"}}</label>
        <div class="fwmb-form-fields">
            <input type="color" id="fwmb-inspector-pin-color" class="fwmb-swatch" name="pinColor" value="{{pin.color}}" list="fwmb-inspector-colors" />
        </div>
    </div>
    {{> "modules/filrodens-world-map-builder/templates/parts/shared-range.hbs" name="pinScale" label="FILRODENSWMB.UI.InspectorScale" value=pin.scale min=0.2 max=16 step=0.1}}
</div>

{{> "modules/filrodens-world-map-builder/templates/parts/label-fields.hbs" label=label choices=labelChoices styleName=labelStyleName visibilities=labelVisibilities sectionId="inspectorLabel" sectionTitle="FILRODENSWMB.UI.InspectorLabel" closed=true}}

<div class="fwmb-inspector-actions">
    <button type="button" class="fwmb-btn fwmb-btn--subtle" data-inspector-action="zoom"><i class="fwmb-icon fwmb-icon--center-focus" aria-hidden="true"></i>{{localize "FILRODENSWMB.UI.ZoomTo"}}</button>
    <button type="button" class="fwmb-btn fwmb-btn--danger-quiet fwmb-inspector-delete" data-inspector-action="delete"><i class="fwmb-icon fwmb-icon--delete" aria-hidden="true"></i>{{localize "FILRODENSWMB.UI.Delete"}}</button>
</div>
<p class="fwmb-hint fwmb-inspector-hint">{{localize "FILRODENSWMB.UI.InspectorApplyHint"}}</p>
