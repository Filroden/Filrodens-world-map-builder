<div class="{{#unless uiState.isEditMode}}fwmb-hidden{{/unless}}">
    <datalist id="fwmb-region-colors">
        {{#each uiState.regionPresets}}
            <option value="{{this}}"></option>
        {{/each}}
    </datalist>

    <datalist id="fwmb-standard-colors">
        {{#each labelColorPalette}}
            <option value="{{this}}"></option>
        {{/each}}
    </datalist>

    {{> (lookup . 'toolbarPartial') }}
</div>