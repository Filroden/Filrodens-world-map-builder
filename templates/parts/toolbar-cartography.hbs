{{!-- Cartography's bar: Select (the default, which only picks decorations, opening them in the
     inspector) and Move (which drags, turns and resizes them and the scale bar), then Add
     decoration's menu: an image of the user's (a dialogue asks for it), or a decoration the module
     draws (added with its defaults and opened in the inspector). Neither mode is editing:
     Cartography has no edit toggle. --}}
{{#each bar.modeGroups}}{{> "modules/filrodens-world-map-builder/templates/parts/bar-modes.hbs" group=this}}{{/each}}
<span class="fwmb-sep"></span>
<div class="fwmb-dropdown fwmb-bar-add" tabindex="-1">
    <button type="button" class="fwmb-btn" aria-haspopup="menu" data-tooltip="{{localize 'FILRODENSWMB.UI.AddDecoration'}}">
        <i class="fwmb-icon fwmb-icon--add" aria-hidden="true"></i> {{localize "FILRODENSWMB.UI.AddDecorationShort"}}<i class="fwmb-icon fwmb-icon--arrow-drop-down" aria-hidden="true"></i>
    </button>
    <div class="fwmb-dropdown-menu" role="menu" aria-label="{{localize 'FILRODENSWMB.UI.AddDecoration'}}">
        <button type="button" role="menuitem" data-action="addDecoration" data-kind="image">
            <i class="fwmb-icon fwmb-icon--image" aria-hidden="true"></i> {{localize "FILRODENSWMB.UI.DecorationKindImage"}}
        </button>
        <button type="button" role="menuitem" data-action="addDecoration" data-kind="compass">
            <i class="fwmb-icon fwmb-icon--explore" aria-hidden="true"></i> {{localize "FILRODENSWMB.UI.DecorationKindCompass"}}
        </button>
        <button type="button" role="menuitem" data-action="addDecoration" data-kind="cartouche">
            <i class="fwmb-icon fwmb-icon--insert-text" aria-hidden="true"></i> {{localize "FILRODENSWMB.UI.DecorationKindCartouche"}}
        </button>
    </div>
</div>
