{{!--
    The inspector's label style (see StyleEditors): its name, then its look: the font (grouped,
    each in its own face), bold and italic, size, colour, justification and line width. Every
    field applies when committed, to the style and every label that follows it, one undo step each.
--}}
<datalist id="fwmb-inspector-colors">
    {{#each palette}}
    <option value="{{this}}"></option>
    {{/each}}
</datalist>
<div class="fwmb-group">
    <div class="fwmb-form-group">
        <label class="fwmb-label" for="fwmb-inspector-name">{{localize "FILRODENSWMB.UI.Name"}}</label>
        <div class="fwmb-form-fields">
            <input type="text" id="fwmb-inspector-name" name="styleName" value="{{style.name}}" />
        </div>
    </div>
</div>

<div class="fwmb-group">
    <div class="fwmb-section-title">{{localize "FILRODENSWMB.UI.InspectorLabelLook"}}</div>
    <div class="fwmb-form-group">
        <label class="fwmb-label" for="fwmb-inspector-label-font">{{localize "FILRODENSWMB.UI.InspectorFont"}}</label>
        <div class="fwmb-form-fields">
            {{> "modules/filrodens-world-map-builder/templates/parts/font-picker.hbs" id="fwmb-inspector-label-font" name="styleFontFamily" groups=fontGroups selected=style.fontFamily missing=fontMissing}}
        </div>
    </div>
    {{> "modules/filrodens-world-map-builder/templates/parts/face-fields.hbs" bold=style.bold italic=style.italic face=face boldName="styleBold" italicName="styleItalic"}}
    {{> "modules/filrodens-world-map-builder/templates/parts/shared-range.hbs" name="styleFontSize" label="FILRODENSWMB.UI.InspectorFontSize" value=style.fontSize min=0.2 max=5 step=0.1}}
    <div class="fwmb-form-group">
        <label class="fwmb-label" for="fwmb-inspector-label-color">{{localize "FILRODENSWMB.UI.InspectorColor"}}</label>
        <div class="fwmb-form-fields">
            <input type="color" id="fwmb-inspector-label-color" class="fwmb-swatch" name="styleFillColor" value="{{style.fillColor}}" list="fwmb-inspector-colors" />
            <label class="fwmb-label fwmb-label--inline" for="fwmb-inspector-label-justify">{{localize "FILRODENSWMB.UI.InspectorJustify"}}</label>
            <select id="fwmb-inspector-label-justify" name="styleJustify">
                {{#each justifications}}
                <option value="{{this.value}}" {{#if this.selected}}selected{{/if}}>{{localize this.label}}</option>
                {{/each}}
            </select>
        </div>
    </div>
    <div class="fwmb-form-group">
        <label class="fwmb-label" for="fwmb-inspector-label-width">{{localize "FILRODENSWMB.UI.LabelLineWidth"}}</label>
        <div class="fwmb-form-fields">
            <input type="number" id="fwmb-inspector-label-width" class="fwmb-input-short" name="styleMaxChars" value="{{style.maxChars}}" min="0" step="1" aria-describedby="fwmb-inspector-label-width-unit" />
            <span class="fwmb-unit" id="fwmb-inspector-label-width-unit"><span class="fwmb-unit-long">{{localize "FILRODENSWMB.UI.UnitCharacters"}}</span><span class="fwmb-unit-short">{{localize "FILRODENSWMB.UI.UnitCharactersShort"}}</span></span>
            <i class="fwmb-icon fwmb-icon--info" data-tooltip="{{localize 'FILRODENSWMB.UI.LabelLineWidthHint'}}" aria-label="{{localize 'FILRODENSWMB.UI.LabelLineWidthHint'}}"></i>
        </div>
    </div>
</div>
<p class="fwmb-hint fwmb-inspector-hint">{{localize "FILRODENSWMB.UI.InspectorStyleApplyHint"}}</p>
