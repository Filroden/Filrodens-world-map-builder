{{!-- Rivers and faults' bar: placing river sources, drawing rivers or faults, the settings of the
     line being drawn, and pausing the regeneration that follows each change. --}}
{{#each bar.modeGroups}}{{> "modules/filrodens-world-map-builder/templates/parts/bar-modes.hbs" group=this}}{{/each}}

{{#if (eq uiState.activeFeatureMode 'fault')}}
    <span class="fwmb-sep"></span>
    <label class="fwmb-bar-field">
        <span class="fwmb-label">{{localize "FILRODENSWMB.UI.FaultType"}}</span>
        <select name="faultType">
            {{#each tectonicTypes}}
                <option value="{{this.id}}" {{#if (eq ../uiState.faultType this.id)}}selected{{/if}}>{{localize this.label}}</option>
            {{/each}}
        </select>
    </label>
    {{#if faultIsRange}}
        <label class="fwmb-bar-field" data-tooltip="{{localize 'FILRODENSWMB.UI.FaultStyleHint'}}">
            <span class="fwmb-label">{{localize "FILRODENSWMB.UI.FaultStyle"}}</span>
            <select name="faultStyle">
                {{#each rangeStyles}}
                    <option value="{{this.id}}" {{#if (eq ../uiState.faultStyle this.id)}}selected{{/if}}>{{localize this.label}}</option>
                {{/each}}
            </select>
        </label>
    {{/if}}
    {{> "modules/filrodens-world-map-builder/templates/parts/bar-range.hbs" name="faultThickness" label="FILRODENSWMB.UI.FaultThickness" icon="timeline" value=(lookup uiState 'faultThickness') min=10 max=400 step=5 unit="FILRODENSWMB.UI.UnitPixelsShort"}}
    {{> "modules/filrodens-world-map-builder/templates/parts/bar-range.hbs" name="faultStrength" label="FILRODENSWMB.UI.FaultStrength" icon="landscape" value=(lookup uiState 'faultStrength') min=0.1 max=1.0 step=0.05}}
{{/if}}

{{#if (eq uiState.activeFeatureMode 'river')}}
    <span class="fwmb-sep"></span>
    <label class="fwmb-bar-field">
        <span class="fwmb-label">{{localize "FILRODENSWMB.UI.RiverWidth"}}</span>
        <select name="riverWidth">
            <option value="2" {{#if (eq uiState.riverWidth 2)}}selected{{/if}}>{{localize "FILRODENSWMB.UI.SizeSmall"}}</option>
            <option value="4" {{#if (eq uiState.riverWidth 4)}}selected{{/if}}>{{localize "FILRODENSWMB.UI.SizeMedium"}}</option>
            <option value="6" {{#if (eq uiState.riverWidth 6)}}selected{{/if}}>{{localize "FILRODENSWMB.UI.SizeLarge"}}</option>
            <option value="8" {{#if (eq uiState.riverWidth 8)}}selected{{/if}}>{{localize "FILRODENSWMB.UI.SizeXLarge"}}</option>
        </select>
    </label>
{{/if}}

<span class="fwmb-sep"></span>
{{> "modules/filrodens-world-map-builder/templates/parts/bar-pause.hbs"}}
