{{!--
    The inspector's decoration (see DecorationEditor): its name and visibility, its opacity, scale
    and rotation, and Focus view and Delete. Every field applies when committed, one undo step
    each (see Inspector).
--}}
<div class="fwmb-group">
    <div class="fwmb-form-group">
        <label class="fwmb-label" for="fwmb-inspector-name">{{localize "FILRODENSWMB.UI.Name"}}</label>
        <div class="fwmb-form-fields">
            <input type="text" id="fwmb-inspector-name" name="decorationName" value="{{decoration.name}}" />
        </div>
    </div>
    <div class="fwmb-form-group">
        <label class="fwmb-label" for="fwmb-inspector-visibility">{{localize "FILRODENSWMB.UI.Visibility"}}</label>
        <div class="fwmb-form-fields">
            <select id="fwmb-inspector-visibility" name="decorationVisibility">
                {{#each visibilities}}
                <option value="{{this.value}}" {{#if this.selected}}selected{{/if}}>{{localize this.label}}</option>
                {{/each}}
            </select>
        </div>
    </div>
</div>

<div class="fwmb-group">
    {{> "modules/filrodens-world-map-builder/templates/parts/shared-range.hbs" name="decorationOpacity" label="FILRODENSWMB.UI.Opacity" value=decoration.opacity min=0.1 max=1 step=0.1}}
    {{> "modules/filrodens-world-map-builder/templates/parts/shared-range.hbs" name="decorationScale" label="FILRODENSWMB.UI.Scale" value=decoration.scale min=scaleRange.MIN max=scaleRange.MAX step=scaleRange.STEP}}
    {{> "modules/filrodens-world-map-builder/templates/parts/shared-range.hbs" name="decorationRotation" label="FILRODENSWMB.UI.Rotation" value=decoration.rotation min=rotationRange.MIN max=rotationRange.MAX step=rotationRange.STEP unit="FILRODENSWMB.UI.UnitDegrees" unitShort="FILRODENSWMB.UI.UnitDegreesShort"}}
</div>

<div class="fwmb-inspector-actions">
    <button type="button" class="fwmb-btn fwmb-btn--subtle" data-inspector-action="zoom"><i class="fwmb-icon fwmb-icon--center-focus" aria-hidden="true"></i>{{localize "FILRODENSWMB.UI.ZoomTo"}}</button>
    <button type="button" class="fwmb-btn fwmb-btn--danger-quiet fwmb-inspector-delete" data-inspector-action="delete"><i class="fwmb-icon fwmb-icon--delete" aria-hidden="true"></i>{{localize "FILRODENSWMB.UI.Delete"}}</button>
</div>
<p class="fwmb-hint fwmb-inspector-hint">{{localize "FILRODENSWMB.UI.InspectorApplyHint"}}</p>
