{{!--
    The inspector's age (see AgeEditor): in folding sections, its era, its strife and its events
    (see AgeEventRows), each with what the chosen one does. Every field applies when committed,
    one undo step each (see Inspector).
--}}
{{#> "modules/filrodens-world-map-builder/templates/parts/section.hbs" id="ageEra" title="FILRODENSWMB.UI.GenerateEra"}}
    <p class="fwmb-hint">{{localize "FILRODENSWMB.UI.AgeEraIntro"}}</p>
    <div class="fwmb-form-group">
        <label class="fwmb-label" for="fwmb-inspector-age-era">{{localize "FILRODENSWMB.UI.GenerateEra"}}</label>
        <div class="fwmb-form-fields">
            <select id="fwmb-inspector-age-era" name="ageEra">
                {{#each eras}}<option value="{{this.value}}" {{#if this.selected}}selected{{/if}}>{{localize this.label}}</option>{{/each}}
            </select>
        </div>
    </div>
    <p class="fwmb-age-choice-note">{{localize eraHint}}</p>
{{/"modules/filrodens-world-map-builder/templates/parts/section.hbs"}}

{{#> "modules/filrodens-world-map-builder/templates/parts/section.hbs" id="ageStrife" title="FILRODENSWMB.UI.GenerateStrife"}}
    <p class="fwmb-hint">{{localize "FILRODENSWMB.UI.GenerateStrifeHint"}}</p>
    <div class="fwmb-form-group">
        <label class="fwmb-label" for="fwmb-inspector-age-strife">{{localize "FILRODENSWMB.UI.GenerateStrife"}}</label>
        <div class="fwmb-form-fields">
            <select id="fwmb-inspector-age-strife" name="ageStrife">
                {{#each strifes}}<option value="{{this.value}}" {{#if this.selected}}selected{{/if}}>{{localize this.label}}</option>{{/each}}
            </select>
        </div>
    </div>
    <p class="fwmb-age-choice-note">{{localize strifeHint}}</p>
{{/"modules/filrodens-world-map-builder/templates/parts/section.hbs"}}

{{#> "modules/filrodens-world-map-builder/templates/parts/section.hbs" id="ageEvents" title="FILRODENSWMB.UI.GenerateEvents" count=eventCount}}
    <p class="fwmb-hint">{{localize "FILRODENSWMB.UI.GenerateEventsHint"}}</p>
    {{#if noRun}}<p class="fwmb-hint">{{localize "FILRODENSWMB.UI.GenerateEventsNoRun"}}</p>{{/if}}
    {{#each events.rows}}
    <details class="fwmb-fieldset fwmb-age-event" data-section="{{this.section}}" {{#if (lookup @root.collapsedSections this.section)}}{{else}}open{{/if}}>
        <summary class="fwmb-age-event-heading">
            <span class="fwmb-age-event-titles fwmb-flex-1">
                <span class="fwmb-age-event-title">{{this.title}}</span>
                <span class="fwmb-age-event-summary">{{this.summary}}</span>
            </span>
            <button type="button" class="fwmb-btn fwmb-btn--square fwmb-btn--danger-quiet" data-inspector-action="removeEvent" data-index="{{this.index}}" aria-label="{{localize 'FILRODENSWMB.UI.GenerateEventRemove'}}" data-tooltip="{{localize 'FILRODENSWMB.UI.GenerateEventRemove'}}"><i class="fwmb-icon fwmb-icon--delete"></i></button>
        </summary>
        <div class="fwmb-form-group">
            <label class="fwmb-label" for="fwmb-inspector-age-event-{{this.index}}">{{localize "FILRODENSWMB.UI.GenerateEventKind"}}</label>
            <div class="fwmb-form-fields">
                <select id="fwmb-inspector-age-event-{{this.index}}" name="event.{{this.index}}.kind">
                    {{#each this.groups}}
                    <optgroup label="{{localize this.label}}">
                        {{#each this.kinds}}<option value="{{this.value}}" {{#if this.selected}}selected{{/if}} {{#if this.disabled}}disabled{{/if}}>{{localize this.label}}</option>{{/each}}
                    </optgroup>
                    {{/each}}
                </select>
            </div>
        </div>
        <p class="fwmb-age-choice-note">{{localize this.hint}}</p>
        {{#if this.cultures}}
        <div class="fwmb-form-group">
            <label class="fwmb-label" for="fwmb-inspector-age-event-{{this.index}}-culture">{{localize "FILRODENSWMB.UI.GenerateEventCulture"}}</label>
            <div class="fwmb-form-fields">
                <select id="fwmb-inspector-age-event-{{this.index}}-culture" name="event.{{this.index}}.culture">
                    {{#if this.cultureMissing}}<option value="" selected disabled>{{localize "FILRODENSWMB.UI.GenerateEventCultureMissing"}}</option>{{/if}}
                    {{#each this.cultures}}<option value="{{this.value}}" {{#if this.selected}}selected{{/if}} {{#if this.disabled}}disabled{{/if}}>{{this.label}}</option>{{/each}}
                </select>
            </div>
        </div>
        {{/if}}
        {{#if this.placed}}
        <div class="fwmb-form-group">
            <span class="fwmb-label">{{localize "FILRODENSWMB.UI.GenerateEventPlace"}}</span>
            <div class="fwmb-form-fields">
                <span class="fwmb-age-event-place fwmb-flex-1">{{this.placeLabel}}</span>
                {{#if this.hasPlace}}<button type="button" class="fwmb-btn fwmb-btn--subtle fwmb-btn--square" data-inspector-action="clearPlace" data-index="{{this.index}}" aria-label="{{localize 'FILRODENSWMB.UI.GenerateEventPlaceClear'}}" data-tooltip="{{localize 'FILRODENSWMB.UI.GenerateEventPlaceClear'}}"><i class="fwmb-icon fwmb-icon--cancel"></i></button>{{/if}}
            </div>
        </div>
        <div class="fwmb-btn-row">
            <button type="button" class="fwmb-btn" data-inspector-action="pickPlace" data-index="{{this.index}}" aria-pressed="{{#if this.picking}}true{{else}}false{{/if}}" data-tooltip="{{localize 'FILRODENSWMB.UI.GenerateEventPlaceHint'}}">
                <i class="fwmb-icon fwmb-icon--place" aria-hidden="true"></i>{{#if this.picking}}{{localize "FILRODENSWMB.UI.GenerateEventPlacePicking"}}{{else}}{{localize "FILRODENSWMB.UI.GenerateEventPlaceChoose"}}{{/if}}
            </button>
        </div>
        {{/if}}
    </details>
    {{/each}}
    {{#if events.canAdd}}
    <div class="fwmb-list-add">
        <button type="button" class="fwmb-btn fwmb-btn--subtle" data-inspector-action="addEvent"><i class="fwmb-icon fwmb-icon--add" aria-hidden="true"></i>{{localize "FILRODENSWMB.UI.GenerateEventAdd"}}</button>
    </div>
    {{/if}}
{{/"modules/filrodens-world-map-builder/templates/parts/section.hbs"}}
