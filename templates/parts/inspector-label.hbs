{{!--
    The label fields of a pin, route or region in the inspector, as a collapsible section: the
    label style (with Save as…), then the face, size, rotation, colour, line width and
    justification. Read back by InspectorFields.readLabel.

    Parameters:
      label: the label's fields (InspectorFields.label: its own over the defaults)
      choices: InspectorFields.labelChoices: fonts, labelStyles, rotationRange, justifications
      styleName: the label style it follows, or null for Custom
--}}
{{#> "modules/filrodens-world-map-builder/templates/parts/section.hbs" id="inspectorLabel" title="FILRODENSWMB.UI.InspectorLabel" styleBadge=styleName closed=true}}
{{> "modules/filrodens-world-map-builder/templates/parts/style-picker.hbs" name="labelQuickStyle" choices=choices.labelStyles type="Label"}}
<div class="fwmb-form-group">
    <label class="fwmb-label" for="fwmb-inspector-label-font">{{localize "FILRODENSWMB.UI.InspectorFont"}}</label>
    <div class="fwmb-form-fields">
        <select id="fwmb-inspector-label-font" name="labelFontFamily">
            {{#each choices.fonts}}
            <option value="{{this}}" {{#if (eq ../label.fontFamily this)}}selected{{/if}}>{{this}}</option>
            {{/each}}
        </select>
    </div>
</div>
{{> "modules/filrodens-world-map-builder/templates/parts/shared-range.hbs" name="labelFontSize" label="FILRODENSWMB.UI.InspectorFontSize" value=label.fontSize min=0.2 max=5 step=0.1}}
{{> "modules/filrodens-world-map-builder/templates/parts/shared-range.hbs" name="labelRotation" label="FILRODENSWMB.UI.InspectorRotation" value=label.rotation min=choices.rotationRange.MIN max=choices.rotationRange.MAX step=choices.rotationRange.STEP}}
<div class="fwmb-form-group">
    <label class="fwmb-label" for="fwmb-inspector-label-color">{{localize "FILRODENSWMB.UI.InspectorColor"}}</label>
    <div class="fwmb-form-fields">
        <input type="color" id="fwmb-inspector-label-color" class="fwmb-swatch" name="labelFillColor" value="{{label.fillColor}}" list="fwmb-inspector-colors" />
        <label class="fwmb-label fwmb-label--inline" for="fwmb-inspector-label-justify">{{localize "FILRODENSWMB.UI.InspectorJustify"}}</label>
        <select id="fwmb-inspector-label-justify" name="labelJustify">
            {{#each choices.justifications}}
            <option value="{{this.value}}" {{#if this.selected}}selected{{/if}}>{{localize this.label}}</option>
            {{/each}}
        </select>
    </div>
</div>
<div class="fwmb-form-group">
    <label class="fwmb-label" for="fwmb-inspector-label-width">{{localize "FILRODENSWMB.UI.InspectorLineWidth"}}</label>
    <div class="fwmb-form-fields">
        <input type="number" id="fwmb-inspector-label-width" class="fwmb-input-short" name="labelMaxChars" value="{{label.maxChars}}" min="0" step="1" />
        <i class="fwmb-icon fwmb-icon--info" data-tooltip="{{localize 'FILRODENSWMB.UI.MaxWidthHint'}}" aria-label="{{localize 'FILRODENSWMB.UI.MaxWidthHint'}}"></i>
    </div>
</div>
{{/"modules/filrodens-world-map-builder/templates/parts/section.hbs"}}
