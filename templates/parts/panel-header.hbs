{{!-- The panel's header: the tool's name, and where it sits in the order of work (its stage and
     step, and the map's engine for the tools the engine shapes). See MapStudio's #panelContext. --}}
<div class="fwmb-panel-header">
    <h2 class="fwmb-panel-title">{{panel.title}}</h2>
    {{#if panel.meta}}<span class="fwmb-meta">{{panel.meta}}</span>{{/if}}
</div>
