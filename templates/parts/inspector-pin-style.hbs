{{!--
    The inspector's pin style (see StyleEditors): its name; its look (the icon, from the same grid
    as a pin's, its colour and scale) and detail level; and its label's size, visibility and label
    style. Every field applies when committed, to the style and every pin that follows it, one undo
    step each.
--}}
<datalist id="fwmb-inspector-colors">
    {{#each palette}}
    <option value="{{this}}"></option>
    {{/each}}
</datalist>
<div class="fwmb-group">
    <div class="fwmb-form-group">
        <label class="fwmb-label" for="fwmb-inspector-name">{{localize "FILRODENSWMB.UI.Name"}}</label>
        <div class="fwmb-form-fields">
            <input type="text" id="fwmb-inspector-name" name="styleName" value="{{style.name}}" />
        </div>
    </div>
</div>

<div class="fwmb-group">
    <div class="fwmb-section-title">{{localize "FILRODENSWMB.UI.InspectorPinLook"}}</div>
    <div class="fwmb-form-group">
        <span class="fwmb-label">{{localize "FILRODENSWMB.UI.InspectorIcon"}}</span>
        <div class="fwmb-form-fields">
            <details class="fwmb-icon-picker">
                <summary class="fwmb-btn" aria-label="{{localize 'FILRODENSWMB.UI.InspectorChooseIcon'}}" data-tooltip="{{icon.label}}">
                    <i class="fwmb-icon {{#unless icon.isCustom}}fwmb-icon--{{icon.key}}{{/unless}}" {{#if icon.isCustom}}style="--fwmb-mask: url('{{icon.path}}');"{{/if}} aria-hidden="true"></i>
                    <span>{{icon.label}}</span>
                    <i class="fwmb-icon fwmb-icon--arrow-drop-down" aria-hidden="true"></i>
                </summary>
                <div class="fwmb-icon-grid fwmb-scrollable" role="listbox" aria-label="{{localize 'FILRODENSWMB.UI.InspectorIcon'}}">
                    {{#each icons}}
                    <button type="button" class="fwmb-btn fwmb-btn--square" role="option" aria-selected="{{#if this.selected}}true{{else}}false{{/if}}" data-inspector-action="pickIcon" data-icon="{{this.key}}" aria-label="{{this.label}}" data-tooltip="{{this.label}}">
                        <i class="fwmb-icon {{#unless this.isCustom}}fwmb-icon--{{this.key}}{{/unless}}" {{#if this.isCustom}}style="--fwmb-mask: url('{{this.path}}');"{{/if}} aria-hidden="true"></i>
                    </button>
                    {{/each}}
                </div>
            </details>
        </div>
    </div>
    <div class="fwmb-form-group">
        <label class="fwmb-label" for="fwmb-inspector-pin-color">{{localize "FILRODENSWMB.UI.InspectorColor"}}</label>
        <div class="fwmb-form-fields">
            <input type="color" id="fwmb-inspector-pin-color" class="fwmb-swatch" name="styleColor" value="{{style.color}}" list="fwmb-inspector-colors" />
        </div>
    </div>
    {{> "modules/filrodens-world-map-builder/templates/parts/shared-range.hbs" name="styleScale" label="FILRODENSWMB.UI.InspectorScale" value=style.scale min=0.2 max=4 step=0.1}}
    <div class="fwmb-form-group">
        <label class="fwmb-label" for="fwmb-inspector-detail-level">{{localize "FILRODENSWMB.UI.PinDetailLevel"}}</label>
        <div class="fwmb-form-fields">
            <select id="fwmb-inspector-detail-level" name="styleDetailLevel">
                {{#each detailLevels}}
                <option value="{{this.value}}" {{#if this.selected}}selected{{/if}}>{{localize this.label}}</option>
                {{/each}}
            </select>
            <i class="fwmb-icon fwmb-icon--info" data-tooltip="{{localize 'FILRODENSWMB.UI.PinDetailLevelHint'}}" aria-label="{{localize 'FILRODENSWMB.UI.PinDetailLevelHint'}}"></i>
        </div>
    </div>
</div>

<div class="fwmb-group">
    <div class="fwmb-section-title">{{localize "FILRODENSWMB.UI.InspectorLabel"}}</div>
    {{> "modules/filrodens-world-map-builder/templates/parts/shared-range.hbs" name="styleLabelSize" label="FILRODENSWMB.UI.InspectorFontSize" value=style.label.fontSize min=0.2 max=5 step=0.1}}
    <div class="fwmb-form-group">
        <label class="fwmb-label" for="fwmb-inspector-label-visibility">{{localize "FILRODENSWMB.UI.Visibility"}}</label>
        <div class="fwmb-form-fields">
            <select id="fwmb-inspector-label-visibility" name="styleLabelVisibility">
                {{#each labelVisibilities}}
                <option value="{{this.value}}" {{#if this.selected}}selected{{/if}}>{{localize this.label}}</option>
                {{/each}}
            </select>
        </div>
    </div>
    <div class="fwmb-form-group">
        <label class="fwmb-label" for="fwmb-inspector-label-style">{{localize "FILRODENSWMB.UI.InspectorLabelStyle"}}</label>
        <div class="fwmb-form-fields">
            <select id="fwmb-inspector-label-style" name="styleLabelQuickStyle">
                {{#each labelStyles}}
                <option value="{{this.value}}" {{#if this.selected}}selected{{/if}}>{{#if this.name}}{{this.name}}{{else}}{{localize "FILRODENSWMB.UI.Custom"}}{{/if}}</option>
                {{/each}}
            </select>
            <i class="fwmb-icon fwmb-icon--info" data-tooltip="{{localize 'FILRODENSWMB.UI.PinStyleLabelHint'}}" aria-label="{{localize 'FILRODENSWMB.UI.PinStyleLabelHint'}}"></i>
        </div>
    </div>
</div>
<p class="fwmb-hint fwmb-inspector-hint">{{localize "FILRODENSWMB.UI.InspectorStyleApplyHint"}}</p>
