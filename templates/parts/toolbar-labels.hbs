{{!-- Labels' bar: Select (which only picks labels, opening them in the inspector) and Place, and
     the style the next label placed gets. A label's text and look are its inspector's. --}}
{{#each bar.modeGroups}}{{> "modules/filrodens-world-map-builder/templates/parts/bar-modes.hbs" group=this}}{{/each}}
<span class="fwmb-sep"></span>
<label class="fwmb-bar-field" data-tooltip="{{localize 'FILRODENSWMB.UI.NextLabelStyleHint'}}">
    <span class="fwmb-label">{{localize "FILRODENSWMB.UI.InspectorStyle"}}</span>
    <select name="activeLabelQuickStyle">
        <option value="custom" {{#if (eq uiState.activeLabelQuickStyle "custom")}}selected{{/if}}>{{localize "FILRODENSWMB.UI.StyleNone"}}</option>
        {{#each customLabelStyles}}
            <option value="{{this.id}}" {{#if (eq ../uiState.activeLabelQuickStyle this.id)}}selected{{/if}}>{{this.name}}</option>
        {{/each}}
    </select>
</label>
