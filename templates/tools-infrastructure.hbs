{{!--
    Routes and pins (tool id "infrastructure"): the map's pins and routes, each list searched
    and filtered, its rows rendered only when they change (see ListQuery). Placing pins and drawing routes are the
    bar's modes; Mass Edit (with Delete) is toggled from each list's title.
--}}
{{#> "modules/filrodens-world-map-builder/templates/parts/section.hbs" id="pins" title="FILRODENSWMB.UI.SectionPins" count=pinList.total massType="pin"}}
    {{> "modules/filrodens-world-map-builder/templates/parts/list-query.hbs" query=pinList.controls kindLabel="FILRODENSWMB.UI.ListKindPin"}}
    {{#if massEditMode.pin}}
    <div class="fwmb-mass-edit-bar fwmb-mass-edit-bar--list">
        <button type="button" class="fwmb-btn fwmb-btn--subtle" data-action="massEditSelectAll" data-type="pin">{{localize "FILRODENSWMB.UI.MassEditSelectAll"}}</button>
        <button type="button" class="fwmb-btn fwmb-btn--subtle" data-action="massEditSelectNone" data-type="pin">{{localize "FILRODENSWMB.UI.MassEditSelectNone"}}</button>
        <button type="button" class="fwmb-btn fwmb-btn--danger-quiet" data-action="massDelete" data-type="pin" {{#unless massEditCount.pin}}disabled{{/unless}} data-tooltip="{{localize 'FILRODENSWMB.UI.MassDeleteHint'}}">
            {{localize "FILRODENSWMB.UI.MassDelete" count=massEditCount.pin}}
        </button>
        <button type="button" class="fwmb-btn fwmb-btn--primary" data-action="openMassEdit" data-type="pin" {{#unless massEditCount.pin}}disabled{{/unless}}>
            {{localize "FILRODENSWMB.UI.MassEdit"}} ({{massEditCount.pin}})
        </button>
    </div>
    {{/if}}

    <div role="listbox" aria-label="{{localize 'FILRODENSWMB.UI.SectionPins'}}" data-list-nav id="fwmb-scroll-pins" data-list-version="{{pinList.version}}" data-list-rows="pin" data-list-selected="{{pinList.selected}}" class="fwmb-list-container fwmb-scrollable fwmb-scrollable--stable"></div>
{{/"modules/filrodens-world-map-builder/templates/parts/section.hbs"}}

{{#> "modules/filrodens-world-map-builder/templates/parts/section.hbs" id="routes" title="FILRODENSWMB.UI.Routes" count=routeList.total massType="route"}}
    {{> "modules/filrodens-world-map-builder/templates/parts/list-query.hbs" query=routeList.controls kindLabel="FILRODENSWMB.UI.ListKindRoute"}}
    {{#if massEditMode.route}}
    <div class="fwmb-mass-edit-bar fwmb-mass-edit-bar--list">
        <button type="button" class="fwmb-btn fwmb-btn--subtle" data-action="massEditSelectAll" data-type="route">{{localize "FILRODENSWMB.UI.MassEditSelectAll"}}</button>
        <button type="button" class="fwmb-btn fwmb-btn--subtle" data-action="massEditSelectNone" data-type="route">{{localize "FILRODENSWMB.UI.MassEditSelectNone"}}</button>
        <button type="button" class="fwmb-btn fwmb-btn--danger-quiet" data-action="massDelete" data-type="route" {{#unless massEditCount.route}}disabled{{/unless}} data-tooltip="{{localize 'FILRODENSWMB.UI.MassDeleteHint'}}">
            {{localize "FILRODENSWMB.UI.MassDelete" count=massEditCount.route}}
        </button>
        <button type="button" class="fwmb-btn fwmb-btn--primary" data-action="openMassEdit" data-type="route" {{#unless massEditCount.route}}disabled{{/unless}}>
            {{localize "FILRODENSWMB.UI.MassEdit"}} ({{massEditCount.route}})
        </button>
    </div>
    {{/if}}

    <div role="listbox" aria-label="{{localize 'FILRODENSWMB.UI.Routes'}}" data-list-nav id="fwmb-scroll-routes" data-list-version="{{routeList.version}}" data-list-rows="route" data-list-selected="{{routeList.selected}}" class="fwmb-list-container fwmb-scrollable fwmb-scrollable--stable"></div>
{{/"modules/filrodens-world-map-builder/templates/parts/section.hbs"}}
