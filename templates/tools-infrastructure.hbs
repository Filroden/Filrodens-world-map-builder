<div class="fwmb-tool-content fwmb-fixed-lists">

    <details class="fwmb-fieldset fwmb-list-section" data-section="pins" {{#unless collapsedSections.pins}}open{{/unless}}>
        <summary class="fwmb-legend-with-action">
            <span>{{localize "FILRODENSWMB.UI.PointsOfInterest"}}</span>
            <a class="fwmb-legend-action" aria-pressed="{{#if massEditMode.pin}}true{{else}}false{{/if}}" aria-disabled="{{#if massEditBlocked.pin}}true{{else}}false{{/if}}" data-action="toggleMassEditMode" data-type="pin" data-tooltip="{{localize 'FILRODENSWMB.UI.MassEditSelect'}}" data-tooltip-class="fwmb-tooltip">
                <i class="fwmb-icon fwmb-icon--edit-square"></i>
            </a>
        </summary>

        {{#if massEditMode.pin}}
        <div class="fwmb-mass-edit-bar">
            <a class="fwmb-bulk-action-button" data-action="massEditSelectAll" data-type="pin">{{localize "FILRODENSWMB.UI.MassEditSelectAll"}}</a>
            <a class="fwmb-bulk-action-button" data-action="massEditSelectNone" data-type="pin">{{localize "FILRODENSWMB.UI.MassEditSelectNone"}}</a>
            <span class="fwmb-flex-1"></span>
            <button type="button" class="fwmb-btn fwmb-btn--primary" data-action="openMassEdit" data-type="pin" {{#unless massEditCount.pin}}disabled{{/unless}}>
                {{localize "FILRODENSWMB.UI.MassEdit"}} ({{massEditCount.pin}})
            </button>
        </div>
        {{/if}}

        <div id="fwmb-scroll-pins" class="fwmb-list-container fwmb-scrollable fwmb-scrollable--stable">
            {{#each mapPins}}
            <div class="fwmb-list-item" data-id="{{this.id}}" data-type="pin">
                {{#if ../massEditMode.pin}}
                    <input type="checkbox" class="fwmb-checkbox" data-action="toggleMassEditItem" data-mass-type="pin" {{#if this.massEditSelected}}checked{{/if}} />
                {{/if}}
                <button type="button" class="fwmb-btn fwmb-btn--subtle fwmb-btn--square" data-action="toggleVisibility" data-target="feature">
                    <i class="fwmb-icon {{#if (eq this.visibility 'none')}}fwmb-icon--visibility-off{{else if (eq this.visibility 'gm')}}fwmb-icon--security{{else}}fwmb-icon--visibility{{/if}}"></i>
                </button>
                
                <i class="fwmb-icon fwmb-list-icon fwmb-icon--{{this.icon}}"></i>
                <div class="fwmb-pin" style="background-color: {{this.color}};"></div>

                <span class="fwmb-name fwmb-flex-1">{{this.name}}</span>
                <button type="button" class="fwmb-btn fwmb-btn--subtle fwmb-btn--square" data-action="zoomToFeature" data-tooltip="{{localize 'FILRODENSWMB.UI.ZoomTo'}}">
                    <i class="fwmb-icon fwmb-icon--center-focus"></i>
                </button>
                <button type="button" class="fwmb-btn fwmb-btn--subtle fwmb-btn--square" data-action="editPin" data-tooltip="{{localize 'FILRODENSWMB.UI.Edit'}}">
                    <i class="fwmb-icon fwmb-icon--edit"></i>
                </button>
                <button type="button" class="fwmb-btn fwmb-btn--square fwmb-btn--danger-quiet" data-action="deletePin" data-tooltip="{{localize 'FILRODENSWMB.UI.Delete'}}">
                    <i class="fwmb-icon fwmb-icon--delete"></i>
                </button>
            </div>
            {{else}}
            <div class="fwmb-empty-state">{{localize "FILRODENSWMB.UI.NoPoints"}}</div>
            {{/each}}
        </div>
    </details>

    <details class="fwmb-fieldset fwmb-list-section" data-section="routes" {{#unless collapsedSections.routes}}open{{/unless}}>
        <summary class="fwmb-legend-with-action">
            <span>{{localize "FILRODENSWMB.UI.Routes"}}</span>
            <a class="fwmb-legend-action" aria-pressed="{{#if massEditMode.route}}true{{else}}false{{/if}}" aria-disabled="{{#if massEditBlocked.route}}true{{else}}false{{/if}}" data-action="toggleMassEditMode" data-type="route" data-tooltip="{{localize 'FILRODENSWMB.UI.MassEditSelect'}}" data-tooltip-class="fwmb-tooltip">
                <i class="fwmb-icon fwmb-icon--edit-square"></i>
            </a>
        </summary>

        {{#if massEditMode.route}}
        <div class="fwmb-mass-edit-bar">
            <a class="fwmb-bulk-action-button" data-action="massEditSelectAll" data-type="route">{{localize "FILRODENSWMB.UI.MassEditSelectAll"}}</a>
            <a class="fwmb-bulk-action-button" data-action="massEditSelectNone" data-type="route">{{localize "FILRODENSWMB.UI.MassEditSelectNone"}}</a>
            <span class="fwmb-flex-1"></span>
            <button type="button" class="fwmb-btn fwmb-btn--primary" data-action="openMassEdit" data-type="route" {{#unless massEditCount.route}}disabled{{/unless}}>
                {{localize "FILRODENSWMB.UI.MassEdit"}} ({{massEditCount.route}})
            </button>
        </div>
        {{/if}}

        <div id="fwmb-scroll-routes" class="fwmb-list-container fwmb-scrollable fwmb-scrollable--stable">
            {{#each mapRoutes}}
            <div class="fwmb-list-item" data-id="{{this.id}}" data-type="route">
                {{#if ../massEditMode.route}}
                    <input type="checkbox" class="fwmb-checkbox" data-action="toggleMassEditItem" data-mass-type="route" {{#if this.massEditSelected}}checked{{/if}} />
                {{/if}}
                <button type="button" class="fwmb-btn fwmb-btn--subtle fwmb-btn--square" data-action="toggleVisibility" data-target="feature">
                    <i class="fwmb-icon {{#if (eq this.visibility 'none')}}fwmb-icon--visibility-off{{else if (eq this.visibility 'gm')}}fwmb-icon--security{{else}}fwmb-icon--visibility{{/if}}"></i>
                </button>
                <div class="fwmb-route-swatch" style="background-color: {{this.color}}; height: calc({{this.thickness}} * 0.0625rem); border-style: {{this.style}};"></div>
                <span class="fwmb-name fwmb-flex-1">{{this.name}}</span>
                <button type="button" class="fwmb-btn fwmb-btn--subtle fwmb-btn--square" data-action="zoomToFeature" data-tooltip="{{localize 'FILRODENSWMB.UI.ZoomTo'}}">
                    <i class="fwmb-icon fwmb-icon--center-focus"></i>
                </button>
                <button type="button" class="fwmb-btn fwmb-btn--subtle fwmb-btn--square" data-action="editRoute" data-tooltip="{{localize 'FILRODENSWMB.UI.Edit'}}">
                    <i class="fwmb-icon fwmb-icon--edit"></i>
                </button>
                <button type="button" class="fwmb-btn fwmb-btn--square fwmb-btn--danger-quiet" data-action="deleteRoute" data-tooltip="{{localize 'FILRODENSWMB.UI.Delete'}}">
                    <i class="fwmb-icon fwmb-icon--delete"></i>
                </button>
            </div>
            {{else}}
            <div class="fwmb-empty-state">{{localize "FILRODENSWMB.UI.NoRoutes"}}</div>
            {{/each}}
        </div>
    </details>

    <div class="fwmb-divider"></div>

    <button type="button" class="fwmb-btn fwmb-btn--primary" data-action="toggleEditMode">
        <i class="fwmb-icon fwmb-icon--brush"></i>
        {{localize "FILRODENSWMB.UI.EditInfrastructure"}}
    </button>

</div>