<div class="fwmb-tool-content fwmb-fixed-lists">

    <details class="fwmb-fieldset fwmb-list-section" data-section="rivers" {{#unless collapsedSections.rivers}}open{{/unless}}>
        <summary>{{localize "FILRODENSWMB.UI.ManualRivers"}}</summary>

        <div id="fwmb-scroll-rivers" class="fwmb-list-container fwmb-scrollable stable">
            {{#each manualRivers}}
                <div class="fwmb-list-item" data-id="{{this.id}}" data-type="river">
                    <div class="fwmb-route-swatch" style="background-color: #78aad2; height: 3px; border-style: solid;"></div>
                    <span class="fwmb-name fwmb-flex-1">{{this.name}}</span>
                    <button type="button" class="fwmb-btn small" data-action="zoomToFeature" data-tooltip="{{localize 'FILRODENSWMB.UI.ZoomTo'}}">
                        <i class="fwmb-icon center-focus"></i>
                    </button>
                    <button type="button" class="fwmb-btn small" data-action="editRiver" data-tooltip="{{localize 'FILRODENSWMB.UI.Edit'}}">
                        <i class="fwmb-icon edit"></i>
                    </button>
                    <button type="button" class="fwmb-btn small muted danger" data-action="deleteRiver" data-tooltip="{{localize 'FILRODENSWMB.UI.Delete'}}">
                        <i class="fwmb-icon delete"></i>
                    </button>
                </div>
            {{else}}
                <div class="fwmb-empty-state">{{localize "FILRODENSWMB.UI.NoManualRivers"}}</div>
            {{/each}}
        </div>
    </details>

    <details class="fwmb-fieldset fwmb-list-section" data-section="faults" {{#unless collapsedSections.faults}}open{{/unless}}>
        <summary>{{localize "FILRODENSWMB.UI.TectonicFaults"}}</summary>

        <div id="fwmb-scroll-faults" class="fwmb-list-container fwmb-scrollable stable">
            {{#each tectonicFaults}}
                <div class="fwmb-list-item" data-id="{{this.id}}" data-type="fault">
                    <div class="fwmb-route-swatch" style="background-color: {{this.color}}; height: 5px; border-style: solid;"></div>

                    <span class="fwmb-name fwmb-flex-1">{{this.name}}</span>

                    <button type="button" class="fwmb-btn small" data-action="zoomToFeature" data-tooltip="{{localize 'FILRODENSWMB.UI.ZoomTo'}}">
                        <i class="fwmb-icon center-focus"></i>
                    </button>
                    <button type="button" class="fwmb-btn small" data-action="editFault" data-tooltip="{{localize 'FILRODENSWMB.UI.Edit'}}">
                        <i class="fwmb-icon edit"></i>
                    </button>
                    <button type="button" class="fwmb-btn small muted danger" data-action="deleteFault" data-tooltip="{{localize 'FILRODENSWMB.UI.Delete'}}">
                        <i class="fwmb-icon delete"></i>
                    </button>
                </div>
            {{else}}
                <div class="fwmb-empty-state">{{localize "FILRODENSWMB.UI.NoFaultLines"}}</div>
            {{/each}}
        </div>
    </details>

    <div class="fwmb-divider"></div>

    <button type="button" class="fwmb-btn primary" data-action="toggleEditMode">
        <i class="fwmb-icon brush"></i>
        {{localize "FILRODENSWMB.UI.EditFeatures"}}
    </button>

</div>