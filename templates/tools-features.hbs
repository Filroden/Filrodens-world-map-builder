{{!--
    Rivers and faults (tool id "features"): the rivers and fault lines drawn by hand, and the
    hydrology settings the generated rivers follow (which rebuild the rivers). Drawing and placing
    river sources are the bar's modes. Mass Edit (with Delete) of the custom rivers is toggled from
    their list's title, as the Routes and pins lists' are.
--}}
{{#> "modules/filrodens-world-map-builder/templates/parts/section.hbs" id="rivers" title="FILRODENSWMB.UI.ManualRivers" count=manualRivers.length massType="river"}}
    {{#if massEditMode.river}}
    <div class="fwmb-mass-edit-bar fwmb-mass-edit-bar--list">
        <button type="button" class="fwmb-btn fwmb-btn--subtle" data-action="massEditSelectAll" data-type="river">{{localize "FILRODENSWMB.UI.MassEditSelectAll"}}</button>
        <button type="button" class="fwmb-btn fwmb-btn--subtle" data-action="massEditSelectNone" data-type="river">{{localize "FILRODENSWMB.UI.MassEditSelectNone"}}</button>
        <button type="button" class="fwmb-btn fwmb-btn--danger-quiet" data-action="massDelete" data-type="river" {{#unless massEditCount.river}}disabled{{/unless}} data-tooltip="{{localize 'FILRODENSWMB.UI.MassDeleteHint'}}">
            {{localize "FILRODENSWMB.UI.MassDelete" count=massEditCount.river}}
        </button>
        <button type="button" class="fwmb-btn fwmb-btn--primary" data-action="openMassEdit" data-type="river" {{#unless massEditCount.river}}disabled{{/unless}}>
            {{localize "FILRODENSWMB.UI.MassEdit"}} ({{massEditCount.river}})
        </button>
    </div>
    {{/if}}
    <div role="listbox" aria-label="{{localize 'FILRODENSWMB.UI.ManualRivers'}}" data-list-nav id="fwmb-scroll-rivers" class="fwmb-list-container fwmb-scrollable fwmb-scrollable--stable">
        {{#each manualRivers}}
            <div role="option" tabindex="-1" data-list-item class="fwmb-list-item" aria-selected="{{#if (eq this.id @root.inspected.river)}}true{{else}}false{{/if}}" data-id="{{this.id}}" data-type="river" data-action="editRiver">
                {{#if @root.massEditMode.river}}
                <input type="checkbox" class="fwmb-checkbox" data-action="toggleMassEditItem" data-mass-type="river" data-panel-ui aria-label="{{localize 'FILRODENSWMB.UI.MassEditChoose' name=this.name}}" {{#if (lookup @root.riverSelection this.id)}}checked{{/if}} />
                {{/if}}
                <div class="fwmb-route-swatch fwmb-route-swatch--river"></div>
                <span class="fwmb-name fwmb-flex-1" title="{{this.name}}">{{this.name}}</span>
                <span class="fwmb-actions">
                    <button type="button" class="fwmb-btn fwmb-btn--subtle fwmb-btn--square" data-action="zoomToFeature" aria-label="{{localize 'FILRODENSWMB.UI.ZoomTo'}}" data-tooltip="{{localize 'FILRODENSWMB.UI.ZoomTo'}}">
                        <i class="fwmb-icon fwmb-icon--center-focus"></i>
                    </button>
                    <button type="button" class="fwmb-btn fwmb-btn--square fwmb-btn--danger-quiet" data-action="deleteRiver" aria-label="{{localize 'FILRODENSWMB.UI.Delete'}}" data-tooltip="{{localize 'FILRODENSWMB.UI.Delete'}}">
                        <i class="fwmb-icon fwmb-icon--delete"></i>
                    </button>
                </span>
            </div>
        {{else}}
            <div class="fwmb-list-empty" role="none">{{localize "FILRODENSWMB.UI.NoManualRivers"}}</div>
        {{/each}}
    </div>
{{/"modules/filrodens-world-map-builder/templates/parts/section.hbs"}}

{{#> "modules/filrodens-world-map-builder/templates/parts/section.hbs" id="faults" title="FILRODENSWMB.UI.TectonicFaults" count=tectonicFaults.length}}
    <div role="listbox" aria-label="{{localize 'FILRODENSWMB.UI.TectonicFaults'}}" data-list-nav id="fwmb-scroll-faults" class="fwmb-list-container fwmb-scrollable fwmb-scrollable--stable">
        {{#each tectonicFaults}}
            <div role="option" tabindex="-1" data-list-item class="fwmb-list-item" aria-selected="{{#if (eq this.id @root.inspected.fault)}}true{{else}}false{{/if}}" data-id="{{this.id}}" data-type="fault" data-action="editFault">
                <div class="fwmb-route-swatch fwmb-route-swatch--solid" style="background-color: {{this.color}};"></div>

                <span class="fwmb-name fwmb-flex-1" title="{{this.name}}">{{this.name}}</span>
                <span class="fwmb-actions">
                    <button type="button" class="fwmb-btn fwmb-btn--subtle fwmb-btn--square" data-action="zoomToFeature" aria-label="{{localize 'FILRODENSWMB.UI.ZoomTo'}}" data-tooltip="{{localize 'FILRODENSWMB.UI.ZoomTo'}}">
                        <i class="fwmb-icon fwmb-icon--center-focus"></i>
                    </button>
                    <button type="button" class="fwmb-btn fwmb-btn--square fwmb-btn--danger-quiet" data-action="deleteFault" aria-label="{{localize 'FILRODENSWMB.UI.Delete'}}" data-tooltip="{{localize 'FILRODENSWMB.UI.Delete'}}">
                        <i class="fwmb-icon fwmb-icon--delete"></i>
                    </button>
                </span>
            </div>
        {{else}}
            <div class="fwmb-list-empty" role="none">{{localize "FILRODENSWMB.UI.NoFaultLines"}}</div>
        {{/each}}
    </div>
{{/"modules/filrodens-world-map-builder/templates/parts/section.hbs"}}

{{#> "modules/filrodens-world-map-builder/templates/parts/section.hbs" id="hydrology" title="FILRODENSWMB.UI.SettingsHydrology" badge="FILRODENSWMB.UI.BadgeRebuildsRivers" closed=true}}
    {{> "modules/filrodens-world-map-builder/templates/parts/shared-range.hbs" name="springAltOffset" label="FILRODENSWMB.UI.SpringAltMin" value=(lookup uiState 'springAltOffset') min=0 max=0.8 step=0.05}}
    {{> "modules/filrodens-world-map-builder/templates/parts/shared-range.hbs" name="springMoistMin" label="FILRODENSWMB.UI.SpringMoistMin" value=(lookup uiState 'springMoistMin') min=0 max=1 step=0.05}}
    {{> "modules/filrodens-world-map-builder/templates/parts/shared-range.hbs" name="riverWidthScale" label="FILRODENSWMB.UI.RiverWidthScale" hint="FILRODENSWMB.UI.RiverWidthHint" value=(lookup uiState 'riverWidthScale') min=0.25 max=3 step=0.05}}
    {{> "modules/filrodens-world-map-builder/templates/parts/shared-range.hbs" name="riverMeander" label="FILRODENSWMB.UI.RiverMeander" hint="FILRODENSWMB.UI.RiverMeanderHint" value=(lookup uiState 'riverMeander') min=0 max=2 step=0.05}}
{{/"modules/filrodens-world-map-builder/templates/parts/section.hbs"}}
