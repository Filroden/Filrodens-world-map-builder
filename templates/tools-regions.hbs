<div class="fwmb-tool-content fwmb-fixed-lists">
    <div class="fwmb-panel-header-row">
        <label class="fwmb-title">{{localize "FILRODENSWMB.UI.LayerRegions"}}</label>
        <div class="fwmb-panel-header-actions">
            <a class="fwmb-legend-action {{#if massEditMode.region}}active{{/if}}" data-action="toggleMassEditMode" data-type="region" data-tooltip="{{localize 'FILRODENSWMB.UI.MassEditSelect'}}" data-tooltip-class="fwmb-tooltip">
                <i class="fwmb-icon edit-square"></i>
            </a>
            <button type="button" class="fwmb-btn" data-action="addRegionLayer">
                <i class="fwmb-icon add"></i> {{localize "FILRODENSWMB.UI.NewLayer"}}
            </button>
        </div>
    </div>

    {{#if massEditMode.region}}
    <div class="fwmb-mass-edit-bar">
        <a class="fwmb-bulk-action-button" class="fwmb-bulk-action-button" data-action="massEditSelectAll" data-type="region">{{localize "FILRODENSWMB.UI.MassEditSelectAll"}}</a>
        <a class="fwmb-bulk-action-button" class="fwmb-bulk-action-button" data-action="massEditSelectNone" data-type="region">{{localize "FILRODENSWMB.UI.MassEditSelectNone"}}</a>
        <span class="fwmb-flex-1"></span>
        <button type="button" class="fwmb-btn primary" data-action="openMassEdit" data-type="region" {{#unless massEditCount.region}}disabled{{/unless}}>
            {{localize "FILRODENSWMB.UI.MassEdit"}} ({{massEditCount.region}})
        </button>
    </div>
    {{/if}}

    {{#each regionLayers}}
    <div class="fwmb-accordion-group fwmb-scrollable" data-layer-id="{{this.id}}">
        
        <div class="fwmb-list-item fwmb-layer-header" style="{{#if this.isActive}}border-color: var(--fwmb-color-text-accent); background: var(--fwmb-bg-hover);{{/if}}">
            <div class="fwmb-list-item-content">
                <button type="button" class="fwmb-btn small" data-action="toggleVisibility" data-target="layer" title="{{localize 'FILRODENSWMB.UI.ToggleVisibility'}}">
                    <i class="fwmb-icon {{#if (eq this.visibility 'none')}}visibility-off{{else if (eq this.visibility 'gm')}}security{{else}}visibility{{/if}}"></i>
                </button>
                
                <span class="fwmb-name" data-action="selectRegionLayer" style="cursor: pointer; {{#if this.isActive}}color: var(--fwmb-color-text-accent); font-weight: bold;{{/if}}">
                    {{this.name}}
                </span>
            </div>
            <div class="fwmb-list-item-actions">
                <button type="button" class="fwmb-btn small" data-action="editRegionLayer" data-tooltip="{{localize 'FILRODENSWMB.UI.Edit'}}">
                    <i class="fwmb-icon edit"></i>
                </button>
                <button type="button" class="fwmb-btn small muted danger" data-action="deleteRegionLayer" data-tooltip="{{localize 'FILRODENSWMB.UI.Delete'}}">
                    <i class="fwmb-icon delete"></i>
                </button>
            </div>
        </div>

        <div class="fwmb-accordion-content">
            {{#if this.regions.length}}
                {{#each this.regions}}
                <div class="fwmb-list-item" data-id="{{this.id}}" data-layer-id="{{../id}}" data-type="region">
                    <div class="fwmb-list-item-content">
                        {{#if @root.massEditMode.region}}
                            <input type="checkbox" class="fwmb-checkbox" data-action="toggleMassEditItem" data-mass-type="region" {{#if this.massEditSelected}}checked{{/if}} />
                        {{/if}}
                        <button type="button" class="fwmb-btn small" data-action="toggleVisibility" data-target="feature">
                            <i class="fwmb-icon {{#if (eq this.visibility 'none')}}visibility-off{{else if (eq this.visibility 'gm')}}security{{else}}visibility{{/if}}"></i>
                        </button>
                        <div class="fwmb-swatch small" style="background-color: {{this.fillColor}}; border-color: {{this.lineColor}};"></div>
                        <span class="fwmb-name" title="{{this.name}}">{{this.name}}</span>
                    </div>
                    <div class="fwmb-list-item-actions">
                        <button type="button" class="fwmb-btn small" data-action="zoomToFeature" data-tooltip="{{localize 'FILRODENSWMB.UI.ZoomTo'}}">
                            <i class="fwmb-icon center-focus"></i>
                        </button>
                        <button type="button" class="fwmb-btn small" data-action="editRegion" data-tooltip="{{localize 'FILRODENSWMB.UI.Edit'}}">
                            <i class="fwmb-icon edit"></i>
                        </button>
                        <button type="button" class="fwmb-btn muted small danger" data-action="deleteRegion" data-tooltip="{{localize 'FILRODENSWMB.UI.Delete'}}">
                            <i class="fwmb-icon delete"></i>
                        </button>
                    </div>
                </div>
                {{/each}}
            {{else}}
                <div class="fwmb-hint small">
                    {{localize "FILRODENSWMB.UI.NoRegionsInLayer"}}
                </div>
            {{/if}}
        </div>
    </div>
    {{else}}
        <div class="fwmb-hint">{{localize "FILRODENSWMB.UI.NoRegionLayers"}}</div>
    {{/each}}

    <div class="fwmb-flex-1"></div>
    <div class="fwmb-divider"></div>

    <button type="button" class="fwmb-btn primary" data-action="toggleEditMode">
        <i class="fwmb-icon brush"></i>
        {{localize "FILRODENSWMB.UI.EditRegions"}}
    </button>
</div>