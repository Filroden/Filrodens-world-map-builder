{{!--
    Biomes: the climate and moisture the biomes are worked out from (which rebuild climate and
    biomes, so they pause while painting), the biomes' colours and the custom biomes with their
    rules, how strongly the biome layer is drawn, and the legend. The paint brush is on the bar.
--}}
{{#> "modules/filrodens-world-map-builder/templates/parts/section.hbs" id="climate" title="FILRODENSWMB.UI.SettingsClimate" badge="FILRODENSWMB.UI.BadgeRebuildsClimate" rebuilds=true}}
    {{> "modules/filrodens-world-map-builder/templates/parts/shared-range.hbs" name="globalTemp" label="FILRODENSWMB.UI.GlobalTemp" value=(lookup uiState 'globalTemp') min=0 max=1 step=0.01}}
    {{> "modules/filrodens-world-map-builder/templates/parts/shared-range.hbs" name="seasonOffset" label="FILRODENSWMB.UI.SeasonOffset" value=(lookup uiState 'seasonOffset') min=-1 max=1 step=0.05}}
    {{> "modules/filrodens-world-map-builder/templates/parts/shared-range.hbs" name="altCooling" label="FILRODENSWMB.UI.AltitudeCooling" value=(lookup uiState 'altCooling') min=0 max=1 step=0.05}}
    {{> "modules/filrodens-world-map-builder/templates/parts/shared-range.hbs" name="freezingThreshold" label="FILRODENSWMB.UI.FreezingThreshold" value=(lookup uiState 'freezingThreshold') min=0 max=1 step=0.05}}
{{/"modules/filrodens-world-map-builder/templates/parts/section.hbs"}}

{{#> "modules/filrodens-world-map-builder/templates/parts/section.hbs" id="moisture" title="FILRODENSWMB.UI.SectionMoisture" badge="FILRODENSWMB.UI.BadgeRebuildsClimate" rebuilds=true}}
    {{> "modules/filrodens-world-map-builder/templates/parts/shared-range.hbs" name="globalMoisture" label="FILRODENSWMB.UI.GlobalMoisture" value=(lookup uiState 'globalMoisture') min=0 max=1 step=0.01}}
    {{> "modules/filrodens-world-map-builder/templates/parts/shared-range.hbs" name="noise.moisture.scale" label="FILRODENSWMB.UI.MoistureScale" value=(lookup uiState 'noise.moisture.scale') min=100 max=8000 step=10 display=(numberFormat (lookup uiState "noise.moisture.scale") decimals=0)}}
{{/"modules/filrodens-world-map-builder/templates/parts/section.hbs"}}

{{#> "modules/filrodens-world-map-builder/templates/parts/section.hbs" id="biomeColours" title="FILRODENSWMB.UI.SectionEditBiomes" badge="FILRODENSWMB.UI.BadgeInstant" instant=true closed=true}}
    <div class="fwmb-biome-legend">
        {{#each biomeList}}
            {{#unless this.isCustom}}
                <div class="fwmb-biome-item">
                    <input type="color" class="fwmb-swatch" name="color_{{this.key}}" value="{{this.hex}}" data-biome="{{this.key}}" aria-label="{{localize this.label}}" />
                    <label class="fwmb-biome-label">{{localize this.label}}</label>
                </div>
            {{/unless}}
        {{/each}}
    </div>

    <div class="fwmb-subsection-heading">
        <span>{{localize "FILRODENSWMB.UI.SettingsCustomBiomes"}}</span>
        <button type="button" class="fwmb-btn fwmb-btn--subtle fwmb-btn--square" data-action="addCustomBiome" aria-label="{{localize 'FILRODENSWMB.UI.AddCustomBiome'}}" data-tooltip="{{localize 'FILRODENSWMB.UI.AddCustomBiome'}}">
            <i class="fwmb-icon fwmb-icon--add"></i>
        </button>
    </div>
    <div role="listbox" aria-label="{{localize 'FILRODENSWMB.UI.SettingsCustomBiomes'}}" data-list-nav class="fwmb-list-container fwmb-scrollable fwmb-scrollable--stable">
        {{#each customBiomes}}
            <div role="option" aria-selected="false" tabindex="-1" data-list-item class="fwmb-list-item" data-id="{{this.id}}" data-action="editCustomBiome">
                <div class="fwmb-swatch" style="background-color: {{this.hex}};"></div>
                {{#if this.hasRules}}<i class="fwmb-icon fwmb-icon--tune fwmb-rule-indicator" data-tooltip="{{localize 'FILRODENSWMB.UI.BiomeHasRulesTooltip'}}"></i>{{/if}}
                <span class="fwmb-name fwmb-flex-1" title="{{this.name}}">{{this.name}}</span>
                {{#if this.code}}<span class="fwmb-badge" data-tooltip="{{localize 'FILRODENSWMB.UI.BiomeCodeTooltip' code=this.code}}">{{this.code}}</span>{{/if}}
                <span class="fwmb-actions">
                    <button type="button" class="fwmb-btn fwmb-btn--square fwmb-btn--danger-quiet" data-action="deleteCustomBiome" aria-label="{{localize 'FILRODENSWMB.UI.DeleteBiome'}}" data-tooltip="{{localize 'FILRODENSWMB.UI.DeleteBiome'}}">
                        <i class="fwmb-icon fwmb-icon--delete"></i>
                    </button>
                </span>
            </div>
        {{else}}
            <div class="fwmb-list-empty" role="none">{{localize "FILRODENSWMB.UI.NoCustomBiomes"}}</div>
        {{/each}}
    </div>

    <div class="fwmb-btn-row">
        <button type="button" class="fwmb-btn" data-action="openBiomeRuleEditor">
            <i class="fwmb-icon fwmb-icon--tune"></i>
            {{localize "FILRODENSWMB.UI.OpenRuleEditor"}}
        </button>

        <button type="button" class="fwmb-btn fwmb-btn--square fwmb-btn--subtle" id="fwmb-preview-fallback-btn" aria-label="{{localize 'FILRODENSWMB.UI.PreviewFallbackCoverageHint'}}" data-tooltip="{{localize 'FILRODENSWMB.UI.PreviewFallbackCoverageHint'}}">
            <i class="fwmb-icon fwmb-icon--visibility"></i>
        </button>
    </div>
{{/"modules/filrodens-world-map-builder/templates/parts/section.hbs"}}

{{#> "modules/filrodens-world-map-builder/templates/parts/section.hbs" id="biomeDisplay" title="FILRODENSWMB.UI.SectionDisplay" badge="FILRODENSWMB.UI.BadgeInstant" instant=true closed=true}}
    {{> "modules/filrodens-world-map-builder/templates/parts/shared-range.hbs" name="biomeAlphaActive" label="FILRODENSWMB.UI.ActiveBiomeOpacity" value=(lookup uiState 'biomeAlphaActive') min=0 max=1 step=0.05}}
    {{> "modules/filrodens-world-map-builder/templates/parts/shared-range.hbs" name="biomeAlphaInactive" label="FILRODENSWMB.UI.InactiveBiomeOpacity" value=(lookup uiState 'biomeAlphaInactive') min=0 max=1 step=0.05}}
{{/"modules/filrodens-world-map-builder/templates/parts/section.hbs"}}

{{#> "modules/filrodens-world-map-builder/templates/parts/section.hbs" id="biomeLegend" title="FILRODENSWMB.UI.BiomeLegend" closed=true}}
    <div class="fwmb-biome-legend">
        {{#each biomeList}}
            <div class="fwmb-biome-item">
                <div class="fwmb-swatch" style="background-color: {{this.hex}};"></div>
                <span>{{#if this.isCustom}}{{this.label}}{{else}}{{localize this.label}}{{/if}}</span>
            </div>
        {{/each}}
    </div>
{{/"modules/filrodens-world-map-builder/templates/parts/section.hbs"}}
