<div class="fwmb-tool-content fwmb-scrollable">
    <fieldset class="fwmb-fieldset">
        <legend>{{localize "FILRODENSWMB.UI.ReferenceImage"}}</legend>

        <div class="fwmb-form-group fwmb-form-group--stacked">
            <label>{{localize "FILRODENSWMB.UI.ImageSource"}}</label>
            <div class="fwmb-form-fields">
                <div class="fwmb-flex-row fwmb-flex-row--centred">
                    <file-picker class="fwmb-flex-1" name="referenceImage" type="image" value="{{uiState.referenceImage}}"></file-picker>
                    <button type="button" class="fwmb-btn fwmb-btn--square fwmb-btn--muted fwmb-btn--danger" data-action="removeReferenceImage" data-tooltip="{{localize 'FILRODENSWMB.UI.RemoveImage'}}">
                        <i class="fwmb-icon fwmb-icon--delete"></i>
                    </button>
                </div>
            </div>
        </div>

        {{> "modules/filrodens-world-map-builder/templates/parts/shared-range.hbs" name="referenceAlpha" label="FILRODENSWMB.UI.Opacity" value=(lookup uiState 'referenceAlpha') min=0 max=1 step=0.05}}

        <div class="fwmb-form-group fwmb-form-group--stacked fwmb-space-before">
            <label>{{localize "FILRODENSWMB.UI.MapTransform"}}</label>
            <div class="fwmb-form-fields">
                <div class="fwmb-transform-controls">

                    <div class="fwmb-transform-zoom">
                        <button type="button" class="fwmb-btn" data-action="adjustReferenceScale" data-dir="1" data-tooltip="{{localize 'FILRODENSWMB.UI.ZoomIn'}}">
                            <i class="fwmb-icon fwmb-icon--zoom-in"></i>
                        </button>
                        <button type="button" class="fwmb-btn" data-action="resetReferenceScale" data-tooltip="{{localize 'FILRODENSWMB.UI.ResetScale'}}">
                            <i class="fwmb-icon fwmb-icon--center-focus"></i>
                        </button>
                        <button type="button" class="fwmb-btn" data-action="adjustReferenceScale" data-dir="-1" data-tooltip="{{localize 'FILRODENSWMB.UI.ZoomOut'}}">
                            <i class="fwmb-icon fwmb-icon--zoom-out"></i>
                        </button>
                    </div>

                    <div class="fwmb-transform-dpad">
                        <button type="button" class="fwmb-dpad-up" data-action="nudgeReference" data-dx="0" data-dy="-1" data-tooltip="{{localize 'FILRODENSWMB.UI.PanNorth'}}"><i
                                class="fwmb-icon fwmb-icon--edit-arrow-up"
                            ></i></button>
                        <button type="button" class="fwmb-dpad-left" data-action="nudgeReference" data-dx="-1" data-dy="0" data-tooltip="{{localize 'FILRODENSWMB.UI.PanWest'}}"><i
                                class="fwmb-icon fwmb-icon--edit-arrow-up fwmb-rotate-270"
                            ></i></button>
                        <button type="button" class="fwmb-dpad-center" data-action="resetReferencePan" data-tooltip="{{localize 'FILRODENSWMB.UI.CenterImage'}}"><i class="fwmb-icon fwmb-icon--center-focus"></i></button>
                        <button type="button" class="fwmb-dpad-right" data-action="nudgeReference" data-dx="1" data-dy="0" data-tooltip="{{localize 'FILRODENSWMB.UI.PanEast'}}"><i
                                class="fwmb-icon fwmb-icon--edit-arrow-up fwmb-rotate-90"
                            ></i></button>
                        <button type="button" class="fwmb-dpad-down" data-action="nudgeReference" data-dx="0" data-dy="1" data-tooltip="{{localize 'FILRODENSWMB.UI.PanSouth'}}"><i
                                class="fwmb-icon fwmb-icon--edit-arrow-down"
                            ></i></button>
                    </div>

                </div>
            </div>
        </div>

    </fieldset>
</div>