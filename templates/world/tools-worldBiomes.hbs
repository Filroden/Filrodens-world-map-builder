{{!--
    Biomes (S0 step 4; a page from step 4c-1, board C1): the world's biome table, every map reading
    it. A row a biome, built-in then custom: its colour and name, its kind, where it can lie, and the
    four numbers Generate reads of it (a custom biome that takes another's says so), each opening in
    the inspector (BiomeEditor: a built-in biome's colour, a custom biome's every field), with the
    rule editor at the head. How much of a map each covers is that map's Biome legend, and painting
    them the Biomes tool's. Read only on a held regional world.
--}}
{{> "modules/filrodens-world-map-builder/templates/world/parts/world-editor-head.hbs"}}
<fieldset class="fwmb-world-editor fwmb-page-stack"{{#if worldEditor.locked}} disabled{{/if}}>
<div class="fwmb-page-bar">
    <span class="fwmb-section-title">{{localize "FILRODENSWMB.UI.WorldBiomes"}} <span class="fwmb-meta">{{biomeTable.count}}</span></span>
    <button type="button" class="fwmb-btn" data-action="openBiomeRuleEditor"><i class="fwmb-icon fwmb-icon--tune" aria-hidden="true"></i>{{localize "FILRODENSWMB.UI.RuleEditorOpen"}}</button>
    <button type="button" class="fwmb-btn fwmb-btn--primary" data-action="addCustomBiome"><i class="fwmb-icon fwmb-icon--add" aria-hidden="true"></i>{{localize "FILRODENSWMB.UI.AddABiome"}}</button>
</div>
<div class="fwmb-world-table-wrap fwmb-world-table-wrap--scroll">
<table class="fwmb-world-table" role="grid" aria-label="{{localize 'FILRODENSWMB.UI.WorldBiomes'}}" data-list-nav>
    <thead><tr>
        <th scope="col">{{localize "FILRODENSWMB.UI.BiomeColumn"}}</th>
        <th scope="col">{{localize "FILRODENSWMB.UI.KindColumn"}}</th>
        <th scope="col">{{localize "FILRODENSWMB.UI.WhereColumn"}}</th>
        {{#each biomeTable.properties}}<th scope="col" class="fwmb-num" data-tooltip="{{localize this.hint}}">{{localize this.label}}</th>{{/each}}
    </tr></thead>
    <tbody>
    {{#each biomeTable.rows}}
    <tr aria-selected="{{#if this.selected}}true{{else}}false{{/if}}" tabindex="-1" data-list-item {{#if this.isCustom}}data-id="{{this.id}}" data-action="editCustomBiome"{{else}}data-biome-key="{{this.key}}" data-action="editBuiltInBiome"{{/if}}>
        <td><span class="fwmb-table-name"><span class="fwmb-chip-swatch" aria-hidden="true" style="--swatch: {{this.hex}}"></span><b>{{this.name}}</b>{{#if this.code}}<span class="fwmb-badge" data-tooltip="{{localize 'FILRODENSWMB.UI.BiomeCodeTooltip' code=this.code}}">{{this.code}}</span>{{/if}}{{#if this.hasRules}}<i class="fwmb-icon fwmb-icon--tune fwmb-rule-indicator" data-tooltip="{{localize 'FILRODENSWMB.UI.BiomeHasRulesTooltip'}}"></i>{{/if}}</span></td>
        <td><span class="fwmb-badge">{{this.kind}}</span></td>
        <td>{{this.where}}</td>
        {{#if this.behaves}}<td colspan="4" class="fwmb-table-wrap">{{this.behaves}}</td>
        {{else}}{{#each this.numbers}}<td class="fwmb-num">{{this}}</td>{{/each}}{{/if}}
    </tr>
    {{/each}}
    </tbody>
</table>
</div>
</fieldset>
