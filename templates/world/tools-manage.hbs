{{!--
    Worlds (v5, S0 step 3b; board W9), opened from the world bar (Open world, the name menu) and
    what the studio opens on: a card per world of its own, filling the studio's body beside the
    inspector. Each card has its Surface map's thumbnail (or its map type's icon), its name, its
    marks, a line of what it is, and its regional worlds counted; with a search, the regional
    worlds that matched in its family as chips. A card or chip chosen shows that world in the
    inspector (WorldEditor), where its family's tree leads to the rest; a double-click opens it.
    Search sits in the head above the scroll (tools-manage-head.hbs), the actions in the foot below
    it (tools-manage-foot.hbs), and the header's Back to goes back to the map. See WorldsPanel.
--}}
<div class="fwmb-tool-content fwmb-worlds">
    {{#if worlds.empty}}
        <div class="fwmb-empty-state fwmb-worlds-empty">
            <span class="fwmb-icon fwmb-icon--public" aria-hidden="true"></span>
            <p>{{localize "FILRODENSWMB.UI.NoSavedWorlds"}}</p>
            <button type="button" class="fwmb-btn fwmb-btn--primary" data-action="newWorld"><span class="fwmb-icon fwmb-icon--add" aria-hidden="true"></span>{{localize "FILRODENSWMB.UI.MenuNewWorld"}}</button>
        </div>
    {{else if worlds.noMatches}}
        <div class="fwmb-empty-state"><p>{{localize "FILRODENSWMB.UI.WorldsNoMatches"}}</p></div>
    {{else}}
        <div class="fwmb-cards fwmb-worlds-cards" data-list-nav>
            {{#each worlds.cards}}
            <div class="fwmb-worlds-card">
                <button type="button" class="fwmb-card" data-action="selectWorld" data-world-id="{{this.id}}" data-list-item tabindex="-1" aria-current="{{#if this.selected}}true{{else}}false{{/if}}" aria-label="{{this.name}}">
                    <span class="fwmb-card-thumb">
                        {{#if this.thumbnail}}<img src="{{this.thumbnail}}" alt="">{{else}}<span class="fwmb-card-thumb-icon"><span class="fwmb-icon fwmb-icon--landscape" aria-hidden="true"></span></span>{{/if}}
                    </span>
                    <span class="fwmb-card-body">
                        <span class="fwmb-card-title">{{this.name}}</span>
                        {{#if this.meta}}<span class="fwmb-card-meta fwmb-card-line">{{this.meta}}</span>{{/if}}
                        {{#if this.marks.length}}<span class="fwmb-card-meta">{{#each this.marks}}<span class="fwmb-state-mark fwmb-state-mark--{{this.kind}}"{{#if this.tooltip}} data-tooltip="{{this.tooltip}}"{{/if}}><span class="fwmb-icon fwmb-icon--{{this.icon}}" aria-hidden="true"></span>{{this.label}}</span>{{/each}}</span>{{/if}}
                        {{#if this.regional}}<span class="fwmb-card-meta"><span class="fwmb-chip"><span class="fwmb-icon fwmb-icon--crop" aria-hidden="true"></span>{{this.regional}}</span></span>{{/if}}
                    </span>
                </button>
                {{#if this.matches.length}}
                <div class="fwmb-worlds-matches" aria-label="{{localize 'FILRODENSWMB.UI.WorldsMatchesLabel'}}">
                    {{#each this.matches}}<button type="button" class="fwmb-worlds-match" data-action="selectWorld" data-world-id="{{this.id}}" aria-current="{{#if this.selected}}true{{else}}false{{/if}}"><span class="fwmb-icon fwmb-icon--crop" aria-hidden="true"></span>{{this.name}}</button>{{/each}}
                </div>
                {{/if}}
            </div>
            {{/each}}
        </div>
    {{/if}}
</div>
