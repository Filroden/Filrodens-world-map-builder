{{!--
    The world's ages and events (S0 step 4b; a table from step 4c-1, board C6): a row an age, oldest
    first (the last is the present), with its era, strife and events, opening in the age inspector,
    and moved earlier or later or removed from its row; Age at the head adds one.
--}}
<div class="fwmb-page-bar">
    <span class="fwmb-section-title">{{localize "FILRODENSWMB.UI.SectionGenerateAges"}} <span class="fwmb-badge fwmb-badge--count">{{generate.ages.count}}</span></span>
    {{#if generate.ages.canAdd}}<button type="button" class="fwmb-btn fwmb-btn--primary" data-action="addAge"><i class="fwmb-icon fwmb-icon--add" aria-hidden="true"></i>{{localize "FILRODENSWMB.UI.GenerateAgeAdd"}}</button>{{/if}}
</div>
{{!-- The page's lede says what the ages are; only a held world's note adds to it --}}
{{#if generate.ages.held}}<p class="fwmb-hint">{{localize "FILRODENSWMB.UI.GenerateAgesHeldHint"}}</p>{{/if}}
<div class="fwmb-world-table-wrap{{#if generate.ages.scrolls}} fwmb-world-table-wrap--scroll{{/if}}">
<table class="fwmb-world-table" role="grid" aria-label="{{localize 'FILRODENSWMB.UI.SectionGenerateAges'}}" data-list-nav>
    <thead><tr>
        <th scope="col">{{localize "FILRODENSWMB.UI.AgeColumn"}}</th>
        <th scope="col">{{localize "FILRODENSWMB.UI.GenerateEra"}}</th>
        <th scope="col">{{localize "FILRODENSWMB.UI.GenerateStrife"}}</th>
        <th scope="col">{{localize "FILRODENSWMB.UI.GenerateEvents"}}</th>
        <th scope="col"><span class="fwmb-visually-hidden">{{localize "FILRODENSWMB.UI.MoreOptions"}}</span></th>
    </tr></thead>
    <tbody>
    {{#each generate.ages.rows}}
    <tr class="fwmb-age-row" aria-selected="{{#if this.selected}}true{{else}}false{{/if}}" tabindex="-1" data-list-item data-id="{{this.id}}" data-action="openAge">
        <td><b>{{this.label}}</b></td>
        <td>{{this.era}}</td>
        <td>{{this.strife}}</td>
        <td class="fwmb-table-wrap">{{#if this.events}}{{this.events}}{{else}}<span class="fwmb-hint">{{localize "FILRODENSWMB.UI.AgeNoEvents"}}</span>{{/if}}</td>
        <td class="fwmb-table-actions">
            {{#unless this.held}}
            <button type="button" class="fwmb-btn fwmb-btn--subtle fwmb-btn--square" data-action="moveAgeUp" data-age="{{this.index}}" {{#unless this.canUp}}disabled{{/unless}} aria-label="{{localize 'FILRODENSWMB.UI.GenerateAgeEarlier'}}" data-tooltip="{{localize 'FILRODENSWMB.UI.GenerateAgeEarlier'}}"><i class="fwmb-icon fwmb-icon--arrow-upward"></i></button>
            <button type="button" class="fwmb-btn fwmb-btn--subtle fwmb-btn--square" data-action="moveAgeDown" data-age="{{this.index}}" {{#unless this.canDown}}disabled{{/unless}} aria-label="{{localize 'FILRODENSWMB.UI.GenerateAgeLater'}}" data-tooltip="{{localize 'FILRODENSWMB.UI.GenerateAgeLater'}}"><i class="fwmb-icon fwmb-icon--arrow-downward"></i></button>
            <button type="button" class="fwmb-btn fwmb-btn--square fwmb-btn--danger-quiet" data-action="removeAge" data-age="{{this.index}}" {{#unless this.canRemove}}disabled{{/unless}} aria-label="{{localize 'FILRODENSWMB.UI.GenerateAgeRemove'}}" data-tooltip="{{localize 'FILRODENSWMB.UI.GenerateAgeRemove'}}"><i class="fwmb-icon fwmb-icon--delete"></i></button>
            {{/unless}}
        </td>
    </tr>
    {{/each}}
    </tbody>
</table>
</div>
