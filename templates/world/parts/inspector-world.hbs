{{!--
    A world in the inspector, chosen in Worlds or the world overview (see WorldEditor): its name,
    renamed as the field is committed; Open; what it is (below Open, so its varying length moves
    nothing above it); its family as a tree (the world it belongs to at the top, each regional
    world under the one it was cut from), each row choosing that world, this one lit, the search's
    matches marked, each regional world with its zoom against the world it was cut from and Out of
    date where it is (S0 step 5); why this one is Out of date; the action list (Cut again… and
    Clone as new… only for a held regional world); Delete… apart. Rename and Delete… are off while
    the world (or, for Delete…, a world the delete rewrites) is open for editing in another tab or
    window (WL), their tooltip saying so.
    A label ending in "…" asks something first; one without acts at once.
--}}
<div class="fwmb-group">
    <div class="fwmb-form-group">
        <label class="fwmb-label" for="fwmb-inspector-world-name">{{localize "FILRODENSWMB.UI.Name"}}</label>
        <div class="fwmb-form-fields">
            <input type="text" id="fwmb-inspector-world-name" name="worldName" maxlength="{{fwmbTextLimit 'name'}}" value="{{world.name}}"{{#if renameOff}} readonly aria-readonly="true" data-tooltip="{{renameOff}}"{{/if}} />
        </div>
    </div>
    {{!-- A world with no maps yet opens too, on its overview (S0 step 4c-2) --}}
    <div class="fwmb-btn-row">
        <button type="button" class="fwmb-btn fwmb-btn--primary fwmb-btn--wide" data-inspector-action="open"{{#if isOpen}} disabled{{/if}}><span class="fwmb-icon fwmb-icon--folder-open" aria-hidden="true"></span>{{#if isOpen}}{{localize "FILRODENSWMB.UI.WorldIsOpen"}}{{else}}{{localize "FILRODENSWMB.UI.WorldOpen"}}{{/if}}</button>
    </div>
    <p class="fwmb-hint">{{about}}</p>
</div>

{{#if family.length}}
<div class="fwmb-group">
    <div class="fwmb-section-title">{{localize "FILRODENSWMB.UI.WorldFamily"}}</div>
    <div class="fwmb-list fwmb-worlds-family" role="tree" aria-label="{{localize 'FILRODENSWMB.UI.WorldFamily'}}">
        {{#each family}}
        <button type="button" class="fwmb-list-item{{#if this.match}} fwmb-is-match{{/if}}" role="treeitem" aria-level="{{this.level}}" style="--depth: {{this.depth}}" aria-selected="{{#if this.current}}true{{else}}false{{/if}}"{{#unless this.current}} data-inspector-action="showWorld" data-world-id="{{this.id}}"{{/unless}}>
            <span class="fwmb-icon fwmb-icon--{{this.icon}}" aria-hidden="true"></span>
            <span class="fwmb-name">{{this.name}}</span>
            {{#if this.zoom}}<span class="fwmb-tree-zoom">{{this.zoom}}</span>{{/if}}
            {{#if this.stale}}<span class="fwmb-state-mark fwmb-state-mark--stale" data-tooltip="{{this.stale}}" aria-label="{{localize 'FILRODENSWMB.UI.MarkOutOfDate'}}"><span class="fwmb-icon fwmb-icon--sync" aria-hidden="true"></span></span>{{/if}}
            {{#if this.held}}<span class="fwmb-state-mark fwmb-state-mark--held" data-tooltip="{{localize 'FILRODENSWMB.UI.MarkRegionalWorld'}}" aria-label="{{localize 'FILRODENSWMB.UI.MarkRegionalWorld'}}"><span class="fwmb-icon fwmb-icon--lock" aria-hidden="true"></span></span>{{/if}}
        </button>
        {{/each}}
    </div>
</div>
{{/if}}

{{#if stale.length}}
<div class="fwmb-notice fwmb-inspector-notice" role="note">
    <span class="fwmb-notice-title"><span class="fwmb-icon fwmb-icon--sync" aria-hidden="true"></span>{{localize "FILRODENSWMB.UI.MarkOutOfDate"}}</span>
    {{#each stale}}<span>{{this}}</span>{{/each}}
</div>
{{/if}}

<div class="fwmb-action-list">
    {{#if cutAgain}}
    <button type="button" class="fwmb-action-row"{{#if cutAgain.off}} aria-disabled="true" data-tooltip="{{cutAgain.off}}"{{else}} data-inspector-action="cutAgain"{{/if}}>
        <span class="fwmb-icon fwmb-icon--crop" aria-hidden="true"></span>
        <span class="fwmb-action-text"><b>{{localize "FILRODENSWMB.UI.WorldCutAgain"}}</b><span>{{#if cutAgain.off}}{{cutAgain.off}}{{else}}{{cutAgain.note}}{{/if}}</span></span>
    </button>
    {{/if}}
    {{#if held}}
    <button type="button" class="fwmb-action-row" data-inspector-action="cloneAsNew">
        <span class="fwmb-icon fwmb-icon--content-copy" aria-hidden="true"></span>
        <span class="fwmb-action-text"><b>{{localize "FILRODENSWMB.UI.WorldCloneAsNew"}}</b><span>{{localize "FILRODENSWMB.UI.WorldCloneAsNewNote"}}</span></span>
    </button>
    {{/if}}
    <button type="button" class="fwmb-action-row" data-inspector-action="duplicate">
        <span class="fwmb-icon fwmb-icon--content-copy" aria-hidden="true"></span>
        <span class="fwmb-action-text"><b>{{localize "FILRODENSWMB.UI.Duplicate"}}</b><span>{{#if held}}{{localize "FILRODENSWMB.UI.WorldDuplicateHeldNote"}}{{else}}{{localize "FILRODENSWMB.UI.WorldDuplicateNote"}}{{/if}}</span></span>
    </button>
    {{!-- A world file holds a world's maps: a world with none yet has nothing to export --}}
    <button type="button" class="fwmb-action-row"{{#if hasMap}} data-inspector-action="exportWorld"{{else}} aria-disabled="true" data-tooltip="{{localize 'FILRODENSWMB.UI.WorldExportNoMaps'}}"{{/if}}>
        <span class="fwmb-icon fwmb-icon--file-export" aria-hidden="true"></span>
        <span class="fwmb-action-text"><b>{{localize "FILRODENSWMB.UI.MenuExportWorld"}}</b><span>{{localize "FILRODENSWMB.UI.WorldExportNote"}}</span></span>
    </button>
</div>

<div class="fwmb-foot-danger">
    <button type="button" class="fwmb-btn fwmb-btn--danger-quiet"{{#if deleteOff}} aria-disabled="true" data-tooltip="{{deleteOff}}"{{else}} data-inspector-action="delete"{{/if}}><span class="fwmb-icon fwmb-icon--delete" aria-hidden="true"></span>{{localize "FILRODENSWMB.UI.DeleteEllipsis"}}</button>
</div>
