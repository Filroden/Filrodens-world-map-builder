{{!--
    The context bar while a world tool is open beside the map (S0 step 4): the map shown on the
    canvas, and a reminder that the world's settings reach every map in the world, not just this one.
--}}
<div class="fwmb-contents fwmb-bar-world">
    <span class="fwmb-bar-world-map"><span class="fwmb-icon fwmb-icon--landscape" aria-hidden="true"></span>{{localize "FILRODENSWMB.UI.WorldBarShowing"}} <b>{{localize "FILRODENSWMB.UI.LayerSurfaceFull"}}</b></span>
    <span class="fwmb-bar-world-hint">{{localize "FILRODENSWMB.UI.WorldBarHint"}}</span>
</div>
