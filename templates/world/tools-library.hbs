{{!--
    Styles and icons (tool id "library"; on the world's rail from S0 step 4b; a page from step 4c-1,
    board C7): the world's styles for pins, routes, regions and labels (see StyleLists) in one table
    grouped by kind, each row with a preview, its kind and how many objects on the map use it,
    opened in the inspector by a click or Enter, with Rename, Duplicate and Delete in its menu, each
    kind's own styles first, then its reserved ones (see ReservedStyles), each with a lock saying
    what uses it and no Delete; Import and Export styles at the head (the file carries the custom
    biomes too); then the pin icons on offer. A style's change reaches the map's own objects, so it
    stays an undo step of the map (Undo and Redo in the page's head). Read only on a held regional
    world.
--}}
{{> "modules/filrodens-world-map-builder/templates/world/parts/world-editor-head.hbs"}}
<fieldset class="fwmb-world-editor fwmb-page-stack"{{#if worldEditor.held}} disabled{{/if}}>
<div class="fwmb-page-bar">
    <span class="fwmb-section-title">{{localize "FILRODENSWMB.UI.SectionStyles"}} <span class="fwmb-badge fwmb-badge--count">{{styleCount}}</span></span>
    <button type="button" class="fwmb-btn" data-action="importSettings" data-tooltip="{{localize 'FILRODENSWMB.UI.ImportSettingsHint'}}"><i class="fwmb-icon fwmb-icon--upload-file" aria-hidden="true"></i>{{localize "FILRODENSWMB.UI.ImportStyles"}}</button>
    <button type="button" class="fwmb-btn" data-action="exportSettings" data-tooltip="{{localize 'FILRODENSWMB.UI.ExportSettingsHint'}}"><i class="fwmb-icon fwmb-icon--file-export" aria-hidden="true"></i>{{localize "FILRODENSWMB.UI.ExportStyles"}}</button>
</div>
<div class="fwmb-world-table-wrap fwmb-world-table-wrap--scroll">
<table class="fwmb-world-table" role="grid" aria-label="{{localize 'FILRODENSWMB.UI.SectionStyles'}}">
    <thead><tr><th scope="col">{{localize "FILRODENSWMB.UI.StyleColumn"}}</th><th scope="col">{{localize "FILRODENSWMB.UI.KindColumn"}}</th><th scope="col">{{localize "FILRODENSWMB.UI.UsedByColumn"}}</th></tr></thead>
    {{#each styleLists}}
    <tbody aria-label="{{localize this.title}}" data-list-nav data-style-list="{{this.type}}">
    <tr class="fwmb-table-group"><td colspan="3"><span class="fwmb-table-group-head">{{localize this.title}} <span class="fwmb-badge fwmb-badge--count">{{this.count}}</span><button type="button" class="fwmb-btn fwmb-btn--subtle" data-action="addStyle" data-style-type="{{this.type}}"><i class="fwmb-icon fwmb-icon--add" aria-hidden="true"></i>{{localize this.add}}</button></span></td></tr>
    {{#each this.rows}}{{> styleRow this type=../type reservedRow=false}}{{/each}}
    {{#if this.empty}}<tr class="fwmb-table-empty"><td colspan="3">{{localize "FILRODENSWMB.UI.NoCustomStyles"}}</td></tr>{{/if}}
    {{#each this.reserved}}{{> styleRow this type=../type reservedRow=true}}{{/each}}
    </tbody>
    {{/each}}
</table>
</div>

{{#> "modules/filrodens-world-map-builder/templates/shell/parts/section.hbs" id="builtinPinIcons" title="FILRODENSWMB.UI.SettingsBuiltinPinIcons" closed=true}}
    <div class="fwmb-hint fwmb-long">{{localize "FILRODENSWMB.UI.BuiltinPinIconsHint"}}</div>

    <div class="fwmb-bulk-actions">
        {{!-- Buttons, so the keyboard reaches them (S0 step 8b: they were links with no address) --}}
        <button type="button" class="fwmb-btn" data-action="hideAllBuiltinPinIcons">{{localize "FILRODENSWMB.UI.HideAllPinIcons"}}</button>
        <button type="button" class="fwmb-btn" data-action="revealAllBuiltinPinIcons">{{localize "FILRODENSWMB.UI.RevealAllPinIcons"}}</button>
    </div>

    <div class="fwmb-list-container fwmb-scrollable fwmb-scrollable--stable fwmb-space-before">
        {{#each builtinPinIcons}}
            <div class="fwmb-list-item">
                <i class="fwmb-icon fwmb-list-icon fwmb-icon--{{this.key}}"></i>
                <span class="fwmb-name fwmb-flex-1" title="{{this.label}}">{{this.label}}</span>
                {{#if this.isProtected}}
                    <input type="checkbox" class="fwmb-checkbox" disabled aria-label="{{localize 'FILRODENSWMB.UI.PinIconProtected'}}" data-tooltip="{{localize 'FILRODENSWMB.UI.PinIconProtected'}}" />
                {{else}}
                    <input
                        type="checkbox"
                        class="fwmb-checkbox"
                        data-action="toggleBuiltinPinIcon"
                        data-key="{{this.key}}"
                        data-panel-ui
                        {{#if this.isDisabled}}checked{{/if}}
                        aria-label="{{localize 'FILRODENSWMB.UI.DisablePinIcon'}}"
                        data-tooltip="{{localize 'FILRODENSWMB.UI.DisablePinIcon'}}"
                    />
                {{/if}}
            </div>
        {{/each}}
    </div>
{{/"modules/filrodens-world-map-builder/templates/shell/parts/section.hbs"}}

{{#> "modules/filrodens-world-map-builder/templates/shell/parts/section.hbs" id="customPinIcons" title="FILRODENSWMB.UI.SettingsCustomPinIcons" count=customPinIcons.length addAction="addCustomPinIcon" addLabel="FILRODENSWMB.UI.AddCustomPinIcon"}}
    <div role="listbox" aria-label="{{localize 'FILRODENSWMB.UI.SettingsCustomPinIcons'}}" data-list-nav class="fwmb-list-container fwmb-scrollable fwmb-scrollable--stable fwmb-space-before">
        {{#each customPinIcons}}
            <div role="option" aria-selected="false" tabindex="-1" data-list-item class="fwmb-list-item" data-id="{{this.id}}" data-action="editCustomPinIcon">
                <i class="fwmb-icon fwmb-list-icon" style="--fwmb-mask: url('{{this.path}}');"></i>
                <span class="fwmb-name fwmb-flex-1" title="{{this.name}}">{{this.name}}</span>
                <span class="fwmb-actions">
                    <button type="button" class="fwmb-btn fwmb-btn--square fwmb-btn--danger-quiet" data-action="removeCustomPinIcon" aria-label="{{localize 'FILRODENSWMB.UI.RemovePinIcon'}}" data-tooltip="{{localize 'FILRODENSWMB.UI.RemovePinIcon'}}">
                        <i class="fwmb-icon fwmb-icon--variable-remove"></i>
                    </button>
                </span>
            </div>
        {{else}}
            <div class="fwmb-list-empty" role="none">{{localize "FILRODENSWMB.UI.NoCustomPinIcons"}}</div>
        {{/each}}
    </div>
{{/"modules/filrodens-world-map-builder/templates/shell/parts/section.hbs"}}

</fieldset>

{{#*inline "styleRowPreview"}}
{{#if line}}<span class="fwmb-style-preview fwmb-style-preview--line" aria-hidden="true" style="--line-color: {{color}}; --line-width: calc({{thickness}} * 0.0625rem); --line-style: {{stroke}};"></span>{{/if}}
{{#if fill}}<span class="fwmb-chip-swatch{{#unless color}} fwmb-chip-swatch--none{{/unless}}" aria-hidden="true" {{#if color}}style="--swatch: {{color}}"{{/if}}></span>{{/if}}
{{#if text}}<span class="fwmb-style-preview fwmb-style-preview--text" aria-hidden="true" style="font-family: &quot;{{family}}&quot;; color: {{color}}; font-weight: {{weight}}; font-style: {{slant}};">Aa</span>{{/if}}
{{#if icon}}<i class="fwmb-icon fwmb-pin-style-glyph {{#unless isCustom}}fwmb-icon--{{key}}{{/unless}}" aria-hidden="true" {{#if isCustom}}style="--fwmb-mask: url('{{path}}');"{{/if}}></i>{{/if}}
{{/inline}}

{{#*inline "styleRow"}}
{{#if naming}}
<tr class="fwmb-table-naming" aria-selected="true"><td colspan="3">
    <input type="text" class="fwmb-input" value="{{value}}" maxlength="{{fwmbTextLimit 'name'}}" aria-label="{{localize label}}" data-style-naming data-panel-ui autocomplete="off" spellcheck="false" />
</td></tr>
{{else}}
<tr aria-selected="{{#if selected}}true{{else}}false{{/if}}" tabindex="-1" data-list-item class="{{#if reservedRow}}fwmb-is-reserved{{/if}}" data-id="{{id}}" data-style-type="{{type}}" data-action="openStyle">
    <td><span class="fwmb-table-name">{{> styleRowPreview preview}}<b>{{name}}</b></span></td>
    <td>{{#if reservedRow}}<span class="fwmb-badge" data-tooltip="{{localize 'FILRODENSWMB.UI.ReservedStylesHint'}}"><span class="fwmb-icon fwmb-icon--lock" aria-hidden="true"></span>{{localize "FILRODENSWMB.UI.SectionReservedStyles"}}</span>{{else}}<span class="fwmb-badge">{{localize "FILRODENSWMB.UI.Custom"}}</span>{{/if}}</td>
    <td class="fwmb-table-wrap">
        <span class="fwmb-table-used">
        {{#if reservedRow}}<span class="fwmb-table-lock"><span class="fwmb-icon fwmb-icon--lock" aria-hidden="true"></span>{{reserved}}</span>{{/if}}
        <span class="fwmb-hint" data-tooltip="{{localize 'FILRODENSWMB.UI.QuickStyleUsageTooltip' count=usageCount}}">{{localize "FILRODENSWMB.UI.StyleUsedOnMap" count=usageCount}}</span>
        <span class="fwmb-table-actions">
            <div class="fwmb-dropdown fwmb-row-menu">
                <button type="button" class="fwmb-btn fwmb-btn--subtle fwmb-btn--square" aria-label="{{localize 'FILRODENSWMB.UI.MoreOptions'}}" data-tooltip="{{localize 'FILRODENSWMB.UI.MoreOptions'}}">
                    <i class="fwmb-icon fwmb-icon--more-vert"></i>
                </button>
                <div class="fwmb-dropdown-menu">
                    <button type="button" data-action="renameStyle"><i class="fwmb-icon fwmb-icon--edit"></i> {{localize "FILRODENSWMB.UI.Rename"}}</button>
                    <button type="button" data-action="duplicateStyle"><i class="fwmb-icon fwmb-icon--content-copy"></i> {{localize "FILRODENSWMB.UI.Duplicate"}}</button>
                    {{#unless reservedRow}}<button type="button" data-action="deleteStyle" class="fwmb-danger"><i class="fwmb-icon fwmb-icon--delete"></i> {{localize "FILRODENSWMB.UI.Delete"}}</button>{{/unless}}
                </div>
            </div>
        </span>
        </span>
    </td>
</tr>
{{/if}}
{{/inline}}
