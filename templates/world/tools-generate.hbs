{{!--
    Peoples and realms (tool id "generate"; see GeneratePanel): the run itself at the top, with
    Generate all for every map of the world that needs it, on a regional map Fill in (see
    Infilling), then the settings: what this map's run reads from the world (Go blocks to its
    Cultures, Ages and events and Default name style, S0 step 4b), Society and Output. On a regional map holding its parent's run
    (generate.held, see Generation.heldByParent) there is no Generate: Fill in only, with the
    settings carried from the parent shown read only (the seed, the estimate and Output left out),
    the settlements, routes and realms are made with, what the last run made, and Remove generated
    content. Fields are named
    "generator.<path>" and kept with the map. The estimate and the notices come from GeneratePanel.
--}}
{{#unless generate.held}}
<div class="fwmb-generate-action">
    <button type="button" class="fwmb-btn fwmb-btn--primary fwmb-btn--wide" data-action="generateWorld" data-tooltip="{{localize 'FILRODENSWMB.UI.GenerateRunHint'}}">
        {{#if generate.hasRun}}{{localize "FILRODENSWMB.UI.GenerateAgain"}}{{else}}{{localize "FILRODENSWMB.UI.GenerateRun"}}{{/if}}
    </button>
    {{!-- Every map of the world that needs it, in order (S0 step 4b; see GenerateAll) --}}
    <button type="button" class="fwmb-btn fwmb-btn--wide" data-action="generateAll" data-tooltip="{{localize 'FILRODENSWMB.UI.GenerateAllHint'}}">
        <span class="fwmb-icon fwmb-icon--generate" aria-hidden="true"></span>{{generate.generateAllLabel}}
    </button>
</div>
{{/unless}}

{{#> "modules/filrodens-world-map-builder/templates/shell/parts/section.hbs" id="generateRun" title="FILRODENSWMB.UI.SectionGenerateRun" badge=generate.runBadge}}
    {{#if generate.held}}
    <p class="fwmb-hint fwmb-generate-notice">{{localize "FILRODENSWMB.UI.GenerateHeldNotice"}}</p>
    {{else}}
    <div class="fwmb-form-group">
        <label for="fwmb-generator-seed">{{localize "FILRODENSWMB.UI.GenerateSeed"}}</label>
        <div class="fwmb-form-fields">
            <input type="text" id="fwmb-generator-seed" name="generator.seed" maxlength="{{fwmbTextLimit 'name'}}" value="{{generate.seed}}" placeholder="{{generate.mapSeed}}" data-tooltip="{{localize 'FILRODENSWMB.UI.GenerateSeedHint'}}" />
            <button type="button" class="fwmb-btn fwmb-btn--square" data-action="randomizeGeneratorSeed" aria-label="{{localize 'FILRODENSWMB.UI.Randomize'}}" data-tooltip="{{localize 'FILRODENSWMB.UI.Randomize'}}">
                <i class="fwmb-icon fwmb-icon--shuffle"></i>
            </button>
        </div>
    </div>
    {{/if}}

    {{#if generate.held}}{{else if generate.estimate}}
    <div class="fwmb-form-group">
        <label>{{localize "FILRODENSWMB.UI.GenerateEstimate"}}</label>
        <div class="fwmb-form-fields fwmb-setting-row--readout">
            <output class="fwmb-readout">{{localize "FILRODENSWMB.UI.GenerateEstimateValue" value=generate.estimate.value}}</output>
            <span class="fwmb-unit">{{localize generate.estimate.unit}}</span>
            <i class="fwmb-icon fwmb-icon--info" data-tooltip="{{localize 'FILRODENSWMB.UI.GenerateEstimateHint'}}"></i>
        </div>
    </div>
    {{#if generate.estimate.long}}<p class="fwmb-hint">{{localize "FILRODENSWMB.UI.GenerateLongRun"}}</p>{{/if}}
    {{/if}}

    {{#if generate.held}}{{else if generate.stale}}<p class="fwmb-hint fwmb-generate-notice">{{localize "FILRODENSWMB.UI.GenerateOutOfDateHint"}}</p>{{/if}}
    {{#if generate.held}}{{else if generate.older}}<p class="fwmb-hint fwmb-generate-notice">{{localize "FILRODENSWMB.UI.GenerateOlderRevisionHint"}}</p>{{/if}}
    {{#each generate.notices}}
    {{#if this.items}}
    <div class="fwmb-generate-notice fwmb-generate-notice--list">
        <p class="fwmb-hint" data-tooltip="{{this.hint}}">{{this.text}}</p>
        <ul class="fwmb-hint fwmb-generate-notice-items">{{#each this.items}}<li>{{this}}</li>{{/each}}</ul>
    </div>
    {{else}}
    <p class="fwmb-hint fwmb-generate-notice">{{#if this.text}}{{this.text}}{{else}}{{localize this}}{{/if}}</p>
    {{/if}}
    {{/each}}

{{/"modules/filrodens-world-map-builder/templates/shell/parts/section.hbs"}}

{{#> "modules/filrodens-world-map-builder/templates/shell/parts/section.hbs" id="generateReadFromWorld" title="FILRODENSWMB.UI.SectionReadFromWorld"}}
    <p class="fwmb-hint">{{localize "FILRODENSWMB.UI.ReadFromWorldHint"}}</p>
    {{#each generate.fromWorld}}
    <div class="fwmb-go-row">
        <span class="fwmb-icon fwmb-icon--{{this.icon}}" aria-hidden="true"></span>
        <span class="fwmb-go-row-text"><span class="fwmb-name">{{this.label}}</span><span class="fwmb-meta">{{this.summary}}</span></span>
        <button type="button" class="fwmb-btn fwmb-btn--go" data-action="openWorldTool" data-tool="{{this.tool}}" aria-label="{{this.goLabel}}" data-tooltip="{{this.goLabel}}">{{localize "FILRODENSWMB.UI.Go"}}</button>
    </div>
    {{/each}}
{{/"modules/filrodens-world-map-builder/templates/shell/parts/section.hbs"}}

{{#if generate.infill}}
{{#> "modules/filrodens-world-map-builder/templates/shell/parts/section.hbs" id="generateInfill" title="FILRODENSWMB.UI.SectionGenerateInfill" badge=generate.infill.badge}}
    <p class="fwmb-hint">{{localize "FILRODENSWMB.UI.InfillHint"}}</p>
    {{#if generate.infill.stale}}<p class="fwmb-hint fwmb-generate-notice">{{localize "FILRODENSWMB.UI.InfillOutOfDateHint"}}</p>{{/if}}
    {{#if generate.infill.offered}}
    {{#if generate.infill.again}}
    <dl class="fwmb-generate-results">
        <dt>{{localize "FILRODENSWMB.UI.InfillMarkets"}}</dt>
        <dd class="fwmb-readout">{{generate.infill.shown.markets}}</dd>
        <dt>{{localize "FILRODENSWMB.UI.InfillVillages"}}</dt>
        <dd class="fwmb-readout">{{generate.infill.shown.villages}}</dd>
        <dt>{{localize "FILRODENSWMB.UI.InfillLanes"}}</dt>
        <dd class="fwmb-readout">{{generate.infill.shown.lanes}}</dd>
    </dl>
    {{/if}}
    <button type="button" class="fwmb-btn fwmb-btn--wide" data-action="fillIn" data-tooltip="{{localize 'FILRODENSWMB.UI.InfillRunHint'}}">
        {{#if generate.infill.again}}{{localize "FILRODENSWMB.UI.InfillAgain"}}{{else}}{{localize "FILRODENSWMB.UI.InfillRun"}}{{/if}}
    </button>
    {{else}}
    <p class="fwmb-hint fwmb-generate-notice">{{localize generate.infill.reason}}</p>
    {{/if}}
{{/"modules/filrodens-world-map-builder/templates/shell/parts/section.hbs"}}
{{/if}}

{{#> "modules/filrodens-world-map-builder/templates/shell/parts/section.hbs" id="generateNames" title="FILRODENSWMB.UI.SectionGenerateNames"}}
    <p class="fwmb-hint">{{localize "FILRODENSWMB.UI.NameAllSectionHint"}}</p>
    <button type="button" class="fwmb-btn fwmb-btn--wide" data-action="nameAll" data-tooltip="{{localize 'FILRODENSWMB.UI.NameAllButtonHint'}}">
        <i class="fwmb-icon fwmb-icon--shuffle" aria-hidden="true"></i>{{localize "FILRODENSWMB.UI.NameAll"}}
    </button>
{{/"modules/filrodens-world-map-builder/templates/shell/parts/section.hbs"}}

{{#> "modules/filrodens-world-map-builder/templates/shell/parts/section.hbs" id="generateWorld" title="FILRODENSWMB.UI.SectionSociety" badge="FILRODENSWMB.UI.BadgeRebuildsPolitical"}}
    {{#each generate.world}}
    {{> "modules/filrodens-world-map-builder/templates/shell/parts/shared-range.hbs" name=this.name label=this.label hint=this.hint value=this.value min=this.min max=this.max step=this.step resetTo=this.resetTo disabled=this.disabled}}
    {{/each}}
{{/"modules/filrodens-world-map-builder/templates/shell/parts/section.hbs"}}

{{#unless generate.held}}
{{#> "modules/filrodens-world-map-builder/templates/shell/parts/section.hbs" id="generateOutput" title="FILRODENSWMB.UI.SectionGenerateOutput"}}
    <div class="fwmb-range-group-heading">{{localize "FILRODENSWMB.UI.GenerateLevels"}}</div>
    <p class="fwmb-hint">{{localize "FILRODENSWMB.UI.GenerateLevelsHint"}}</p>
    <label class="fwmb-setting-row">
        <input type="checkbox" name="generator.output.duchies" class="fwmb-checkbox" {{#if generate.output.duchies}}checked{{/if}} />
        {{localize "FILRODENSWMB.UI.GenerateDuchies"}}
    </label>
    <label class="fwmb-setting-row">
        <input type="checkbox" name="generator.output.counties" class="fwmb-checkbox" {{#if generate.output.counties}}checked{{/if}} {{#unless generate.output.duchies}}disabled{{/unless}} />
        {{localize "FILRODENSWMB.UI.GenerateCounties"}}
    </label>

    <div class="fwmb-range-group-heading">{{localize "FILRODENSWMB.UI.GeneratePlaces"}}</div>
    <p class="fwmb-hint">{{localize "FILRODENSWMB.UI.GeneratePlacesHint"}}</p>
    {{#each generate.output.places}}
    <label class="fwmb-setting-row">
        <input type="checkbox" name="{{this.name}}" class="fwmb-checkbox" {{#if this.checked}}checked{{/if}} />
        {{localize this.label}}
    </label>
    {{/each}}

    <div class="fwmb-range-group-heading">{{localize "FILRODENSWMB.UI.GenerateRoutes"}}</div>
    {{#each generate.output.routes}}
    <label class="fwmb-setting-row">
        <input type="checkbox" name="{{this.name}}" class="fwmb-checkbox" {{#if this.checked}}checked{{/if}} />
        {{localize this.label}}
    </label>
    {{/each}}

    {{#if generate.output.showHistory}}
    <div class="fwmb-range-group-heading">{{localize "FILRODENSWMB.UI.GenerateHistory"}}</div>
    <label class="fwmb-setting-row" data-tooltip="{{localize 'FILRODENSWMB.UI.GenerateHistoryHint'}}">
        <input type="checkbox" name="generator.output.history" class="fwmb-checkbox" {{#if generate.output.history}}checked{{/if}} />
        {{localize "FILRODENSWMB.UI.GenerateHistoryRuins"}}
    </label>
    {{/if}}

    <div class="fwmb-range-group-heading">{{localize "FILRODENSWMB.UI.GenerateNames"}}</div>
    <label class="fwmb-setting-row" data-tooltip="{{localize 'FILRODENSWMB.UI.GenerateLabelsHint'}}">
        <input type="checkbox" name="generator.output.labels" class="fwmb-checkbox" {{#if generate.output.labels}}checked{{/if}} />
        {{localize "FILRODENSWMB.UI.GenerateLabels"}}
    </label>

    <div class="fwmb-range-group-heading">{{localize "FILRODENSWMB.UI.GenerateStyles"}}</div>
    <label class="fwmb-setting-row" data-tooltip="{{localize 'FILRODENSWMB.UI.GenerateDefaultStylesHint'}}">
        <input type="checkbox" name="generator.output.defaultStyles" class="fwmb-checkbox" {{#if generate.output.defaultStyles}}checked{{/if}} />
        {{localize "FILRODENSWMB.UI.GenerateDefaultStyles"}}
    </label>
{{/"modules/filrodens-world-map-builder/templates/shell/parts/section.hbs"}}
{{/unless}}

{{#if generate.results}}
{{#> "modules/filrodens-world-map-builder/templates/shell/parts/section.hbs" id="generateResults" title="FILRODENSWMB.UI.SectionGenerateResults" badge="FILRODENSWMB.UI.BadgeLastRun" instant=true}}
    <dl class="fwmb-generate-results">
        {{#each generate.results.rows}}
        <dt>{{localize this.label}}</dt>
        <dd class="fwmb-readout">{{this.value}}</dd>
        {{/each}}
        <dt>{{localize "FILRODENSWMB.UI.GenerateResultPopulation"}}</dt>
        <dd class="fwmb-readout">{{generate.results.population}}</dd>
        {{#each generate.results.cultures}}
        <dt><span class="fwmb-chip-swatch" aria-hidden="true" {{#if this.color}}style="--swatch: {{this.color}}"{{/if}}></span> {{this.name}}</dt>
        <dd class="fwmb-readout">{{this.share}}</dd>
        {{/each}}
    </dl>
{{/"modules/filrodens-world-map-builder/templates/shell/parts/section.hbs"}}
{{/if}}

{{#if generate.canRemove}}
<div class="fwmb-generate-action">
    <button type="button" class="fwmb-btn fwmb-btn--danger-quiet fwmb-btn--wide" data-action="removeGenerated" data-tooltip="{{localize 'FILRODENSWMB.UI.RemoveGeneratedHint'}}">
        {{localize "FILRODENSWMB.UI.RemoveGenerated"}}
    </button>
</div>
{{/if}}
