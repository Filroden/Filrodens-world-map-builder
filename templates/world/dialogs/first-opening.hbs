{{!--
    A 4.3 map's first opening in v5 (board W8): what being a world means for it, once a world. See
    FirstOpening for the lines; the link opens the wiki's migration page in a new tab.
--}}
<div class="fwmb-dialog-content fwmb-first-opening-content">
    <p>{{intro}}</p>
    <ul class="fwmb-steps">
        {{#each items}}<li>{{this}}</li>{{/each}}
    </ul>
    <p><a class="fwmb-help-link" href="{{link}}" target="_blank" rel="noopener">{{linkLabel}}<i class="fwmb-icon fwmb-icon--open-in-new" aria-hidden="true"></i><span class="fwmb-visually-hidden">{{localize "FILRODENSWMB.UI.HelpNewTab"}}</span></a></p>
</div>
