{{!--
    The world overview (S0 step 4; board W1), the world's rail's first tool: the open world's
    maps, settlement maps and regional worlds as cards, in the map's place beside the world's rail
    and the inspector. A card is chosen as in Worlds: one click shows it in the inspector, a second
    goes to the map or opens the regional world. Parts a later track builds are drawn in their
    places, disabled: Add a map (Layers 1), the settlement maps (L-surface) and Cut regional
    world… (step 5). See WorldOverview.
--}}
<div class="fwmb-overview">
    <section class="fwmb-overview-main" aria-label="{{localize 'FILRODENSWMB.UI.WorldOverview'}}">
        <div class="fwmb-overview-group">
            <div class="fwmb-section-title">{{localize "FILRODENSWMB.UI.OverviewMaps"}} <span class="fwmb-badge fwmb-badge--count">{{overview.maps.length}}</span></div>
            <div class="fwmb-cards fwmb-overview-cards">
                {{#each overview.maps}}
                <button type="button" class="fwmb-card" data-action="selectMapCard" aria-current="{{#if this.selected}}true{{else}}false{{/if}}" aria-label="{{this.name}}">
                    <span class="fwmb-card-thumb">{{#if this.thumbnail}}<img src="{{this.thumbnail}}" alt="">{{else}}<span class="fwmb-card-thumb-icon"><span class="fwmb-icon fwmb-icon--landscape" aria-hidden="true"></span></span>{{/if}}</span>
                    <span class="fwmb-card-body">
                        <span class="fwmb-card-title"><span class="fwmb-icon fwmb-icon--landscape" aria-hidden="true"></span>{{this.name}}</span>
                        <span class="fwmb-card-meta fwmb-card-line">{{this.meta}}</span>
                        {{#if this.marks.length}}<span class="fwmb-card-meta">{{#each this.marks}}<span class="fwmb-state-mark fwmb-state-mark--{{this.kind}}"><span class="fwmb-icon fwmb-icon--{{this.icon}}" aria-hidden="true"></span>{{this.label}}</span>{{/each}}</span>{{/if}}
                    </span>
                </button>
                {{/each}}
                <button type="button" class="fwmb-card fwmb-card--add" aria-disabled="true" data-tooltip="{{localize 'FILRODENSWMB.UI.OverviewAddMapLater'}}"><span class="fwmb-icon fwmb-icon--add" aria-hidden="true"></span><span class="fwmb-card-title">{{localize "FILRODENSWMB.UI.AddMap"}}</span><span class="fwmb-card-meta">{{localize "FILRODENSWMB.UI.OverviewAddMapKinds"}}</span></button>
            </div>
        </div>

        <div class="fwmb-overview-group">
            <div class="fwmb-section-title">{{localize "FILRODENSWMB.UI.SettlementMaps"}}</div>
            <p class="fwmb-hint">{{localize "FILRODENSWMB.UI.OverviewSettlementsLater"}}</p>
        </div>

        <div class="fwmb-overview-group">
            <div class="fwmb-section-title">{{localize "FILRODENSWMB.UI.OverviewRegional"}} <span class="fwmb-badge fwmb-badge--count">{{overview.regional.length}}</span></div>
            <div class="fwmb-cards fwmb-overview-cards">
                {{#each overview.regional}}
                <button type="button" class="fwmb-card" data-action="selectWorld" data-world-id="{{this.id}}" aria-current="{{#if this.selected}}true{{else}}false{{/if}}" aria-label="{{this.name}}">
                    <span class="fwmb-card-thumb">{{#if this.thumbnail}}<img src="{{this.thumbnail}}" alt="">{{else}}<span class="fwmb-card-thumb-icon"><span class="fwmb-icon fwmb-icon--landscape" aria-hidden="true"></span></span>{{/if}}</span>
                    <span class="fwmb-card-body">
                        <span class="fwmb-card-title"><span class="fwmb-icon fwmb-icon--crop" aria-hidden="true"></span>{{this.name}}</span>
                        {{#if this.meta}}<span class="fwmb-card-meta fwmb-card-line">{{this.meta}}</span>{{/if}}
                        {{#if this.marks.length}}<span class="fwmb-card-meta">{{#each this.marks}}<span class="fwmb-state-mark fwmb-state-mark--{{this.kind}}"><span class="fwmb-icon fwmb-icon--{{this.icon}}" aria-hidden="true"></span>{{this.label}}</span>{{/each}}</span>{{/if}}
                    </span>
                </button>
                {{/each}}
                <button type="button" class="fwmb-card fwmb-card--add" aria-disabled="true" data-tooltip="{{localize 'FILRODENSWMB.UI.OverviewCutLater'}}"><span class="fwmb-icon fwmb-icon--crop" aria-hidden="true"></span><span class="fwmb-card-title">{{localize "FILRODENSWMB.UI.CutRegionalWorld"}}</span><span class="fwmb-card-meta">{{localize "FILRODENSWMB.UI.OverviewCutKinds"}}</span></button>
            </div>
        </div>
    </section>

</div>
