{{!--
    The world overview (S0 step 4; a page from step 4c-1, board C3), the world's rail's first tool:
    what is in the world (its maps and settlement maps, a solid group) apart from the regional
    worlds cut from it (separate worlds reading its settings while held, a dashed group), as cards,
    beside the world's rail and the inspector. A card is chosen as in Worlds: one click shows it in the inspector, a second
    goes to the map or opens the regional world. Cut regional world… opens the crop (S0 step 5),
    off with why when the Surface map cannot be cut from; a held regional world says what it was
    cut from, why it is Out of date, and offers Cut again…. Parts a later track builds are drawn in
    their places, disabled: Add a map (Layers 1). Its settlement maps are a table (L-surface, board
    L4). Bringing the world up to date (step 4b, board L4b): a notice at the head of the In group,
    only when something needs a run, listing what Generate all would run in its order (a box
    scrolling past five names) with Generate all…; Generate again on each of the world's own Out of
    date rows. See WorldOverview.
--}}
<div class="fwmb-overview">
    <section class="fwmb-world-group" aria-labelledby="fwmb-overview-in">
        <div class="fwmb-world-group-head"><span class="fwmb-icon fwmb-icon--public" aria-hidden="true"></span><div><b id="fwmb-overview-in">{{overview.inTitle}}</b><span class="fwmb-hint">{{localize "FILRODENSWMB.UI.OverviewInHint"}}</span></div></div>
        {{#if overview.update}}
        <div class="fwmb-notice fwmb-overview-update" role="status">
            <span class="fwmb-notice-title"><span class="fwmb-icon fwmb-icon--sync" aria-hidden="true"></span>{{overview.update.title}}</span>
            <ol class="fwmb-overview-update-list" aria-label="{{localize 'FILRODENSWMB.UI.OverviewUpdateList'}}">{{#each overview.update.maps}}<li><b>{{this.name}}</b> · {{this.line}}</li>{{/each}}</ol>
            <div class="fwmb-notice-actions"><button type="button" class="fwmb-btn fwmb-btn--primary" data-action="generateAll" data-tooltip="{{localize 'FILRODENSWMB.UI.GenerateAllHint'}}"><span class="fwmb-icon fwmb-icon--run" aria-hidden="true"></span>{{overview.update.label}}</button></div>
        </div>
        {{/if}}
        <div class="fwmb-overview-group">
            <div class="fwmb-section-title">{{localize "FILRODENSWMB.UI.OverviewMaps"}} <span class="fwmb-badge fwmb-badge--count">{{overview.maps.length}}</span></div>
            <div class="fwmb-cards fwmb-overview-cards">
                {{#each overview.maps}}
                <button type="button" class="fwmb-card" data-action="selectMapCard" aria-current="{{#if this.selected}}true{{else}}false{{/if}}" aria-label="{{this.name}}">
                    <span class="fwmb-card-thumb">{{#if this.thumbnail}}<img src="{{this.thumbnail}}" alt="">{{else}}<span class="fwmb-card-thumb-icon"><span class="fwmb-icon fwmb-icon--landscape" aria-hidden="true"></span></span>{{/if}}</span>
                    <span class="fwmb-card-body">
                        <span class="fwmb-card-title"><span class="fwmb-icon fwmb-icon--landscape" aria-hidden="true"></span>{{this.name}}</span>
                        <span class="fwmb-card-meta fwmb-card-line">{{this.meta}}</span>
                        {{#if this.marks.length}}<span class="fwmb-card-meta">{{#each this.marks}}<span class="fwmb-state-mark fwmb-state-mark--{{this.kind}}"{{#if this.tooltip}} data-tooltip="{{this.tooltip}}"{{/if}}><span class="fwmb-icon fwmb-icon--{{this.icon}}" aria-hidden="true"></span>{{this.label}}</span>{{/each}}</span>{{/if}}
                    </span>
                </button>
                {{else}}
                {{!-- A world with no maps yet (board N3): its Surface map is made from its Map setup --}}
                <button type="button" class="fwmb-card fwmb-card--add fwmb-card--make" data-action="goToMapTool" data-tool="scene"><span class="fwmb-icon fwmb-icon--landscape" aria-hidden="true"></span><span class="fwmb-card-title">{{localize "FILRODENSWMB.UI.MakeTheSurfaceMap"}}</span><span class="fwmb-card-meta">{{localize "FILRODENSWMB.UI.MakeTheSurfaceMapHint"}}</span></button>
                {{/each}}
                <button type="button" class="fwmb-card fwmb-card--add" aria-disabled="true" data-tooltip="{{localize 'FILRODENSWMB.UI.OverviewAddMapLater'}}"><span class="fwmb-icon fwmb-icon--add" aria-hidden="true"></span><span class="fwmb-card-title">{{localize "FILRODENSWMB.UI.AddMap"}}</span><span class="fwmb-card-meta">{{localize "FILRODENSWMB.UI.OverviewAddMapKinds"}}</span></button>
            </div>
        </div>

        {{#if overview.cutFrom}}
        <div class="fwmb-overview-group">
            <div class="fwmb-section-title">{{localize "FILRODENSWMB.UI.OverviewCutFromTitle"}}</div>
            {{#if overview.cutFrom.stale.length}}
            <div class="fwmb-notice fwmb-overview-cut" role="note">
                <span class="fwmb-notice-title"><span class="fwmb-icon fwmb-icon--sync" aria-hidden="true"></span>{{overview.cutFrom.line}}</span>
            {{else}}
            <div class="fwmb-held fwmb-overview-cut" role="note">
                <span class="fwmb-held-title"><span class="fwmb-icon fwmb-icon--crop" aria-hidden="true"></span>{{overview.cutFrom.line}}</span>
            {{/if}}
                {{#each overview.cutFrom.stale}}<span>{{this}}</span>{{/each}}
                {{#if overview.cutFrom.again}}
                <button type="button" class="fwmb-btn"{{#if overview.cutFrom.again.off}} aria-disabled="true" data-tooltip="{{overview.cutFrom.again.off}}"{{else}} data-action="cutAgain" data-world-id="{{overview.cutFrom.id}}" data-tooltip="{{overview.cutFrom.again.note}}"{{/if}}><span class="fwmb-icon fwmb-icon--crop" aria-hidden="true"></span>{{localize "FILRODENSWMB.UI.WorldCutAgain"}}</button>
                {{/if}}
            </div>
        </div>
        {{/if}}

        {{!-- Its settlement maps (L-surface; board L4): a searchable table scrolling past five rows,
             so the regional worlds below stay in view; each row's Open, and Delete… for the world's
             own (Ken, 2026-11-24: deleting one by one from each pin took too long); Generate again
             on the world's own Out of date rows (step 4b). Narrow, Generate again and the marks
             show their icon alone, their words kept for screen readers and in their tooltips
             (board L4b) --}}
        <div class="fwmb-overview-group fwmb-overview-settlements" data-settlement-list>
            <div class="fwmb-section-title">{{localize "FILRODENSWMB.UI.SettlementMaps"}} <span class="fwmb-badge fwmb-badge--count">{{overview.settlements.length}}</span>
                {{#if overview.settlements.length}}<input type="search" class="fwmb-settlement-search" data-settlement-search data-panel-ui placeholder="{{localize 'FILRODENSWMB.UI.Search'}}" aria-label="{{localize 'FILRODENSWMB.UI.SearchSettlementMaps'}}" />{{/if}}
            </div>
            {{#if overview.settlements.length}}
            <div class="fwmb-settlement-table-wrap">
                <table class="fwmb-settlement-table">
                    <thead><tr><th scope="col">{{localize "FILRODENSWMB.UI.SettlementColumn"}}</th><th scope="col">{{localize "FILRODENSWMB.UI.KindColumn"}}</th><th scope="col" class="fwmb-num">{{localize "FILRODENSWMB.UI.PeopleColumn"}}</th><th scope="col">{{localize "FILRODENSWMB.UI.MadeFromColumn"}}</th><th scope="col">{{localize "FILRODENSWMB.UI.StateColumn"}}</th><th scope="col"><span class="fwmb-visually-hidden">{{localize "FILRODENSWMB.UI.SettlementActionsColumn"}}</span></th></tr></thead>
                    <tbody>
                        {{#each overview.settlements}}
                        <tr data-settlement-row data-search="{{this.search}}">
                            <th scope="row">{{this.name}}</th>
                            <td>{{this.kind}}</td>
                            <td class="fwmb-num">{{this.people}}</td>
                            <td>{{this.from}}</td>
                            <td>{{#each this.marks}}<span class="fwmb-state-mark fwmb-state-mark--{{this.kind}}" data-tooltip="{{this.tooltip}}"><span class="fwmb-icon fwmb-icon--{{this.icon}}" aria-hidden="true"></span><span class="fwmb-compact-label">{{this.label}}</span></span>{{/each}}</td>
                            <td class="fwmb-end"><span class="fwmb-settlement-actions">{{#if this.again}}<button type="button" class="fwmb-btn fwmb-settlement-again" data-action="regenerateSettlementMap" data-settlement-id="{{this.id}}" aria-label="{{localize 'FILRODENSWMB.UI.GenerateAgainNamed' name=this.name}}" data-tooltip="{{localize 'FILRODENSWMB.UI.GenerateAgainNamed' name=this.name}}"><span class="fwmb-icon fwmb-icon--run" aria-hidden="true"></span><span class="fwmb-compact-label">{{localize "FILRODENSWMB.UI.GenerateAgain"}}</span></button> {{/if}}<button type="button" class="fwmb-btn fwmb-btn--go" data-action="openSettlementMap" data-settlement-id="{{this.id}}" aria-label="{{localize 'FILRODENSWMB.UI.OpenNamed' name=this.name}}">{{localize "FILRODENSWMB.UI.Open"}}</button>{{#if this.deletable}} <button type="button" class="fwmb-btn fwmb-btn--square fwmb-btn--danger-quiet" data-action="deleteSettlementMap" data-settlement-id="{{this.id}}" aria-label="{{localize 'FILRODENSWMB.UI.DeleteSettlementMapNamed' name=this.name}}" data-tooltip="{{localize 'FILRODENSWMB.UI.DeleteSettlementMapNamed' name=this.name}}"><i class="fwmb-icon fwmb-icon--delete" aria-hidden="true"></i></button>{{/if}}</span></td>
                        </tr>
                        {{/each}}
                    </tbody>
                </table>
            </div>
            <p class="fwmb-hint">{{localize "FILRODENSWMB.UI.OverviewSettlementsHint"}}</p>
            {{else if overview.settlementsHere}}
            <p class="fwmb-hint">{{localize "FILRODENSWMB.UI.OverviewSettlementsNone"}}</p>
            {{else}}
            <p class="fwmb-hint">{{localize "FILRODENSWMB.UI.OverviewSettlementsLater"}}</p>
            {{/if}}
        </div>

    </section>

    <section class="fwmb-world-group fwmb-world-group--related" aria-labelledby="fwmb-overview-related">
        <div class="fwmb-world-group-head"><span class="fwmb-icon fwmb-icon--crop" aria-hidden="true"></span><div><b id="fwmb-overview-related">{{overview.relatedTitle}}</b><span class="fwmb-hint">{{overview.relatedHint}}</span></div></div>
        <div class="fwmb-overview-group">
            <div class="fwmb-section-title">{{localize "FILRODENSWMB.UI.OverviewRegional"}} <span class="fwmb-badge fwmb-badge--count">{{overview.regional.length}}</span></div>
            <div class="fwmb-cards fwmb-overview-cards">
                {{#each overview.regional}}
                <button type="button" class="fwmb-card" data-action="selectWorld" data-world-id="{{this.id}}" aria-current="{{#if this.selected}}true{{else}}false{{/if}}" aria-label="{{this.name}}">
                    <span class="fwmb-card-thumb">{{#if this.thumbnail}}<img src="{{this.thumbnail}}" alt="">{{else}}<span class="fwmb-card-thumb-icon"><span class="fwmb-icon fwmb-icon--landscape" aria-hidden="true"></span></span>{{/if}}</span>
                    <span class="fwmb-card-body">
                        <span class="fwmb-card-title"><span class="fwmb-icon fwmb-icon--crop" aria-hidden="true"></span>{{this.name}}</span>
                        {{#if this.meta}}<span class="fwmb-card-meta fwmb-card-line">{{this.meta}}</span>{{/if}}
                        {{#if this.marks.length}}<span class="fwmb-card-meta">{{#each this.marks}}<span class="fwmb-state-mark fwmb-state-mark--{{this.kind}}"{{#if this.tooltip}} data-tooltip="{{this.tooltip}}"{{/if}}><span class="fwmb-icon fwmb-icon--{{this.icon}}" aria-hidden="true"></span>{{this.label}}</span>{{/each}}</span>{{/if}}
                        <span class="fwmb-card-meta fwmb-card-opens"><span class="fwmb-icon fwmb-icon--open-in-new" aria-hidden="true"></span>{{localize "FILRODENSWMB.UI.OverviewOpensOwn"}}</span>
                    </span>
                </button>
                {{/each}}
                <button type="button" class="fwmb-card fwmb-card--add"{{#if overview.cutOff}} aria-disabled="true" data-tooltip="{{overview.cutOff}}"{{else}} data-action="openWorldTool" data-tool="worldCut"{{/if}}><span class="fwmb-icon fwmb-icon--crop" aria-hidden="true"></span><span class="fwmb-card-title">{{localize "FILRODENSWMB.UI.CutRegionalWorld"}}</span><span class="fwmb-card-meta">{{localize "FILRODENSWMB.UI.OverviewCutKinds"}}</span></button>
            </div>
        </div>
    </section>

</div>
