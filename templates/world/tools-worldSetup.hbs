{{!--
    World setup (S0 step 4; a page from step 4c-1; the frame only from step 4c-2, boards C4, C9 and
    N2): the world's frame, which every map in it shares: its size (set while the world has no maps,
    fixed once a map is made), latitudes, area factor and unit, the last three changed in place,
    marking the runs out of date. The terrain engine and the seed are the Surface map's Map setup.
    While a world is being made (New world), its name too, with Cancel and Create world. On a held
    regional world all of it is its own, fixed by its crop, and read only.
--}}
{{> "modules/filrodens-world-map-builder/templates/world/parts/world-editor-head.hbs"}}
<fieldset class="fwmb-world-editor fwmb-page-form"{{#if worldEditor.locked}} disabled{{/if}}>
{{#> "modules/filrodens-world-map-builder/templates/shell/parts/section.hbs" id="worldScale" title="FILRODENSWMB.UI.WorldSetupFrame" badge=worldSetup.badge rebuilds=worldSetup.sizeFixed}}
    {{#if worldSetup.creating}}
    <div class="fwmb-form-group">
        <label for="fwmb-world-name">{{localize "FILRODENSWMB.UI.WorldName"}}</label>
        <div class="fwmb-form-fields">
            <input type="text" id="fwmb-world-name" name="newWorldName" value="{{worldSetup.name}}" maxlength="{{fwmbTextLimit 'name'}}" />
        </div>
    </div>
    {{/if}}
    {{#if worldSetup.sizeFixed}}
    <div class="fwmb-form-group">
        <span class="fwmb-label">{{localize "FILRODENSWMB.UI.MapSize"}}</span>
        <div class="fwmb-form-fields">
            <span class="fwmb-readout">{{numberFormat worldSetup.width decimals=0}} × {{numberFormat worldSetup.height decimals=0}} {{localize "FILRODENSWMB.UI.UnitPixelsShort"}}</span>
            <span class="fwmb-hint">{{localize "FILRODENSWMB.UI.WorldSizeFixed"}}</span>
        </div>
    </div>
    {{else}}
    {{!-- The frame's size while the world has no maps: the Surface map is made at it --}}
    <div class="fwmb-form-group">
        <label>{{localize "FILRODENSWMB.UI.MapSize"}}</label>
        <div class="fwmb-form-fields">
            <input type="number" name="mapWidth" value="{{worldSetup.width}}" min="500" max="4000" step="100" aria-label="{{localize 'FILRODENSWMB.UI.MapWidth'}}" />
            <span class="fwmb-times">×</span>
            <input type="number" name="mapHeight" value="{{worldSetup.height}}" min="500" max="4000" step="100" aria-label="{{localize 'FILRODENSWMB.UI.MapHeight'}}" />
            <span class="fwmb-unit"><span class="fwmb-unit-long">{{localize "FILRODENSWMB.UI.UnitPixels"}}</span><span class="fwmb-unit-short">{{localize "FILRODENSWMB.UI.UnitPixelsShort"}}</span></span>
        </div>
    </div>
    {{/if}}

    <div class="fwmb-form-group">
        <label>{{localize "FILRODENSWMB.UI.Latitude"}}</label>
        <div class="fwmb-form-fields">
            <input type="number" name="latTop" value="{{lookup uiState 'latTop'}}" min="-90" max="90" aria-label="{{localize 'FILRODENSWMB.UI.LatTop'}}" data-tooltip="{{localize 'FILRODENSWMB.UI.LatTop'}}" />
            <span class="fwmb-times">{{localize "FILRODENSWMB.UI.LatitudeTo"}}</span>
            <input type="number" name="latBottom" value="{{lookup uiState 'latBottom'}}" min="-90" max="90" aria-label="{{localize 'FILRODENSWMB.UI.LatBottom'}}" data-tooltip="{{localize 'FILRODENSWMB.UI.LatBottom'}}" />
            <i class="fwmb-icon fwmb-icon--info" data-tooltip="{{localize 'FILRODENSWMB.UI.LatitudeHint'}}"></i>
        </div>
    </div>

    <div class="fwmb-form-group">
        <label for="fwmb-area-factor">{{localize "FILRODENSWMB.UI.AreaFactor"}}</label>
        <div class="fwmb-form-fields">
            <input type="number" id="fwmb-area-factor" name="worldAreaFactor" value="{{worldAreaFactor}}" min="{{areaFactorRange.min}}" max="{{areaFactorRange.max}}" step="1" />
            <i class="fwmb-icon fwmb-icon--info" data-tooltip="{{localize 'FILRODENSWMB.UI.AreaFactorHint'}}"></i>
        </div>
    </div>

    {{!-- The map's unit: the name every distance shown is labelled with (see MapUnit). Its input is
         not named after the state key, so a save's read of the panel never parses it as a number --}}
    <div class="fwmb-form-group">
        <label for="fwmb-map-unit">{{localize "FILRODENSWMB.UI.MapUnit"}}</label>
        <div class="fwmb-form-fields">
            <input type="text" id="fwmb-map-unit" name="mapUnitName" value="{{mapUnit}}" maxlength="{{fwmbTextLimit 'name'}}" aria-describedby="fwmb-pixel-scale" />
            <i class="fwmb-icon fwmb-icon--info" data-tooltip="{{localize 'FILRODENSWMB.UI.MapUnitHint'}}"></i>
        </div>
    </div>
    {{!-- What one pixel measures, written in place as the latitudes, area factor or unit change --}}
    <p class="fwmb-hint" id="fwmb-pixel-scale" data-pixel-scale>{{pixelScale}}</p>

{{/"modules/filrodens-world-map-builder/templates/shell/parts/section.hbs"}}
{{#if worldSetup.creating}}
<div class="fwmb-page-bar">
    <button type="button" class="fwmb-btn" data-action="cancelNewWorld">{{localize "FILRODENSWMB.UI.Cancel"}}</button>
    <button type="button" class="fwmb-btn fwmb-btn--primary" data-action="createWorld"><span class="fwmb-icon fwmb-icon--add" aria-hidden="true"></span>{{localize "FILRODENSWMB.UI.CreateWorld"}}</button>
</div>
{{/if}}

</fieldset>
