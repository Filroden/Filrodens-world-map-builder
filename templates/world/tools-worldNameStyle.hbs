{{!--
    Default name style (S0 step 4): how places are named on land no culture holds, for every map's
    run (each culture names its own land in its own style). Read only on a held regional world.
--}}
{{> "modules/filrodens-world-map-builder/templates/world/parts/world-editor-head.hbs"}}
<fieldset class="fwmb-world-editor"{{#if worldEditor.held}} disabled{{/if}}>
{{#> "modules/filrodens-world-map-builder/templates/shell/parts/section.hbs" id="placeNames" title="FILRODENSWMB.UI.SectionPlaceNames"}}
<div class="fwmb-form-group">
    <label for="fwmb-generator-name-base">{{localize "FILRODENSWMB.UI.GenerateDefaultNameStyle"}}</label>
    <div class="fwmb-form-fields">
        <select id="fwmb-generator-name-base" name="generator.nameBase">
            {{#each generate.nameBases}}
            <option value="{{this.value}}" {{#if this.selected}}selected{{/if}}>{{this.label}}</option>
            {{/each}}
        </select>
        <i class="fwmb-icon fwmb-icon--info" data-tooltip="{{localize 'FILRODENSWMB.UI.GenerateDefaultNameStyleHint'}}"></i>
    </div>
</div>
{{/"modules/filrodens-world-map-builder/templates/shell/parts/section.hbs"}}
</fieldset>
