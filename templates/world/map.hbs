<div class="fwmb-map-container">

    {{!--
        The canvas and its four overlays, in the corners they had before v4 (the corners mirror in
        a right-to-left language):
        - top start: the information bar (values under the pointer, and the thematic layers' legends);
        - top end: undo and redo;
        - bottom start: the hint, one item per action, growing upward (filled by CanvasHints);
        - bottom end: the map controls (their menus open upward).
        They are always shown while the flat map is. The 3D view hides them all but the hint, which
        shows the 3D view's own gestures there. A fifth overlay is the reverse: the 3D view's
        settings (Relief Emphasis), shown only in the 3D view, in the top-start corner the
        information bar leaves free. This region is drawn once (the PIXI canvas lives in it), so
        their state is written in place afterwards: the readout by the pointer handler, the hint by
        #updateCanvasHint, the map controls by #syncMapControls, the 3D view's slider when the view
        opens (see _onThreeDView).
    --}}
    <div class="fwmb-map-preview">
        <!-- The PIXI canvas is drawn in here -->

        {{!-- The Surface map before it is made (board N4): a dashed frame in the world's aspect in the
             canvas's place, its size written by #showUnmade (shown while the studio has fwmb-is-unmade) --}}
        <div class="fwmb-unmade" aria-hidden="true">
            <div class="fwmb-unmade-frame">
                <span class="fwmb-icon fwmb-icon--landscape"></span>
                <b>{{localize "FILRODENSWMB.UI.UnmadeFrameTitle"}}</b>
                <span>{{localize "FILRODENSWMB.UI.UnmadeFrameHint"}}</span>
                <span class="fwmb-unmade-size" data-unmade-size></span>
            </div>
        </div>

        <div class="fwmb-map-overlay fwmb-canvas-readout" role="group" aria-label="{{localize 'FILRODENSWMB.UI.ReadoutLabel'}}">
            <div class="fwmb-values">
                <span><span class="fwmb-k">{{localize "FILRODENSWMB.UI.ReadoutElevation"}}</span><span id="fwmb-readout-elev">–</span></span>
                <span><span class="fwmb-k">{{localize "FILRODENSWMB.UI.ReadoutMoisture"}}</span><span id="fwmb-readout-mois">–</span></span>
                <span><span class="fwmb-k">{{localize "FILRODENSWMB.UI.ReadoutTemperature"}}</span><span id="fwmb-readout-temp">–</span></span>
                <span><span class="fwmb-k">{{localize "FILRODENSWMB.UI.ReadoutBiome"}}</span><span id="fwmb-readout-biome">–</span></span>
                {{!-- The shown thematic layer's value under the pointer, in the overlay accent (see ThematicView) --}}
                <span class="fwmb-hidden" data-thematic-readout><span class="fwmb-k" data-thematic-key></span><span class="fwmb-thematic" data-thematic-value>–</span></span>
                <span class="fwmb-hidden" data-thematic-trade-readout><span class="fwmb-k">{{localize "FILRODENSWMB.UI.ThematicTrade"}}</span><span class="fwmb-thematic" data-thematic-trade-value>–</span></span>
                <span class="fwmb-hidden" data-history-readout><span class="fwmb-k">{{localize "FILRODENSWMB.UI.HistoryReadoutRealm"}}</span><span class="fwmb-thematic" data-history-value>–</span></span>
                <span class="fwmb-hidden" data-travel-readout><span class="fwmb-k">{{localize "FILRODENSWMB.UI.TravelReadoutThere"}}</span><span class="fwmb-thematic" data-travel-value>–</span></span>
                <span class="fwmb-hidden" data-travel-back-readout><span class="fwmb-k">{{localize "FILRODENSWMB.UI.TravelReadoutBack"}}</span><span class="fwmb-thematic" data-travel-back-value>–</span></span>
            </div>
            {{!-- The thematic layers' legends go here --}}
            <div class="fwmb-legends"></div>
        </div>

        <div class="fwmb-map-overlay fwmb-map-hint" role="group" aria-label="{{localize 'FILRODENSWMB.UI.HintLabel'}}"></div>

        <div id="fwmb-3d-overlay" class="fwmb-3d-overlay fwmb-hidden"></div>

        {{!-- Not inside #fwmb-3d-overlay: Scene3D adds and removes its canvas there --}}
        <div class="fwmb-map-overlay fwmb-map-overlay-3d fwmb-3d-controls" role="group" aria-label="{{localize 'FILRODENSWMB.UI.ThreeDControlsLabel'}}">
            {{> "modules/filrodens-world-map-builder/templates/shell/parts/shared-range.hbs" name="reliefEmphasis" label="FILRODENSWMB.UI.ReliefEmphasis" hint="FILRODENSWMB.UI.ReliefEmphasisHint" value=(lookup uiState 'reliefEmphasis') min=0 max=30 step=1}}
        </div>

        {{!-- The 3D view's zoom, where the flat map's map controls are; Reset view returns to the
              starting angle, height and zoom --}}
        <div class="fwmb-map-overlay fwmb-map-overlay-3d fwmb-3d-zoom" role="toolbar" aria-label="{{localize 'FILRODENSWMB.UI.ThreeDZoomLabel'}}">
            <button type="button" class="fwmb-map-btn" data-action="threeDZoom" data-zoom="out" aria-label="{{localize 'FILRODENSWMB.UI.ZoomOut'}}" data-tooltip="{{localize 'FILRODENSWMB.UI.ZoomOut'}}"><span class="fwmb-icon fwmb-icon--zoom-out" aria-hidden="true"></span></button>
            <button type="button" class="fwmb-map-btn" data-action="threeDResetView" aria-label="{{localize 'FILRODENSWMB.UI.ThreeDResetView'}}" data-tooltip="{{localize 'FILRODENSWMB.UI.ThreeDResetView'}}"><span class="fwmb-icon fwmb-icon--center-focus" aria-hidden="true"></span></button>
            <button type="button" class="fwmb-map-btn" data-action="threeDZoom" data-zoom="in" aria-label="{{localize 'FILRODENSWMB.UI.ZoomIn'}}" data-tooltip="{{localize 'FILRODENSWMB.UI.ZoomIn'}}"><span class="fwmb-icon fwmb-icon--zoom-in" aria-hidden="true"></span></button>
        </div>

        {{!-- The map controls (S0 step 6b; the CanvasOverlays card, boards S1, B2 and B5): three
             labelled menus, alike, then zoom out, Reset view and zoom in. Visibility is who the map
             is shown for; Show what it draws (and an export includes), a row a part of the map,
             each opening a submenu of its parts; Thematic views what the last run left on it. Their
             state is written by MapControls.syncMapControls. The menus lose their labels when the
             row does not fit beside the hint (data-fold, StudioLayout), and on touch. --}}
        <div class="fwmb-map-overlay fwmb-map-controls" role="toolbar" aria-label="{{localize 'FILRODENSWMB.UI.MapControlsLabel'}}">
            <div class="fwmb-map-control-group">
                <div class="fwmb-layer-group" data-layer-group="visibility">
                    <button type="button" class="fwmb-map-menu" data-action="toggleLayerMenu" aria-haspopup="menu" aria-expanded="false" aria-label="{{localize 'FILRODENSWMB.UI.Visibility'}}" data-tooltip="{{localize 'FILRODENSWMB.UI.VisibilityHint'}}">
                        <span class="fwmb-icon fwmb-icon--visibility" aria-hidden="true"></span><span class="fwmb-map-menu-label">{{localize "FILRODENSWMB.UI.Visibility"}}</span>
                    </button>
                    <div class="fwmb-layer-menu fwmb-hidden" role="menu" aria-label="{{localize 'FILRODENSWMB.UI.Visibility'}}">
                        <button type="button" role="menuitemcheckbox" aria-checked="true" data-action="toggleViewFilter" data-filter="all">
                            <span class="fwmb-layer-check" aria-hidden="true"></span><span class="fwmb-icon fwmb-icon--visibility" aria-hidden="true"></span>{{localize "FILRODENSWMB.UI.VisibilityEveryone"}}
                        </button>
                        <button type="button" role="menuitemcheckbox" aria-checked="true" data-action="toggleViewFilter" data-filter="gm">
                            <span class="fwmb-layer-check" aria-hidden="true"></span><span class="fwmb-icon fwmb-icon--security" aria-hidden="true"></span>{{localize "FILRODENSWMB.UI.VisibilityGMOnly"}}
                        </button>
                        <button type="button" role="menuitemcheckbox" aria-checked="false" data-action="toggleViewFilter" data-filter="none">
                            <span class="fwmb-layer-check" aria-hidden="true"></span><span class="fwmb-icon fwmb-icon--visibility-off" aria-hidden="true"></span>{{localize "FILRODENSWMB.UI.VisibilityNone"}}
                        </button>
                    </div>
                </div>

                {{!-- Show: Terrain and Biomes (their layers, MapStudio.#TERRAIN_LAYER_GROUPS), Places
                     and routes, Regions and Labels (their tiers and styles, ContentRows),
                     Cartography, Map aids (contours, grid, reference image), then Detail, how much
                     is shown. Show the surface (Layers 1) is drawn, disabled, under its heading. A
                     row with parts opens its submenu (fwmb-layer-submenu) beside the menu. --}}
                <div class="fwmb-layer-group" data-layer-group="show">
                    <button type="button" class="fwmb-map-menu" data-action="toggleLayerMenu" aria-haspopup="menu" aria-expanded="false" aria-label="{{localize 'FILRODENSWMB.UI.ShowMenu'}}" data-tooltip="{{localize 'FILRODENSWMB.UI.ShowMenuHint'}}">
                        <span class="fwmb-icon fwmb-icon--layers" aria-hidden="true"></span><span class="fwmb-map-menu-label">{{localize "FILRODENSWMB.UI.ShowMenu"}}</span>
                    </button>
                    <div class="fwmb-layer-menu fwmb-hidden" role="menu" aria-label="{{localize 'FILRODENSWMB.UI.ShowMenu'}}">
                        {{#each layerGroups}}
                        <button type="button" class="fwmb-show-row" role="menuitem" aria-haspopup="menu" aria-expanded="false" data-action="openShowPart" data-show-part="{{this.id}}" data-state="on">
                            <span class="fwmb-layer-check" aria-hidden="true"></span><span class="fwmb-show-name">{{localize this.tooltip}}</span><span class="fwmb-show-chevron" aria-hidden="true"></span>
                        </button>
                        {{/each}}
                        {{#each viewLayers}}
                        {{#if this.rows}}
                        <button type="button" class="fwmb-show-row" role="menuitem" aria-haspopup="menu" aria-expanded="false" data-action="openShowPart" data-show-part="{{this.id}}" data-state="on">
                            <span class="fwmb-layer-check" aria-hidden="true"></span><span class="fwmb-show-name">{{localize this.label}}</span><span class="fwmb-show-chevron" aria-hidden="true"></span>
                        </button>
                        {{else}}
                        <button type="button" role="menuitemcheckbox" aria-checked="false" data-action="toggleLayer" data-layer="{{this.id}}">
                            <span class="fwmb-layer-check" aria-hidden="true"></span>{{localize this.label}}
                        </button>
                        {{/if}}
                        {{/each}}
                        <button type="button" class="fwmb-show-row" role="menuitem" aria-haspopup="menu" aria-expanded="false" data-action="openShowPart" data-show-part="aids" data-state="on">
                            <span class="fwmb-layer-check" aria-hidden="true"></span><span class="fwmb-show-name">{{localize "FILRODENSWMB.UI.ShowMapAids"}}</span><span class="fwmb-show-chevron" aria-hidden="true"></span>
                        </button>
                        <div class="fwmb-layer-menu-sep" role="separator"></div>
                        <button type="button" class="fwmb-show-row fwmb-show-row--choice" role="menuitem" aria-haspopup="menu" aria-expanded="false" data-action="openShowPart" data-show-part="detail">
                            <span class="fwmb-show-name">{{localize "FILRODENSWMB.UI.DetailMenu"}}</span><span class="fwmb-show-end" data-detail-name></span><span class="fwmb-show-chevron" aria-hidden="true"></span>
                        </button>
                        <div class="fwmb-layer-menu-sep" role="separator"></div>
                        <div class="fwmb-layer-menu-label" role="presentation">{{localize "FILRODENSWMB.UI.ShowOtherMaps"}}</div>
                        <button type="button" role="menuitemcheckbox" aria-checked="false" aria-disabled="true" data-tooltip="{{localize 'FILRODENSWMB.UI.NotBuiltYet' name=(localize 'FILRODENSWMB.UI.ShowTheSurface')}}">
                            <span class="fwmb-layer-check" aria-hidden="true"></span>{{localize "FILRODENSWMB.UI.ShowTheSurface"}}
                        </button>
                    </div>

                    {{!-- The submenus, one a row with parts; opened beside the menu, one at a time --}}
                    {{#each layerGroups}}
                    <div class="fwmb-layer-menu fwmb-layer-submenu fwmb-hidden" role="menu" aria-label="{{localize this.tooltip}}" data-show-panel="{{this.id}}">
                        <button type="button" class="fwmb-submenu-back" role="menuitem" data-action="closeShowPart"><span class="fwmb-show-chevron fwmb-show-chevron--back" aria-hidden="true"></span>{{localize "FILRODENSWMB.UI.ShowMenu"}}</button>
                        <button type="button" class="fwmb-layer-menu-all" role="menuitemcheckbox" aria-checked="false" data-action="toggleTerrainLayer" data-layer-group="{{this.id}}" data-terrain-layer="all">
                            <span class="fwmb-layer-check" aria-hidden="true"></span>{{localize "FILRODENSWMB.UI.LayerAll"}}
                        </button>
                        {{#each this.items}}
                        <button type="button" role="menuitemcheckbox" aria-checked="false" data-action="toggleTerrainLayer" data-layer-group="{{../id}}" data-terrain-layer="{{this.key}}">
                            <span class="fwmb-layer-check" aria-hidden="true"></span>{{localize this.label}}
                        </button>
                        {{/each}}
                    </div>
                    {{/each}}
                    {{#each viewLayers}}
                    {{#if this.rows}}
                    <div class="fwmb-layer-menu fwmb-layer-submenu fwmb-hidden" role="menu" aria-label="{{localize this.label}}" data-show-panel="{{this.id}}">
                        <button type="button" class="fwmb-submenu-back" role="menuitem" data-action="closeShowPart"><span class="fwmb-show-chevron fwmb-show-chevron--back" aria-hidden="true"></span>{{localize "FILRODENSWMB.UI.ShowMenu"}}</button>
                        <button type="button" class="fwmb-layer-menu-all" role="menuitemcheckbox" aria-checked="false" data-action="toggleContentRow" data-content-group="{{this.id}}" data-content-kind="all">
                            <span class="fwmb-layer-check" aria-hidden="true"></span>{{localize "FILRODENSWMB.UI.LayerAll"}}
                        </button>
                        <div class="fwmb-content-rows" role="none" data-content-rows="{{this.id}}"></div>
                    </div>
                    {{/if}}
                    {{/each}}
                    <div class="fwmb-layer-menu fwmb-layer-submenu fwmb-hidden" role="menu" aria-label="{{localize 'FILRODENSWMB.UI.ShowMapAids'}}" data-show-panel="aids">
                        <button type="button" class="fwmb-submenu-back" role="menuitem" data-action="closeShowPart"><span class="fwmb-show-chevron fwmb-show-chevron--back" aria-hidden="true"></span>{{localize "FILRODENSWMB.UI.ShowMenu"}}</button>
                        {{#each overlayLayers}}
                        <button type="button" role="menuitemcheckbox" aria-checked="false" data-action="{{this.action}}" {{#if this.id}}data-layer="{{this.id}}"{{/if}}>
                            <span class="fwmb-layer-check" aria-hidden="true"></span>{{localize this.label}}
                        </button>
                        {{/each}}
                    </div>
                    {{!-- Detail: how much of the generated content is shown (DetailLevel), one choice;
                         whether names avoid each other (LabelLayout); the symbol size (SymbolScale) --}}
                    <div class="fwmb-layer-menu fwmb-layer-submenu fwmb-hidden" role="menu" aria-label="{{localize 'FILRODENSWMB.UI.DetailMenu'}}" data-show-panel="detail">
                        <button type="button" class="fwmb-submenu-back" role="menuitem" data-action="closeShowPart"><span class="fwmb-show-chevron fwmb-show-chevron--back" aria-hidden="true"></span>{{localize "FILRODENSWMB.UI.ShowMenu"}}</button>
                        {{#each detailLevels}}
                        <button type="button" role="menuitemradio" aria-checked="false" data-action="setDetailLevel" data-detail-level="{{this.value}}">
                            <span class="fwmb-layer-check" aria-hidden="true"></span>{{localize this.label}}
                        </button>
                        {{/each}}
                        <div class="fwmb-layer-menu-sep" role="separator"></div>
                        <button type="button" role="menuitemcheckbox" aria-checked="true" data-action="toggleLabelOverlaps">
                            <span class="fwmb-layer-check" aria-hidden="true"></span>{{localize "FILRODENSWMB.UI.DetailAvoidOverlaps"}}
                        </button>
                        <div class="fwmb-layer-menu-sep" role="separator"></div>
                        {{!-- Symbol size (see SymbolScale): Auto, named with its value by MapControls, or a size --}}
                        <div class="fwmb-layer-menu-label" role="presentation">{{localize "FILRODENSWMB.UI.SymbolSize"}}</div>
                        <button type="button" role="menuitemradio" aria-checked="false" data-action="setSymbolSize" data-symbol-size="auto" data-tooltip="{{localize 'FILRODENSWMB.UI.SymbolSizeAutoHint'}}">
                            <span class="fwmb-layer-check" aria-hidden="true"></span><span data-symbol-auto>{{localize "FILRODENSWMB.UI.SymbolSizeAuto"}}</span>
                        </button>
                        {{#each symbolSizes}}
                        <button type="button" role="menuitemradio" aria-checked="false" data-action="setSymbolSize" data-symbol-size="{{this.value}}">
                            <span class="fwmb-layer-check" aria-hidden="true"></span>{{localize "FILRODENSWMB.UI.SymbolSizePercent" percent=this.percent}}
                        </button>
                        {{/each}}
                    </div>
                </div>

                {{!-- Thematic views (ThematicView): what the generator's last run left on the map,
                     one colour view at a time and the line views; the view shown names the button --}}
                <div class="fwmb-layer-group" data-layer-group="thematic">
                    <button type="button" class="fwmb-map-menu" data-action="toggleLayerMenu" aria-haspopup="menu" aria-expanded="false" aria-label="{{localize 'FILRODENSWMB.UI.ThematicLayers'}}" data-tooltip="{{localize 'FILRODENSWMB.UI.ThematicLayers'}}">
                        <span class="fwmb-icon fwmb-icon--gradient" aria-hidden="true"></span><span class="fwmb-map-menu-label">{{localize "FILRODENSWMB.UI.ThematicLayers"}}</span><span class="fwmb-count fwmb-hidden" data-thematic-count></span>
                    </button>
                    <div class="fwmb-layer-menu fwmb-hidden" role="menu" aria-label="{{localize 'FILRODENSWMB.UI.ThematicLayers'}}">
                        {{> "modules/filrodens-world-map-builder/templates/world/parts/thematic-menu.hbs" thematic=thematic}}
                    </div>
                </div>
            </div>

            <div class="fwmb-map-control-group">
                <button type="button" class="fwmb-map-btn" data-action="zoomOut" aria-label="{{localize 'FILRODENSWMB.UI.ZoomOut'}}" data-tooltip="{{localize 'FILRODENSWMB.UI.ZoomOut'}}">
                    <span class="fwmb-icon fwmb-icon--zoom-out" aria-hidden="true"></span>
                </button>
                <button type="button" class="fwmb-map-btn" data-action="resetZoom" aria-label="{{localize 'FILRODENSWMB.UI.ResetView'}}" data-tooltip="{{localize 'FILRODENSWMB.UI.ResetView'}}">
                    <span class="fwmb-icon fwmb-icon--center-focus" aria-hidden="true"></span>
                </button>
                <button type="button" class="fwmb-map-btn" data-action="zoomIn" aria-label="{{localize 'FILRODENSWMB.UI.ZoomIn'}}" data-tooltip="{{localize 'FILRODENSWMB.UI.ZoomIn'}}">
                    <span class="fwmb-icon fwmb-icon--zoom-in" aria-hidden="true"></span>
                </button>
            </div>
        </div>

        <div class="fwmb-map-overlay fwmb-map-history" role="group" aria-label="{{localize 'FILRODENSWMB.UI.HistoryLabel'}}">
            <button type="button" class="fwmb-map-btn" data-action="undoBrush" aria-label="{{localize 'FILRODENSWMB.UI.Undo'}}" data-tooltip="{{localize 'FILRODENSWMB.UI.Undo'}}">
                <span class="fwmb-icon fwmb-icon--undo" aria-hidden="true"></span>
            </button>
            <button type="button" class="fwmb-map-btn" data-action="redoBrush" aria-label="{{localize 'FILRODENSWMB.UI.Redo'}}" data-tooltip="{{localize 'FILRODENSWMB.UI.Redo'}}">
                <span class="fwmb-icon fwmb-icon--redo" aria-hidden="true"></span>
            </button>
        </div>
    </div>

    <!-- The processing overlay: shown over the map while long work runs -->
    <div class="fwmb-processing-overlay fwmb-hidden">
        <div class="fwmb-processing" role="status">
            <div class="fwmb-processing-title">
                <span class="fwmb-icon fwmb-icon--sync fwmb-spin" aria-hidden="true"></span>
                <b class="fwmb-processing-text"></b>
            </div>
            <!-- Shown only while work reports how far it has come (see MapStudio.runCancellable) -->
            <div class="fwmb-progress fwmb-hidden" role="progressbar" aria-valuemin="0" aria-valuemax="100"></div>
            <p class="fwmb-processing-detail fwmb-hidden"></p>
            <!-- Shown only while work that can stop part-way is running (see MapStudio.runCancellable) -->
            <div class="fwmb-processing-actions fwmb-processing-cancel fwmb-hidden">
                <button type="button" class="fwmb-btn fwmb-hidden" data-action="keepProcessing"></button>
                <button type="button" class="fwmb-btn" data-tone="negative" data-action="cancelProcessing">{{localize "FILRODENSWMB.UI.Cancel"}}</button>
            </div>
        </div>
    </div>
</div>
