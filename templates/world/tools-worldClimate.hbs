{{!--
    Climate base (S0 step 4; a page from step 4c-1, until step 4c-2 makes it the Surface map's
    Climate tool): the world's temperature, seasons, altitude cooling, freezing and
    moisture, for the Surface map (and the Aerial map, with Layers 4; never underground). Each
    change makes the climate again. Read only on a held regional world.
--}}
{{> "modules/filrodens-world-map-builder/templates/world/parts/world-editor-head.hbs"}}
<fieldset class="fwmb-world-editor fwmb-page-form"{{#if worldEditor.held}} disabled{{/if}}>
{{#> "modules/filrodens-world-map-builder/templates/shell/parts/section.hbs" id="climate" title="FILRODENSWMB.UI.SettingsClimate" badge="FILRODENSWMB.UI.BadgeRebuildsClimate" rebuilds=true}}
    {{> "modules/filrodens-world-map-builder/templates/shell/parts/shared-range.hbs" name="globalTemp" label="FILRODENSWMB.UI.GlobalTemp" value=(lookup uiState 'globalTemp') min=0 max=1 step=0.01}}
    {{> "modules/filrodens-world-map-builder/templates/shell/parts/shared-range.hbs" name="seasonOffset" label="FILRODENSWMB.UI.SeasonOffset" value=(lookup uiState 'seasonOffset') min=-1 max=1 step=0.05}}
    {{> "modules/filrodens-world-map-builder/templates/shell/parts/shared-range.hbs" name="altCooling" label="FILRODENSWMB.UI.AltitudeCooling" value=(lookup uiState 'altCooling') min=0 max=1 step=0.05}}
    {{> "modules/filrodens-world-map-builder/templates/shell/parts/shared-range.hbs" name="freezingThreshold" label="FILRODENSWMB.UI.FreezingThreshold" value=(lookup uiState 'freezingThreshold') min=0 max=1 step=0.05}}
{{/"modules/filrodens-world-map-builder/templates/shell/parts/section.hbs"}}

{{#> "modules/filrodens-world-map-builder/templates/shell/parts/section.hbs" id="moisture" title="FILRODENSWMB.UI.SectionMoisture" badge="FILRODENSWMB.UI.BadgeRebuildsClimate" rebuilds=true}}
    {{> "modules/filrodens-world-map-builder/templates/shell/parts/shared-range.hbs" name="globalMoisture" label="FILRODENSWMB.UI.GlobalMoisture" value=(lookup uiState 'globalMoisture') min=0 max=1 step=0.01}}
    {{> "modules/filrodens-world-map-builder/templates/shell/parts/shared-range.hbs" name="noise.moisture.scale" label="FILRODENSWMB.UI.MoistureScale" value=(lookup uiState 'noise.moisture.scale') min=100 max=8000 step=10 display=(numberFormat (lookup uiState "noise.moisture.scale") decimals=0)}}
{{/"modules/filrodens-world-map-builder/templates/shell/parts/section.hbs"}}
</fieldset>
