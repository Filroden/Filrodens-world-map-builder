    map, from the Terrain section's engine and seed, in the world's frame.
--}}
<div class="fwmb-make-foot">
    <button type="button" class="fwmb-btn fwmb-btn--primary" data-action="makeSurfaceMap"{{#if terrainChoice.held}} aria-disabled="true"{{/if}}><span class="fwmb-icon fwmb-icon--landscape" aria-hidden="true"></span>{{localize "FILRODENSWMB.UI.MakeSurfaceMap"}}</button>
</div>
