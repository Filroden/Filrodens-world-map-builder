{{!--
    Biomes: the climate and moisture the biomes are worked out from (which rebuild climate and
    biomes, so they pause while painting), the biomes' colours and the custom biomes with their
    rules, how strongly the biome layer is drawn, and the legend. The paint brush is on the bar.
--}}
<div class="fwmb-goto">
    <p>{{localize "FILRODENSWMB.UI.BiomesWorldGo"}} <b>{{localize "FILRODENSWMB.UI.WorldMenuBiomesPath"}}</b></p>
    <div class="fwmb-goto-row"><button type="button" class="fwmb-btn fwmb-btn--go" data-action="openWorldTool" data-tool="worldBiomes">{{localize "FILRODENSWMB.UI.Go"}}</button></div>
</div>
<div class="fwmb-goto">
    <p>{{localize "FILRODENSWMB.UI.BiomesClimateGo"}} <b>{{localize "FILRODENSWMB.UI.ToolClimate"}}</b></p>
    <div class="fwmb-goto-row"><button type="button" class="fwmb-btn fwmb-btn--go" data-action="changeTool" data-tool="climate">{{localize "FILRODENSWMB.UI.Go"}}</button></div>
</div>



{{!-- The rule coverage preview shows on the map, so it lives here rather than on the world's
     Biomes page (S0 step 4c-1): hover it to light every area using a default biome --}}
<div class="fwmb-btn-row">
    <button type="button" class="fwmb-btn" id="fwmb-preview-fallback-btn" data-tooltip="{{localize 'FILRODENSWMB.UI.PreviewFallbackCoverageHint'}}">
        <i class="fwmb-icon fwmb-icon--visibility" aria-hidden="true"></i>{{localize "FILRODENSWMB.UI.PreviewFallbackCoverage"}}
    </button>
</div>

{{#> "modules/filrodens-world-map-builder/templates/shell/parts/section.hbs" id="biomeDisplay" title="FILRODENSWMB.UI.SectionDisplay" badge="FILRODENSWMB.UI.BadgeInstant" instant=true closed=true}}
    {{> "modules/filrodens-world-map-builder/templates/shell/parts/shared-range.hbs" name="biomeAlphaActive" label="FILRODENSWMB.UI.ActiveBiomeOpacity" value=(lookup uiState 'biomeAlphaActive') min=0 max=1 step=0.05}}
    {{> "modules/filrodens-world-map-builder/templates/shell/parts/shared-range.hbs" name="biomeAlphaInactive" label="FILRODENSWMB.UI.InactiveBiomeOpacity" value=(lookup uiState 'biomeAlphaInactive') min=0 max=1 step=0.05}}
{{/"modules/filrodens-world-map-builder/templates/shell/parts/section.hbs"}}

{{#> "modules/filrodens-world-map-builder/templates/shell/parts/section.hbs" id="biomeLegend" title="FILRODENSWMB.UI.BiomeLegend" closed=true}}
    <div class="fwmb-biome-legend">
        {{#each biomeList}}
            <div class="fwmb-biome-item">
                <div class="fwmb-swatch" style="background-color: {{this.hex}};"></div>
                <span>{{#if this.isCustom}}{{this.label}}{{else}}{{localize this.label}}{{/if}}</span>
            </div>
        {{/each}}
    </div>
{{/"modules/filrodens-world-map-builder/templates/shell/parts/section.hbs"}}
