{{!--
    Styles and icons (tool id "library"): the map's styles for pins, routes, regions and labels
    (see StyleLists), each row with a preview and how many objects use it, opened in the inspector
    by a click or Enter, with Rename, Duplicate and Delete in its menu, and each list ending in its
    add row; the pin icons on offer; and the file that shares the map's custom biomes and styles
    with another map. The biome colours are in the Biomes tool.
--}}
{{#> "modules/filrodens-world-map-builder/templates/parts/section.hbs" id="shareStyles" title="FILRODENSWMB.UI.SectionShareStyles"}}
    <div class="fwmb-btn-row">
        <button type="button" class="fwmb-btn" data-action="exportSettings" data-tooltip="{{localize 'FILRODENSWMB.UI.ExportSettingsHint'}}">
            <i class="fwmb-icon fwmb-icon--file-export"></i>
            {{localize "FILRODENSWMB.UI.ExportSettings"}}
        </button>
        <button type="button" class="fwmb-btn" data-action="importSettings" data-tooltip="{{localize 'FILRODENSWMB.UI.ImportSettingsHint'}}">
            <i class="fwmb-icon fwmb-icon--upload-file"></i>
            {{localize "FILRODENSWMB.UI.ImportSettings"}}
        </button>
    </div>
{{/"modules/filrodens-world-map-builder/templates/parts/section.hbs"}}

{{#each styleLists}}
{{#> "modules/filrodens-world-map-builder/templates/parts/section.hbs" id=this.section title=this.title count=this.count}}
    <div role="listbox" aria-label="{{localize this.title}}" data-list-nav data-style-list="{{this.type}}" class="fwmb-list-container fwmb-scrollable fwmb-scrollable--stable fwmb-space-before">
        {{#each this.rows}}
            {{#if this.naming}}
            <div class="fwmb-list-item fwmb-list-item--naming" role="option" aria-selected="true">
                <input type="text" class="fwmb-input" value="{{this.value}}" aria-label="{{localize this.label}}" data-style-naming data-panel-ui autocomplete="off" spellcheck="false" />
            </div>
            {{else}}
            <div role="option" aria-selected="{{#if this.selected}}true{{else}}false{{/if}}" tabindex="-1" data-list-item class="fwmb-list-item" data-id="{{this.id}}" data-style-type="{{../type}}" data-action="openStyle">
                {{> styleRowPreview this.preview}}
                <span class="fwmb-name fwmb-flex-1" title="{{this.name}}">{{this.name}}</span>
                <span class="fwmb-meta fwmb-row-count" data-tooltip="{{localize 'FILRODENSWMB.UI.QuickStyleUsageTooltip' count=this.usageCount}}">{{this.usageCount}}</span>
                <span class="fwmb-actions">
                    <div class="fwmb-dropdown fwmb-row-menu">
                        <button type="button" class="fwmb-btn fwmb-btn--subtle fwmb-btn--square" aria-label="{{localize 'FILRODENSWMB.UI.MoreOptions'}}" data-tooltip="{{localize 'FILRODENSWMB.UI.MoreOptions'}}">
                            <i class="fwmb-icon fwmb-icon--more-vert"></i>
                        </button>
                        <div class="fwmb-dropdown-menu">
                            <button type="button" data-action="renameStyle"><i class="fwmb-icon fwmb-icon--edit"></i> {{localize "FILRODENSWMB.UI.Rename"}}</button>
                            <button type="button" data-action="duplicateStyle"><i class="fwmb-icon fwmb-icon--content-copy"></i> {{localize "FILRODENSWMB.UI.Duplicate"}}</button>
                            <button type="button" data-action="deleteStyle" class="fwmb-danger"><i class="fwmb-icon fwmb-icon--delete"></i> {{localize "FILRODENSWMB.UI.Delete"}}</button>
                        </div>
                    </div>
                </span>
            </div>
            {{/if}}
        {{/each}}
        {{#if this.empty}}<div class="fwmb-list-empty" role="none">{{localize "FILRODENSWMB.UI.NoCustomStyles"}}</div>{{/if}}
        <div class="fwmb-list-add" role="none">
            <button type="button" class="fwmb-btn fwmb-btn--subtle" role="option" aria-selected="false" tabindex="-1" data-list-item data-action="addStyle" data-style-type="{{this.type}}">
                <i class="fwmb-icon fwmb-icon--add" aria-hidden="true"></i>{{localize this.add}}
            </button>
        </div>
    </div>
{{/"modules/filrodens-world-map-builder/templates/parts/section.hbs"}}
{{/each}}

{{#> "modules/filrodens-world-map-builder/templates/parts/section.hbs" id="builtinPinIcons" title="FILRODENSWMB.UI.SettingsBuiltinPinIcons" closed=true}}
    <div class="fwmb-hint fwmb-long">{{localize "FILRODENSWMB.UI.BuiltinPinIconsHint"}}</div>

    <div class="fwmb-bulk-actions">
        <a class="fwmb-bulk-action-button" data-action="hideAllBuiltinPinIcons">{{localize "FILRODENSWMB.UI.HideAllPinIcons"}}</a>
        <a class="fwmb-bulk-action-button" data-action="revealAllBuiltinPinIcons">{{localize "FILRODENSWMB.UI.RevealAllPinIcons"}}</a>
    </div>

    <div class="fwmb-list-container fwmb-scrollable fwmb-scrollable--stable fwmb-space-before">
        {{#each builtinPinIcons}}
            <div class="fwmb-list-item">
                <i class="fwmb-icon fwmb-list-icon fwmb-icon--{{this.key}}"></i>
                <span class="fwmb-name fwmb-flex-1" title="{{this.label}}">{{this.label}}</span>
                {{#if this.isProtected}}
                    <input type="checkbox" class="fwmb-checkbox" disabled aria-label="{{localize 'FILRODENSWMB.UI.PinIconProtected'}}" data-tooltip="{{localize 'FILRODENSWMB.UI.PinIconProtected'}}" />
                {{else}}
                    <input
                        type="checkbox"
                        class="fwmb-checkbox"
                        data-action="toggleBuiltinPinIcon"
                        data-key="{{this.key}}"
                        data-panel-ui
                        {{#if this.isDisabled}}checked{{/if}}
                        aria-label="{{localize 'FILRODENSWMB.UI.DisablePinIcon'}}"
                        data-tooltip="{{localize 'FILRODENSWMB.UI.DisablePinIcon'}}"
                    />
                {{/if}}
            </div>
        {{/each}}
    </div>
{{/"modules/filrodens-world-map-builder/templates/parts/section.hbs"}}

{{#> "modules/filrodens-world-map-builder/templates/parts/section.hbs" id="customPinIcons" title="FILRODENSWMB.UI.SettingsCustomPinIcons" count=customPinIcons.length addAction="addCustomPinIcon" addLabel="FILRODENSWMB.UI.AddCustomPinIcon"}}
    <div role="listbox" aria-label="{{localize 'FILRODENSWMB.UI.SettingsCustomPinIcons'}}" data-list-nav class="fwmb-list-container fwmb-scrollable fwmb-scrollable--stable fwmb-space-before">
        {{#each customPinIcons}}
            <div role="option" aria-selected="false" tabindex="-1" data-list-item class="fwmb-list-item" data-id="{{this.id}}" data-action="editCustomPinIcon">
                <i class="fwmb-icon fwmb-list-icon" style="--fwmb-mask: url('{{this.path}}');"></i>
                <span class="fwmb-name fwmb-flex-1" title="{{this.name}}">{{this.name}}</span>
                <span class="fwmb-actions">
                    <button type="button" class="fwmb-btn fwmb-btn--square fwmb-btn--danger-quiet" data-action="removeCustomPinIcon" aria-label="{{localize 'FILRODENSWMB.UI.RemovePinIcon'}}" data-tooltip="{{localize 'FILRODENSWMB.UI.RemovePinIcon'}}">
                        <i class="fwmb-icon fwmb-icon--variable-remove"></i>
                    </button>
                </span>
            </div>
        {{else}}
            <div class="fwmb-list-empty" role="none">{{localize "FILRODENSWMB.UI.NoCustomPinIcons"}}</div>
        {{/each}}
    </div>
{{/"modules/filrodens-world-map-builder/templates/parts/section.hbs"}}

{{#*inline "styleRowPreview"}}
{{#if line}}<span class="fwmb-style-preview fwmb-style-preview--line" aria-hidden="true" style="--line-color: {{color}}; --line-width: calc({{thickness}} * 0.0625rem); --line-style: {{stroke}};"></span>{{/if}}
{{#if fill}}<span class="fwmb-chip-swatch{{#unless color}} fwmb-chip-swatch--none{{/unless}}" aria-hidden="true" {{#if color}}style="--swatch: {{color}}"{{/if}}></span>{{/if}}
{{#if text}}<span class="fwmb-style-preview fwmb-style-preview--text" aria-hidden="true" style="font-family: &quot;{{family}}&quot;; color: {{color}}; font-weight: {{weight}}; font-style: {{slant}};">Aa</span>{{/if}}
{{#if icon}}<i class="fwmb-icon fwmb-pin-style-glyph {{#unless isCustom}}fwmb-icon--{{key}}{{/unless}}" aria-hidden="true" {{#if isCustom}}style="--fwmb-mask: url('{{path}}');"{{/if}}></i>{{/if}}
{{/inline}}
