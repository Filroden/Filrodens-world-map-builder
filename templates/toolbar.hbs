{{!--
    The rail: the tools grouped by the stage of making a map they belong to (Shape, Populate,
    Finish), then the occasional tools, then the file actions at its foot. Every button is
    icon-only, named by its aria-label and tooltip, and the arrow keys move along the rail (see
    MapStudio's rail keys).

    When the studio is short (data-fwmb-short, see StudioLayout) the occasional tools fold into
    the More menu, which holds the same four; the file actions never fold. When it is narrow the
    rail goes compact and the stage names are hidden visually, but stay as the groups' names.
--}}
<nav aria-label="{{localize 'FILRODENSWMB.UI.RailLabel'}}">
    {{#each railStages}}
    <div class="fwmb-rail-group" role="group" aria-labelledby="fwmb-rail-stage-{{this.id}}">
        <span class="fwmb-rail-stage" id="fwmb-rail-stage-{{this.id}}" data-tooltip="{{localize this.label}}">{{localize this.label}}</span>
        {{#each this.tools}}
        <button type="button" class="fwmb-rail-btn" data-action="changeTool" data-tool="{{this.id}}" aria-label="{{localize this.label}}" data-tooltip="{{localize this.label}}" aria-current="{{#if (eq ../../activeTool this.id)}}page{{else}}false{{/if}}">
            <span class="fwmb-icon fwmb-icon--{{this.icon}}" aria-hidden="true"></span>
        </button>
        {{/each}}
    </div>
    {{/each}}

    <span class="fwmb-rail-spacer"></span>

    <div class="fwmb-rail-group fwmb-rail-occasional" role="group" aria-label="{{localize 'FILRODENSWMB.UI.RailOccasional'}}">
        {{#each railOccasional}}
        {{#if this.tool}}
        <button type="button" class="fwmb-rail-btn" data-action="changeTool" data-tool="{{this.tool}}" aria-label="{{localize this.label}}" data-tooltip="{{localize this.label}}" aria-current="{{#if (eq ../activeTool this.tool)}}page{{else}}false{{/if}}">
            <span class="fwmb-icon fwmb-icon--{{this.icon}}" aria-hidden="true"></span>
        </button>
        {{else}}
        <button type="button" class="fwmb-rail-btn" data-action="{{this.action}}" aria-label="{{localize this.label}}" data-tooltip="{{localize this.label}}" aria-pressed="{{#if this.pressed}}true{{else}}false{{/if}}">
            <span class="fwmb-icon fwmb-icon--{{this.icon}}" aria-hidden="true"></span>
        </button>
        {{/if}}
        {{/each}}
    </div>

    {{!-- The occasional tools again, in one menu, for a short studio --}}
    <div class="fwmb-dropdown fwmb-dropdown--beside fwmb-rail-more" tabindex="-1">
        <button type="button" class="fwmb-rail-btn" aria-haspopup="menu" aria-label="{{localize 'FILRODENSWMB.UI.RailMore'}}" data-tooltip="{{localize 'FILRODENSWMB.UI.RailMore'}}" aria-current="{{#if railOccasionalActive}}page{{else}}false{{/if}}">
            <span class="fwmb-icon fwmb-icon--more-vert" aria-hidden="true"></span>
        </button>
        <div class="fwmb-dropdown-menu" role="menu" aria-label="{{localize 'FILRODENSWMB.UI.RailOccasional'}}">
            {{#each railOccasional}}
            {{#if this.tool}}
            <button type="button" role="menuitem" data-action="changeTool" data-tool="{{this.tool}}" aria-current="{{#if (eq ../activeTool this.tool)}}page{{else}}false{{/if}}">
                <span class="fwmb-icon fwmb-icon--{{this.icon}}" aria-hidden="true"></span> {{localize this.label}}
            </button>
            {{else}}
            <button type="button" role="menuitemcheckbox" data-action="{{this.action}}" aria-checked="{{#if this.pressed}}true{{else}}false{{/if}}">
                <span class="fwmb-icon fwmb-icon--{{this.icon}}" aria-hidden="true"></span> {{localize this.label}}
            </button>
            {{/if}}
            {{/each}}
        </div>
    </div>

    <span class="fwmb-rail-sep"></span>

    <div class="fwmb-rail-group fwmb-rail-files" role="group" aria-label="{{localize 'FILRODENSWMB.UI.RailFiles'}}">
        <button type="button" class="fwmb-rail-btn{{#if isDirty}} fwmb-is-dirty{{/if}}" data-action="saveMap" aria-label="{{saveLabel}}" data-tooltip="{{saveLabel}}">
            <span class="fwmb-icon fwmb-icon--save" aria-hidden="true"></span>
        </button>
        <button type="button" class="fwmb-rail-btn" data-action="saveMapAs" aria-label="{{localize 'FILRODENSWMB.UI.SaveMapAs'}}" data-tooltip="{{localize 'FILRODENSWMB.UI.SaveMapAs'}}">
            <span class="fwmb-icon fwmb-icon--save-as" aria-hidden="true"></span>
        </button>
        <button type="button" class="fwmb-rail-btn" data-action="changeTool" data-tool="manage" aria-label="{{localize 'FILRODENSWMB.UI.ToolManage'}}" data-tooltip="{{localize 'FILRODENSWMB.UI.ToolManage'}}" aria-current="{{#if (eq activeTool 'manage')}}page{{else}}false{{/if}}">
            <span class="fwmb-icon fwmb-icon--folder-open" aria-hidden="true"></span>
        </button>
    </div>
</nav>
