{{!--
    Cartography: the scale bar, the border, the grid (exported with a scene) and the decorations.
    Cartography has no edit toggle: its decorations and scale bar can be moved on the map whenever
    the tool is open, and Add decoration is on the bar.
--}}
{{#> "modules/filrodens-world-map-builder/templates/parts/section.hbs" id="scaleBar" title="FILRODENSWMB.UI.SectionScaleBar" badge="FILRODENSWMB.UI.BadgeInstant" instant=true}}
    <label class="fwmb-setting-row">
        <input type="checkbox" name="cartographyScaleEnable" class="fwmb-checkbox" {{#if uiState.cartographyScaleEnable}}checked{{/if}}>
        {{localize "FILRODENSWMB.UI.CartographyScale"}}
    </label>
        
    <div class="fwmb-form-group">
        <label>{{localize "FILRODENSWMB.UI.ScaleUnits"}}</label>
        <div class="fwmb-form-fields">
            <input type="text" name="cartographyScaleUnits" value="{{uiState.cartographyScaleUnits}}" placeholder="{{localize 'FILRODENSWMB.UI.ScaleUnitsPlaceholder'}}">
        </div>
    </div>
        
    <div class="fwmb-form-group">
        <label>{{localize "FILRODENSWMB.UI.ScaleInterval"}}</label>
        <div class="fwmb-form-fields">
            <div class="fwmb-setting-row">
                <input type="number" name="cartographyScaleInterval" value="{{uiState.cartographyScaleInterval}}" min="10" step="10">
                <span class="fwmb-hint">px</span>
            </div>
        </div>
    </div>

    <div class="fwmb-form-group">
        <label>{{localize "FILRODENSWMB.UI.ScaleValue"}}</label>
        <div class="fwmb-form-fields">
            <div class="fwmb-setting-row">
                <input type="number" name="cartographyScaleValue" value="{{uiState.cartographyScaleValue}}" min="1" class="fwmb-input-short">
                <span class="fwmb-hint">{{localize "FILRODENSWMB.UI.ScaleValueHint"}}</span>
            </div>
        </div>
    </div>

    <div class="fwmb-form-group">
        <label>{{localize "FILRODENSWMB.UI.ScaleTicks"}}</label>
        <div class="fwmb-form-fields">
            <div class="fwmb-setting-row">
                <input type="number" name="cartographyScaleMajorTicks" value="{{uiState.cartographyScaleMajorTicks}}" min="1" max="10" aria-label="{{localize 'FILRODENSWMB.UI.ScaleMajorTicks'}}" data-tooltip="{{localize 'FILRODENSWMB.UI.ScaleMajorTicks'}}" class="fwmb-input-short">
                <input type="number" name="cartographyScaleMinorTicks" value="{{uiState.cartographyScaleMinorTicks}}" min="0" max="10" aria-label="{{localize 'FILRODENSWMB.UI.ScaleMinorTicks'}}" data-tooltip="{{localize 'FILRODENSWMB.UI.ScaleMinorTicks'}}" class="fwmb-input-short">
            </div>
        </div>
    </div>
{{/"modules/filrodens-world-map-builder/templates/parts/section.hbs"}}

{{#> "modules/filrodens-world-map-builder/templates/parts/section.hbs" id="border" title="FILRODENSWMB.UI.SectionBorder" badge="FILRODENSWMB.UI.BadgeInstant" instant=true}}
    <label class="fwmb-setting-row">
        <input type="checkbox" name="cartographyBorderEnable" class="fwmb-checkbox" {{#if uiState.cartographyBorderEnable}}checked{{/if}}>
        {{localize "FILRODENSWMB.UI.CartographyBorder"}}
    </label>

    <div class="fwmb-form-group">
        <label>{{localize "FILRODENSWMB.UI.BorderStyle"}}</label>
        <div class="fwmb-form-fields">
            <select name="cartographyBorderStyle" class="fwmb-flex-1">
                <option value="solid" {{#if (eq uiState.cartographyBorderStyle "solid")}}selected{{/if}}>{{localize "FILRODENSWMB.UI.BorderSolid"}}</option>
                <option value="double" {{#if (eq uiState.cartographyBorderStyle "double")}}selected{{/if}}>{{localize "FILRODENSWMB.UI.BorderDouble"}}</option>
                <option value="ornate" {{#if (eq uiState.cartographyBorderStyle "ornate")}}selected{{/if}}>{{localize "FILRODENSWMB.UI.BorderOrnate"}}</option>
            </select>
        </div>
    </div>

    <div class="fwmb-form-group">
        <label>{{localize "FILRODENSWMB.UI.LineColor"}}</label>
        <div class="fwmb-form-fields">
            <input type="color" class="fwmb-swatch fwmb-wide" name="cartographyBorderColor" value="{{uiState.cartographyBorderColor}}" />
        </div>
    </div>
{{/"modules/filrodens-world-map-builder/templates/parts/section.hbs"}}

{{#> "modules/filrodens-world-map-builder/templates/parts/section.hbs" id="grid" title="FILRODENSWMB.UI.SectionGrid" badge="FILRODENSWMB.UI.BadgeInstant" instant=true}}
    <div class="fwmb-form-group">
        <label for="fwmb-grid-type">{{localize "FILRODENSWMB.UI.GridType"}}</label>
        <div class="fwmb-form-fields">
            <select id="fwmb-grid-type" name="gridType">
                <option value="none" {{#if (eq uiState.gridType "none")}}selected{{/if}}>{{localize "FILRODENSWMB.UI.GridNone"}}</option>
                <option value="square" {{#if (eq uiState.gridType "square")}}selected{{/if}}>{{localize "FILRODENSWMB.UI.GridSquare"}}</option>
                <option value="hexR" {{#if (eq uiState.gridType "hexR")}}selected{{/if}}>{{localize "FILRODENSWMB.UI.GridHexRows"}}</option>
                <option value="hexC" {{#if (eq uiState.gridType "hexC")}}selected{{/if}}>{{localize "FILRODENSWMB.UI.GridHexCols"}}</option>
            </select>
        </div>
    </div>

    {{> "modules/filrodens-world-map-builder/templates/parts/shared-range.hbs" name="gridSize" label="FILRODENSWMB.UI.GridSize" value=(lookup uiState 'gridSize') min=20 max=300 step=5}}
{{/"modules/filrodens-world-map-builder/templates/parts/section.hbs"}}

{{#> "modules/filrodens-world-map-builder/templates/parts/section.hbs" id="decorations" title="FILRODENSWMB.UI.CartographyDecorations" count=mapDecorations.length}}
    <div class="fwmb-list-container fwmb-scrollable fwmb-scrollable--stable fwmb-space-before">
        {{#each mapDecorations}}
        <div class="fwmb-list-item" aria-selected="{{#if (eq this.id @root.inspected.decoration)}}true{{else}}false{{/if}}" data-id="{{this.id}}" data-type="decoration" data-action="editDecoration">
            <button type="button" class="fwmb-btn fwmb-btn--subtle fwmb-btn--square" data-action="toggleVisibility" data-target="feature" aria-label="{{localize 'FILRODENSWMB.UI.ToggleVisibility'}}" data-tooltip="{{localize 'FILRODENSWMB.UI.ToggleVisibility'}}">
                <i class="fwmb-icon {{#if (eq this.visibility 'none')}}fwmb-icon--visibility-off{{else if (eq this.visibility 'gm')}}fwmb-icon--security{{else}}fwmb-icon--visibility{{/if}}"></i>
            </button>
            <span class="fwmb-name fwmb-flex-1 fwmb-truncate">{{this.name}}</span>
            <span class="fwmb-actions">
                <button type="button" class="fwmb-btn fwmb-btn--subtle fwmb-btn--square" data-action="zoomToFeature" aria-label="{{localize 'FILRODENSWMB.UI.ZoomTo'}}" data-tooltip="{{localize 'FILRODENSWMB.UI.ZoomTo'}}">
                    <i class="fwmb-icon fwmb-icon--center-focus"></i>
                </button>
                <button type="button" class="fwmb-btn fwmb-btn--subtle fwmb-btn--square" data-action="editDecoration" aria-label="{{localize 'FILRODENSWMB.UI.Edit'}}" data-tooltip="{{localize 'FILRODENSWMB.UI.Edit'}}">
                    <i class="fwmb-icon fwmb-icon--edit"></i>
                </button>
                <button type="button" class="fwmb-btn fwmb-btn--square fwmb-btn--danger-quiet" data-action="deleteDecoration" aria-label="{{localize 'FILRODENSWMB.UI.Delete'}}" data-tooltip="{{localize 'FILRODENSWMB.UI.Delete'}}">
                    <i class="fwmb-icon fwmb-icon--delete"></i>
                </button>
            </span>
        </div>
        {{else}}
        <div class="fwmb-list-empty">{{localize "FILRODENSWMB.UI.NoDecorations"}}</div>
        {{/each}}
    </div>
{{/"modules/filrodens-world-map-builder/templates/parts/section.hbs"}}
