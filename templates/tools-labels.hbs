{{!--
    Labels: every label of the map in one list (allLabels): the labels placed by hand
    (standalone) and the labels of pins, routes and regions, each with what it belongs to as its
    meta. The list is searched and filtered (by who made it and its kind), its rows
    rendered only when they change (see ListQuery). A row opens its label in the inspector; an owned label's inspector links to its
    owner. Mass Edit (with Delete) chooses among the standalone labels. Placing a label is the state
    block's (and the bar's) work.
--}}
{{#> "modules/filrodens-world-map-builder/templates/parts/section.hbs" id="allLabels" title="FILRODENSWMB.UI.AllLabels" count=labelList.total massType="label"}}
    {{> "modules/filrodens-world-map-builder/templates/parts/list-query.hbs" query=labelList.controls kindLabel="FILRODENSWMB.UI.LabelFilter"}}

    {{#if massEditMode.label}}
    <div class="fwmb-mass-edit-bar fwmb-mass-edit-bar--list">
        <button type="button" class="fwmb-btn fwmb-btn--subtle" data-action="massEditSelectAll" data-type="label">{{localize "FILRODENSWMB.UI.MassEditSelectAll"}}</button>
        <button type="button" class="fwmb-btn fwmb-btn--subtle" data-action="massEditSelectNone" data-type="label">{{localize "FILRODENSWMB.UI.MassEditSelectNone"}}</button>
        <button type="button" class="fwmb-btn fwmb-btn--danger-quiet" data-action="massDelete" data-type="label" {{#unless massEditCount.label}}disabled{{/unless}} data-tooltip="{{localize 'FILRODENSWMB.UI.MassDeleteHint'}}">
            {{localize "FILRODENSWMB.UI.MassDelete" count=massEditCount.label}}
        </button>
        <button type="button" class="fwmb-btn fwmb-btn--primary" data-action="openMassEdit" data-type="label" {{#unless massEditCount.label}}disabled{{/unless}}>
            {{localize "FILRODENSWMB.UI.MassEdit"}} ({{massEditCount.label}})
        </button>
    </div>
    {{/if}}

    <div role="listbox" aria-label="{{localize 'FILRODENSWMB.UI.AllLabels'}}" data-list-nav id="fwmb-scroll-labels" data-list-version="{{labelList.version}}" data-list-rows="label" data-list-selected="{{labelList.selected}}" class="fwmb-list-container fwmb-scrollable fwmb-scrollable--stable fwmb-space-before"></div>
{{/"modules/filrodens-world-map-builder/templates/parts/section.hbs"}}
