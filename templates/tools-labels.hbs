<div class="fwmb-tool-content fwmb-fixed-lists">

    <fieldset class="fwmb-fieldset">
        <legend>{{localize "FILRODENSWMB.UI.AutoLabels"}}</legend>
        <div id="fwmb-scroll-auto-labels" class="fwmb-list-container fwmb-scrollable stable" style="margin-top: var(--fwmb-space-10);">
            
            {{#each autoLabels}}
            <div class="fwmb-list-item" data-id="{{this.id}}" data-type="{{this.dataType}}" {{#if this.layerId}}data-layer-id="{{this.layerId}}"{{/if}}>
                <button type="button" class="fwmb-btn small" data-action="toggleVisibility" data-target="label" data-tooltip="{{localize 'FILRODENSWMB.UI.ToggleVisibility'}}">
                    <i class="fwmb-icon {{#if (eq this.displayVisibility 'none')}}visibility-off{{else if (eq this.displayVisibility 'gm')}}security{{else}}visibility{{/if}}"></i>
                </button>
                <span class="fwmb-name fwmb-flex-1 fwmb-truncate">{{this.name}}</span>
                <button type="button" class="fwmb-btn small" data-action="zoomToFeature" data-tooltip="{{localize 'FILRODENSWMB.UI.ZoomTo'}}">
                    <i class="fwmb-icon center-focus"></i>
                </button>
                <button type="button" class="fwmb-btn small" data-action="editLabel" data-tooltip="{{localize 'FILRODENSWMB.UI.Edit'}}">
                    <i class="fwmb-icon edit"></i>
                </button>
            </div>
            {{else}}
            <div class="fwmb-empty-state">{{localize "FILRODENSWMB.UI.NoLabels"}}</div>
            {{/each}}

        </div>
    </fieldset>

    <fieldset class="fwmb-fieldset">
        <legend class="fwmb-legend-with-action">
            <span>{{localize "FILRODENSWMB.UI.CustomLabels"}}</span>
            <a class="fwmb-legend-action {{#if massEditMode.label}}active{{/if}}" data-action="toggleMassEditMode" data-type="label" data-tooltip="{{localize 'FILRODENSWMB.UI.MassEditSelect'}}" data-tooltip-class="fwmb-tooltip">
                <i class="fwmb-icon edit-square"></i>
            </a>
        </legend>

        {{#if massEditMode.label}}
        <div class="fwmb-mass-edit-bar">
            <a class="fwmb-bulk-action-button" data-action="massEditSelectAll" data-type="label">{{localize "FILRODENSWMB.UI.MassEditSelectAll"}}</a>
            <a class="fwmb-bulk-action-button" data-action="massEditSelectNone" data-type="label">{{localize "FILRODENSWMB.UI.MassEditSelectNone"}}</a>
            <span class="fwmb-flex-1"></span>
            <button type="button" class="fwmb-btn primary" data-action="openMassEdit" data-type="label" {{#unless massEditCount.label}}disabled{{/unless}}>
                {{localize "FILRODENSWMB.UI.MassEdit"}} ({{massEditCount.label}})
            </button>
        </div>
        {{/if}}

        <div id="fwmb-scroll-custom-labels" class="fwmb-list-container fwmb-scrollable stable" style="margin-top: var(--fwmb-space-10);">
            {{#each mapLabels}}
            <div class="fwmb-list-item" data-id="{{this.id}}" data-type="custom">
                {{#if ../massEditMode.label}}
                    <input type="checkbox" class="fwmb-checkbox" data-action="toggleMassEditItem" data-mass-type="label" {{#if this.massEditSelected}}checked{{/if}} />
                {{/if}}
                <button type="button" class="fwmb-btn small" data-action="toggleVisibility" data-target="label" data-tooltip="{{localize 'FILRODENSWMB.UI.ToggleVisibility'}}">
                    <i class="fwmb-icon {{#if (eq this.visibility 'none')}}visibility-off{{else if (eq this.visibility 'gm')}}security{{else}}visibility{{/if}}"></i>
                </button>
                <span class="fwmb-name fwmb-flex-1 fwmb-truncate">{{this.name}}</span>
                <button type="button" class="fwmb-btn small" data-action="zoomToFeature" data-tooltip="{{localize 'FILRODENSWMB.UI.ZoomTo'}}">
                    <i class="fwmb-icon center-focus"></i>
                </button>
                <button type="button" class="fwmb-btn small" data-action="editLabel" data-tooltip="{{localize 'FILRODENSWMB.UI.Edit'}}">
                    <i class="fwmb-icon edit"></i>
                </button>
                <button type="button" class="fwmb-btn small muted danger" data-action="deleteLabel" data-tooltip="{{localize 'FILRODENSWMB.UI.Delete'}}">
                    <i class="fwmb-icon delete"></i>
                </button>
            </div>
            {{else}}
            <div class="fwmb-empty-state">{{localize "FILRODENSWMB.UI.NoLabels"}}</div>
            {{/each}}
        </div>
    </fieldset>
    
    <div class="fwmb-divider"></div>
    
    <button type="button" class="fwmb-btn primary" data-action="toggleEditMode">
        <i class="fwmb-icon brush"></i>
        {{localize "FILRODENSWMB.UI.EditLabel"}}
    </button>
</div>