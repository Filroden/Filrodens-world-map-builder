<div class="fwmb-dialog-content">
    <datalist id="fwmb-standard-colors">
        {{#each palette}}
            <option value="{{this}}"></option>
        {{/each}}
    </datalist>

    <div class="form-group fwmb-dialog-content">
        <label>{{localize "FILRODENSWMB.UI.Name"}}</label>
        <input type="text" name="biomeName" value="{{biome.name}}" autofocus>
    </div>

    <div class="form-group fwmb-dialog-content" style="margin-top: var(--fwmb-space-m);">
        <label>{{localize "FILRODENSWMB.UI.BiomeCode"}}</label>
        <input type="text" name="biomeCode" value="{{biome.code}}" placeholder="{{localize 'FILRODENSWMB.UI.BiomeCodeHint'}}">
    </div>

    <div class="form-group fwmb-dialog-content" style="margin-top: var(--fwmb-space-m);">
        <label>{{localize "FILRODENSWMB.UI.BiomeColor"}}</label>
        <input type="color" name="biomeColor" value="{{biome.hex}}" list="fwmb-standard-colors" class="fwmb-swatch fwmb-wide" style="height: 24px; padding: 0;">
    </div>
</div>
