<div class="fwmb-dialog-content">
    <datalist id="fwmb-standard-colors">
        {{#each palette}}
            <option value="{{this}}"></option>
        {{/each}}
    </datalist>

    <div class="fwmb-form-group fwmb-dialog-content">
        <label>{{localize "FILRODENSWMB.UI.Name"}}</label>
        <div class="fwmb-form-fields">
            <input type="text" name="biomeName" maxlength="{{fwmbTextLimit 'name'}}" value="{{biome.name}}" autofocus />
        </div>
    </div>

    <div class="fwmb-form-group fwmb-dialog-content fwmb-space-before">
        <label>{{localize "FILRODENSWMB.UI.BiomeCode"}}</label>
        <div class="fwmb-form-fields">
            <input type="text" name="biomeCode" maxlength="{{fwmbTextLimit 'name'}}" value="{{biome.code}}" placeholder="{{localize 'FILRODENSWMB.UI.BiomeCodeHint'}}" />
        </div>
    </div>

    <div class="fwmb-form-group fwmb-dialog-content fwmb-space-before">
        <label>{{localize "FILRODENSWMB.UI.BiomeColor"}}</label>
        <div class="fwmb-form-fields">
            <input type="color" name="biomeColor" value="{{biome.hex}}" list="fwmb-standard-colors" class="fwmb-swatch fwmb-wide fwmb-swatch--slim" />
        </div>
    </div>

    <div class="fwmb-form-group fwmb-dialog-content fwmb-space-before">
        <label class="fwmb-info-label">
            {{localize "FILRODENSWMB.UI.BiomePlacement"}}
            <i class="fwmb-icon fwmb-icon--info" data-tooltip="{{localize 'FILRODENSWMB.UI.BiomePlacementHint'}}"></i>
        </label>
        <div class="fwmb-form-fields">
            <select name="biomePlacement">
                {{#each placements}}
                    <option value="{{this.value}}" {{#if this.selected}}selected{{/if}}>{{localize this.label}}</option>
                {{/each}}
            </select>
        </div>
    </div>
</div>
