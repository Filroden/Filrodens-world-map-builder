<div class="fwmb-dialog-content">
    {{#if isRegional}}
        <p>{{localize "FILRODENSWMB.UI.TerrainUpdateIntro"}}</p>

        <ul class="fwmb-terrain-update-list">
            {{#if changesTerrain}}
                <li>{{localize "FILRODENSWMB.UI.TerrainUpdateTerrain"}}</li>
            {{/if}}
            {{#if changesBiomes}}
                <li>{{localize "FILRODENSWMB.UI.TerrainUpdateBiomes"}}</li>
            {{/if}}
            {{#if changesFaults}}
                <li>{{localize "FILRODENSWMB.UI.TerrainUpdateFaults"}}</li>
            {{/if}}
        </ul>
    {{else if isTectonics}}
        <p>{{localize "FILRODENSWMB.UI.TerrainUpdateIntroTectonics"}}</p>

        <ul class="fwmb-terrain-update-list">
            <li>{{localize "FILRODENSWMB.UI.TerrainUpdateTectonicsLand"}}</li>
            <li>{{localize "FILRODENSWMB.UI.TerrainUpdateTectonicsFeatures"}}</li>
        </ul>
    {{else}}
        <p>{{localize "FILRODENSWMB.UI.TerrainUpdateIntroCoastline"}}</p>

        <ul class="fwmb-terrain-update-list">
            <li>{{localize "FILRODENSWMB.UI.TerrainUpdateProfile"}}</li>
            {{#if resized}}
                <li>{{localize "FILRODENSWMB.UI.TerrainUpdateCoastlines"}}</li>
            {{/if}}
            {{#if fractureChanges}}
                <li>{{localize "FILRODENSWMB.UI.TerrainUpdateFracture" before=fracture.before after=fracture.after}}</li>
            {{/if}}
        </ul>
    {{/if}}

    <p class="fwmb-hint">{{localize "FILRODENSWMB.UI.TerrainUpdateNotSaved"}}</p>

    {{#if allowDismiss}}
        <div class="fwmb-divider"></div>

        <div class="form-group stacked">
            <label class="fwmb-setting-row" data-tooltip="{{localize 'FILRODENSWMB.UI.TerrainUpdateDismissHint'}}">
                <input type="checkbox" name="dismissUpgrade" class="fwmb-checkbox" />
                <strong>{{localize "FILRODENSWMB.UI.TerrainUpdateDismiss"}}</strong>
            </label>
        </div>
    {{/if}}
</div>
