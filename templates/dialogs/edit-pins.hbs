<div class="fwmb-dialog-content">
    <datalist id="fwmb-standard-colors">
        {{#each palette}}
            <option value="{{this}}"></option>
        {{/each}}
    </datalist>

    <div class="form-group stacked">
        <label>{{localize "FILRODENSWMB.UI.Name"}}</label>
        <input type="text" name="pinName" value="{{pin.name}}" />
    </div>

    <div class="form-group stacked">
        <label>{{localize "FILRODENSWMB.UI.Description"}}</label>
        <textarea class="fwmb-scrollable stable" name="pinDesc" rows="4">{{pin.description}}</textarea>
    </div>

    <div class="form-group" style="display: flex; gap: var(--fwmb-space-xs);">
        <label>{{localize "FILRODENSWMB.UI.SelectIcon"}}</label>
        <input type="hidden" name="pinIcon" value="{{pin.icon}}" id="fwmb-edit-pin-icon-input" />
        
        <div class="fwmb-custom-select" id="fwmb-edit-pin-select">
            <div class="fwmb-select-trigger" style="cursor: pointer;">
                <i class="fwmb-icon {{pin.icon}}" id="fwmb-edit-pin-trigger-icon"></i>
                <i class="fwmb-icon arrow-drop-down"></i>
            </div>
            <!-- Override absolute positioning to create an inline accordion expansion -->
            <div class="fwmb-select-options fwmb-icon-grid fwmb-scrollable fwmb-hidden" style="position: relative; top: 0; left: 0; width: 100%; margin-block-start: var(--fwmb-space-s); box-shadow: none;">
                {{#each icons}}
                <button type="button" class="fwmb-btn {{#if this.selected}}active{{/if}}" data-icon="{{this.key}}" data-tooltip="{{this.localized}}">
                    <i class="fwmb-icon {{this.key}}" alt="{{this.localized}}"></i>
                </button>
                {{/each}}
            </div>
        </div>
    </div>

    <div class="form-group">
        <label>{{localize "FILRODENSWMB.UI.PinColor"}}</label>
        <input type="color" class="fwmb-swatch fwmb-wide" name="pinColor" value="{{pin.color}}" list="fwmb-standard-colors" />
    </div>

    <div class="form-group">
        <label>{{localize "FILRODENSWMB.UI.IconScale"}}</label>
        <div class="fwmb-slider-group">
            <input type="range" name="pinScale" value="{{pin.scale}}" min="0.2" max="4" step="0.1" />
            <output>{{pin.scale}}</output>
        </div>
    </div>

</div>