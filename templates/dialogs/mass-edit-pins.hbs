<div class="fwmb-dialog-content">
    <datalist id="fwmb-standard-colors">
        {{#each palette}}
            <option value="{{this}}"></option>
        {{/each}}
    </datalist>

    <div class="fwmb-hint fwmb-space-after">
        {{localize "FILRODENSWMB.UI.MassEditHint"}}
    </div>

    <div class="fwmb-form-group">
        <label class="fwmb-mass-edit-label">
            <input type="checkbox" class="fwmb-checkbox" name="applyPinStyle" />
            {{localize "FILRODENSWMB.UI.PinStyle"}}
        </label>
        <div class="fwmb-form-fields">
            <select name="massPinStyle">
                <option value="custom">{{localize "FILRODENSWMB.UI.PinStyleNone"}}</option>
                {{#each pinStyles}}
                    <option value="{{this.id}}">{{this.name}}</option>
                {{/each}}
            </select>
        </div>
    </div>

    <div class="fwmb-form-group">
        <label class="fwmb-mass-edit-label">
            <input type="checkbox" class="fwmb-checkbox" name="applyIcon" />
            {{localize "FILRODENSWMB.UI.SelectIcon"}}
        </label>
        <div class="fwmb-form-fields">
            <div class="fwmb-custom-select" id="fwmb-mass-edit-pin-select">
                <input type="hidden" name="massIcon" value="{{defaultIcon.key}}" id="fwmb-mass-edit-pin-icon-input" />
                <div class="fwmb-select-trigger fwmb-clickable">
                    <i class="fwmb-icon {{#unless defaultIcon.isCustom}}fwmb-icon--{{defaultIcon.key}}{{/unless}}" {{#if defaultIcon.isCustom}}style="--fwmb-mask: url('{{defaultIcon.path}}');"{{/if}} id="fwmb-mass-edit-pin-trigger-icon"></i>
                    <i class="fwmb-icon fwmb-icon--arrow-drop-down"></i>
                </div>
                <div class="fwmb-select-options fwmb-icon-grid fwmb-scrollable fwmb-hidden">
                    {{#each icons}}
                    <button type="button" class="fwmb-btn" data-icon="{{this.key}}" data-path="{{this.path}}" data-custom="{{this.isCustom}}" data-tooltip="{{this.localized}}">
                        <i class="fwmb-icon {{#unless this.isCustom}}fwmb-icon--{{this.key}}{{/unless}}" {{#if this.isCustom}}style="--fwmb-mask: url('{{this.path}}');"{{/if}} alt="{{this.localized}}"></i>
                    </button>
                    {{/each}}
                </div>
            </div>
        </div>
    </div>

    <div class="fwmb-form-group">
        <label class="fwmb-mass-edit-label">
            <input type="checkbox" class="fwmb-checkbox" name="applyColor" />
            {{localize "FILRODENSWMB.UI.PinColor"}}
        </label>
        <div class="fwmb-form-fields">
            <input type="color" class="fwmb-swatch fwmb-wide" name="massColor" value="#ffffff" list="fwmb-standard-colors" />
        </div>
    </div>

    <div class="fwmb-form-group">
        <label class="fwmb-mass-edit-label">
            <input type="checkbox" class="fwmb-checkbox" name="applyScale" />
            {{localize "FILRODENSWMB.UI.IconScale"}}
        </label>
        <div class="fwmb-form-fields">
            <div class="fwmb-slider-group">
                <input type="range" name="massScale" value="1" min="0.2" max="4" step="0.1" />
                <output>1</output>
            </div>
        </div>
    </div>

    <fieldset class="fwmb-fieldset fwmb-space-before-large">
        <legend>{{localize "FILRODENSWMB.UI.SettingsLabelQuickStyles"}}</legend>
        <div class="fwmb-hint fwmb-space-after">
            {{localize "FILRODENSWMB.UI.MassEditHint"}}
        </div>

        <div class="fwmb-form-group">
            <label class="fwmb-mass-edit-label">
                <input type="checkbox" class="fwmb-checkbox" name="applyLabelQuickStyle" />
                {{localize "FILRODENSWMB.UI.QuickStyles"}}
            </label>
            <div class="fwmb-form-fields">
                <select name="labelQuickStyle">
                    <option value="custom">{{localize "FILRODENSWMB.UI.Custom"}}</option>
                    {{#each customLabelStyles}}
                        <option value="{{this.id}}">{{this.name}}</option>
                    {{/each}}
                </select>
            </div>
        </div>

        <div class="fwmb-form-group">
            <label class="fwmb-mass-edit-label">
                <input type="checkbox" class="fwmb-checkbox" name="applyLabelFontFamily" />
                {{localize "FILRODENSWMB.UI.FontFamily"}}
            </label>
            <div class="fwmb-form-fields">
                <select name="labelFontFamily">
                    {{#each fonts}}
                        <option value="{{this}}" {{#if (eq ../labelDefaults.fontFamily this)}}selected{{/if}}>{{this}}</option>
                    {{/each}}
                </select>
            </div>
        </div>

        <div class="fwmb-form-group">
            <label class="fwmb-mass-edit-label">
                <input type="checkbox" class="fwmb-checkbox" name="applyLabelFontSize" />
                {{localize "FILRODENSWMB.UI.FontSize"}}
            </label>
            <div class="fwmb-form-fields">
                <div class="fwmb-slider-group">
                    <input type="range" name="labelFontSize" value="{{labelDefaults.fontSize}}" min="0.2" max="5.0" step="0.1" />
                    <output>{{labelDefaults.fontSize}}</output>
                </div>
            </div>
        </div>

        <div class="fwmb-form-group">
            <label class="fwmb-mass-edit-label">
                <input type="checkbox" class="fwmb-checkbox" name="applyLabelFillColor" />
                {{localize "FILRODENSWMB.UI.FontColor"}}
            </label>
            <div class="fwmb-form-fields">
                <input type="color" class="fwmb-swatch fwmb-wide" name="labelFillColor" value="{{labelDefaults.fillColor}}" list="fwmb-standard-colors" />
            </div>
        </div>

        <div class="fwmb-form-group">
            <label class="fwmb-mass-edit-label">
                <input type="checkbox" class="fwmb-checkbox" name="applyLabelMaxChars" />
                {{localize "FILRODENSWMB.UI.MaxWidth"}}
            </label>
            <div class="fwmb-form-fields">
                <input type="number" name="labelMaxChars" value="{{labelDefaults.maxChars}}" min="0" step="1" placeholder="0" />
            </div>
        </div>

        <div class="fwmb-form-group">
            <label class="fwmb-mass-edit-label">
                <input type="checkbox" class="fwmb-checkbox" name="applyLabelJustify" />
                {{localize "FILRODENSWMB.UI.Justify"}}
            </label>
            <div class="fwmb-form-fields">
                <select name="labelJustify">
                    <option value="left" {{#if (eq labelDefaults.justify "left")}}selected{{/if}}>{{localize "FILRODENSWMB.UI.JustifyLeft"}}</option>
                    <option value="center" {{#if (eq labelDefaults.justify "center")}}selected{{/if}}>{{localize "FILRODENSWMB.UI.JustifyCenter"}}</option>
                    <option value="right" {{#if (eq labelDefaults.justify "right")}}selected{{/if}}>{{localize "FILRODENSWMB.UI.JustifyRight"}}</option>
                </select>
            </div>
        </div>
    </fieldset>
</div>
