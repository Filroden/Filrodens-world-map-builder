<div class="fwmb-dialog-content">
    {{!-- A pin quick style (see PinStyles): its name, icon, colour and size, its label's size, visibility and quick style, and its detail level. --}}
    <datalist id="fwmb-standard-colors">
        {{#each palette}}
            <option value="{{this}}"></option>
        {{/each}}
    </datalist>

    <div class="form-group stacked">
        <label>{{localize "FILRODENSWMB.UI.Name"}}</label>
        <input type="text" name="styleName" value="{{style.name}}" autofocus />
    </div>

    <div class="form-group">
        <label>{{localize "FILRODENSWMB.UI.SelectIcon"}}</label>
        <div class="fwmb-custom-select" id="fwmb-pin-style-select">
            <input type="hidden" name="styleIcon" value="{{style.icon}}" id="fwmb-pin-style-icon-input" />
            <div class="fwmb-select-trigger" style="cursor: pointer;">
                <i class="fwmb-icon {{#unless pinIconIsCustom}}{{style.icon}}{{/unless}}" {{#if pinIconIsCustom}}style="--fwmb-mask: url('{{pinIconPath}}');"{{/if}} id="fwmb-pin-style-trigger-icon"></i>
                <i class="fwmb-icon arrow-drop-down"></i>
            </div>
            <div class="fwmb-select-options fwmb-icon-grid fwmb-scrollable fwmb-hidden">
                {{#each icons}}
                <button type="button" class="fwmb-btn {{#if this.selected}}active{{/if}}" data-icon="{{this.key}}" data-path="{{this.path}}" data-custom="{{this.isCustom}}" data-tooltip="{{this.localized}}">
                    <i class="fwmb-icon {{#unless this.isCustom}}{{this.key}}{{/unless}}" {{#if this.isCustom}}style="--fwmb-mask: url('{{this.path}}');"{{/if}} alt="{{this.localized}}"></i>
                </button>
                {{/each}}
            </div>
        </div>
    </div>

    <div class="form-group">
        <label>{{localize "FILRODENSWMB.UI.PinColor"}}</label>
        <input type="color" class="fwmb-swatch fwmb-wide" name="styleColor" value="{{style.color}}" list="fwmb-standard-colors" />
    </div>

    <div class="form-group">
        <label>{{localize "FILRODENSWMB.UI.IconScale"}}</label>
        <div class="fwmb-slider-group">
            <input type="range" name="styleScale" value="{{style.scale}}" min="0.2" max="4" step="0.1" />
            <output>{{style.scale}}</output>
        </div>
    </div>

    <div class="form-group">
        <label>{{localize "FILRODENSWMB.UI.PinDetailLevel"}} <i class="fwmb-icon info" data-tooltip="{{localize 'FILRODENSWMB.UI.PinDetailLevelHint'}}"></i></label>
        <select name="styleDetailLevel">
            {{#each detailLevels}}
                <option value="{{this.value}}" {{#if this.selected}}selected{{/if}}>{{localize this.label}}</option>
            {{/each}}
        </select>
    </div>

    <fieldset class="fwmb-fieldset" style="margin-top: var(--fwmb-size-16);">
        <legend>{{localize "FILRODENSWMB.UI.PinStyleLabel"}}</legend>
        <div class="fwmb-hint" style="margin-bottom: var(--fwmb-size-10);">
            {{localize "FILRODENSWMB.UI.PinStyleLabelHint"}}
        </div>

        <div class="form-group">
            <label>{{localize "FILRODENSWMB.UI.FontSize"}}</label>
            <div class="fwmb-slider-group">
                <input type="range" name="styleLabelSize" value="{{style.label.fontSize}}" min="0.2" max="5.0" step="0.1" />
                <output>{{style.label.fontSize}}</output>
            </div>
        </div>

        <div class="form-group">
            <label>{{localize "FILRODENSWMB.UI.Visibility"}}</label>
            <select name="styleLabelVisibility">
                {{#each visibilities}}
                    <option value="{{this.value}}" {{#if this.selected}}selected{{/if}}>{{localize this.label}}</option>
                {{/each}}
            </select>
        </div>

        <div class="form-group">
            <label>{{localize "FILRODENSWMB.UI.QuickStyles"}}</label>
            <select name="styleLabelQuickStyle">
                <option value="custom" {{#if (eq style.label.quickStyle "custom")}}selected{{/if}}>{{localize "FILRODENSWMB.UI.Custom"}}</option>
                {{#each customLabelStyles}}
                    <option value="{{this.id}}" {{#if (eq ../style.label.quickStyle this.id)}}selected{{/if}}>{{this.name}}</option>
                {{/each}}
            </select>
        </div>
    </fieldset>
</div>
