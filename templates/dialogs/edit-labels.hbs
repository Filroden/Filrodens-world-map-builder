<div class="fwmb-dialog-content">
    <div class="form-group stacked">
        <label>{{localize "FILRODENSWMB.UI.LabelText"}}</label>
        <input type="text" name="labelName" value="{{label.name}}" required />
    </div>

    <div class="form-group">
        <label>{{localize "FILRODENSWMB.UI.QuickStyles"}}</label>
        <select name="labelQuickStyle">
            <option value="custom" {{#if (eq label.quickStyle "custom")}}selected{{/if}}>
                {{localize "FILRODENSWMB.UI.Custom"}}
            </option>
            {{#each customLabelStyles}}
                <option value="{{this.id}}" {{#if (eq ../label.quickStyle this.id)}}selected{{/if}}>
                    {{this.name}}
                </option>
            {{/each}}
        </select>
    </div>

    <div class="form-group">
        <label>{{localize "FILRODENSWMB.UI.FontFamily"}}</label>
        <select name="labelFontFamily">
            {{#each fonts}}
                <option value="{{this}}" {{#if (eq ../label.fontFamily this)}}selected{{/if}}>{{this}}</option>
            {{/each}}
        </select>
    </div>

    <div class="form-group">
        <label>{{localize "FILRODENSWMB.UI.FontSize"}}</label>
        <div class="fwmb-slider-group">
            <input type="range" name="labelFontSize" value="{{label.fontSize}}" min="0.2" max="5.0" step="0.1" />
            <output>{{label.fontSize}}</output>
        </div>
    </div>

    <div class="form-group">
        <label>{{localize "FILRODENSWMB.UI.Rotation"}}</label>
        <div class="fwmb-slider-group">
            <input type="range" name="labelRotation" value="{{label.rotation}}" min="{{rotationRange.MIN}}" max="{{rotationRange.MAX}}" step="{{rotationRange.STEP}}" data-default="0" />
            <output>{{label.rotation}}</output>
        </div>
    </div>

    <div class="form-group">
        <label>{{localize "FILRODENSWMB.UI.FontColor"}}</label>
        <datalist id="fwmb-standard-colors">
            {{#each palette}}
                <option value="{{this}}"></option>
            {{/each}}
        </datalist>
        <input type="color" class="fwmb-swatch fwmb-wide" name="labelFillColor" value="{{label.fillColor}}" list="fwmb-standard-colors" />
    </div>

    <div class="form-group">
        <label>{{localize "FILRODENSWMB.UI.MaxWidth"}}</label>
        <input type="number" name="labelMaxChars" value="{{label.maxChars}}" min="0" step="1" />
    </div>

    <div class="form-group">
        <label>{{localize "FILRODENSWMB.UI.Justify"}}</label>
        <select name="labelJustify">
            <option value="left" {{#if (eq label.justify "left")}}selected{{/if}}>{{localize "FILRODENSWMB.UI.JustifyLeft"}}</option>
            <option value="center" {{#if (eq label.justify "center")}}selected{{/if}}>{{localize "FILRODENSWMB.UI.JustifyCenter"}}</option>
            <option value="right" {{#if (eq label.justify "right")}}selected{{/if}}>{{localize "FILRODENSWMB.UI.JustifyRight"}}</option>
        </select>
    </div>
</div>