<div class="fwmb-dialog-content">
    <div class="form-group stacked">
        <label>{{localize "FILRODENSWMB.UI.Name"}}</label>
        <input type="text" name="faultName" value="{{fault.name}}" />
    </div>
    
    <div class="form-group stacked">
        <label>{{localize "FILRODENSWMB.UI.Description"}}</label>
        <textarea class="fwmb-scrollable stable" name="faultDesc" rows="4">{{fault.description}}</textarea>
    </div>
    
    <div class="form-group">
        <label>{{localize "FILRODENSWMB.UI.FaultType"}}</label>
        <select name="faultType">
            {{#each tectonicTypes}}
                <option value="{{this.id}}" {{#if (eq ../fault.type this.id)}}selected{{/if}}>
                    {{localize this.label}}
                </option>
            {{/each}}
        </select>
    </div>

    <div class="form-group">
        <label>{{localize "FILRODENSWMB.UI.FaultThickness"}}</label>
        <input type="number" name="faultThickness" value="{{fault.thickness}}" min="10" max="100" step="1" />
    </div>
    
    <div class="form-group">
        <label>{{localize "FILRODENSWMB.UI.FaultStrength"}}</label>
        <input type="number" name="faultStrength" value="{{fault.strength}}" min="0.1" max="1.0" step="0.05" />
    </div>
</div>