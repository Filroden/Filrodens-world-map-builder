<div class="fwmb-dialog-content">
    {{!-- The layer set editor (see RegionPanel.editSet and addSet). --}}
    <div class="form-group stacked">
        <label>{{localize "FILRODENSWMB.UI.Name"}}</label>
        <input type="text" name="setName" value="{{set.name}}" autofocus />
    </div>
    <div class="form-group">
        <label>{{localize "FILRODENSWMB.UI.Visibility"}}</label>
        <select name="setVisibility">
            {{#each visibilities}}
                <option value="{{this.value}}" {{#if this.selected}}selected{{/if}}>{{localize this.label}}</option>
            {{/each}}
        </select>
    </div>
    <div class="form-group stacked">
        {{> "modules/filrodens-world-map-builder/templates/parts/shared-range.hbs" name="setOpacity" label="FILRODENSWMB.UI.LayerSetOpacity" value=set.opacity min=0 max=1 step=0.05}}
        <div class="fwmb-hint">{{localize "FILRODENSWMB.UI.LayerSetOpacityHint"}}</div>
    </div>
    <div class="form-group">
        <label class="fwmb-checkbox-label">
            <input type="checkbox" class="fwmb-checkbox" name="setWaterTint" {{#if set.waterTint}}checked{{/if}} />
            {{localize "FILRODENSWMB.UI.LayerSetWaterTint"}}
        </label>
        <i class="fwmb-icon info" data-tooltip="{{localize 'FILRODENSWMB.UI.LayerSetWaterTintHint'}}"></i>
    </div>
</div>
