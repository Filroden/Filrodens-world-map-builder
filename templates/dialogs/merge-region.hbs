<div class="fwmb-dialog-content">
    {{!-- Merge Into (see RegionPanel.mergeRegion): the region whose cells the merged region joins. --}}
    <div class="fwmb-hint">{{localize "FILRODENSWMB.UI.MergeRegionHint" name=region.name}}</div>
    <div class="form-group">
        <label>{{localize "FILRODENSWMB.UI.MergeInto"}}</label>
        <select name="mergeInto" autofocus>
            {{#each others}}
                <option value="{{this.id}}">{{this.name}}</option>
            {{/each}}
        </select>
    </div>
</div>
