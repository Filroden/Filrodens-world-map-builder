<div class="fwmb-rule-editor fwmb-scrollable">

    <p class="fwmb-hint fwmb-rule-editor-intro">
        {{localize "FILRODENSWMB.UI.RuleEditorIntro"}}
    </p>

    <div class="fwmb-rule-editor-legend">
        <div class="fwmb-rule-editor-legend-item">
            <span class="fwmb-rule-editor-swatch active"></span> {{localize "FILRODENSWMB.UI.RuleEditorLegendActive"}}
        </div>
        <div class="fwmb-rule-editor-legend-item">
            <span class="fwmb-rule-editor-swatch locked"></span> {{localize "FILRODENSWMB.UI.RuleEditorLegendLocked"}}
        </div>
        <div class="fwmb-rule-editor-legend-item">{{localize "FILRODENSWMB.UI.RuleEditorLegendOverlap"}}</div>
        <div class="fwmb-rule-editor-legend-item">{{localize "FILRODENSWMB.UI.RuleEditorLegendSeaLevel"}}</div>
    </div>

    <div class="fwmb-rule-editor-section-heading">
        <h3>{{localize "FILRODENSWMB.UI.RuleEditorCustomHeading"}}</h3>
        <span class="fwmb-rule-editor-count" id="fwmb-rule-custom-count"></span>
    </div>
    <div class="fwmb-rule-editor-flow" id="fwmb-rule-custom-rows"></div>

    <div class="fwmb-rule-editor-divider">
        <i class="fwmb-icon arrow-drop-down"></i>
        {{localize "FILRODENSWMB.UI.RuleEditorFallthrough"}}
    </div>

    <div class="fwmb-rule-editor-section-heading">
        <h3 class="muted">{{localize "FILRODENSWMB.UI.RuleEditorDefaultsHeading"}}</h3>
        <span class="fwmb-rule-editor-count">{{localize "FILRODENSWMB.UI.RuleEditorDefaultsHint"}}</span>
    </div>
    <div class="fwmb-rule-editor-flow locked" id="fwmb-rule-default-rows"></div>

</div>
