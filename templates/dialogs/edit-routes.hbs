<div class="fwmb-dialog-content">
    {{!-- The route editor (see RouteEditor): the route's details, its path (how its legs are found; the transport it was drawn for is fixed), its line and its label. --}}
    <datalist id="fwmb-standard-colors">
        {{#each palette}}
            <option value="{{this}}"></option>
        {{/each}}
    </datalist>

    <div class="fwmb-form-group fwmb-form-group--stacked">
        <label>{{localize "FILRODENSWMB.UI.Name"}}</label>
        <div class="fwmb-form-fields">
            <input type="text" name="routeName" value="{{route.name}}" />
        </div>
    </div>
    <div class="fwmb-form-group fwmb-form-group--stacked">
        <label>{{localize "FILRODENSWMB.UI.Description"}}</label>
        <div class="fwmb-form-fields">
            <textarea class="fwmb-scrollable fwmb-scrollable--stable" name="routeDesc" rows="4">{{route.description}}</textarea>
        </div>
    </div>
    <div class="fwmb-form-group">
        <label>{{localize "FILRODENSWMB.UI.Visibility"}}</label>
        <div class="fwmb-form-fields">
            <select name="routeVisibility">
                {{#each visibilities}}
                    <option value="{{this.value}}" {{#if this.selected}}selected{{/if}}>{{localize this.label}}</option>
                {{/each}}
            </select>
        </div>
    </div>

    <div class="fwmb-divider"></div>

    <div class="fwmb-form-group">
        <label>{{localize "FILRODENSWMB.UI.RouteLegMode"}} <i class="fwmb-icon fwmb-icon--info" data-tooltip="{{localize 'FILRODENSWMB.UI.RouteLegModeHint'}}"></i></label>
        <div class="fwmb-form-fields">
            <select name="routeMode">
                {{#each legModes}}
                    <option value="{{this.value}}" {{#if this.selected}}selected{{/if}}>{{localize this.label}}</option>
                {{/each}}
            </select>
        </div>
    </div>
    <div class="fwmb-form-group">
        <label>{{localize "FILRODENSWMB.UI.RouteTransport"}} <i class="fwmb-icon fwmb-icon--info" data-tooltip="{{localize 'FILRODENSWMB.UI.RouteTransportFixedHint'}}"></i></label>
        <div class="fwmb-form-fields">
            <span class="fwmb-route-transport">{{localize transportLabel}}</span>
        </div>
    </div>
    <div class="fwmb-form-group">
        <label class="fwmb-checkbox-label">
            <input type="checkbox" class="fwmb-checkbox" name="routeSpanWater" {{#if route.spanWater}}checked{{/if}} />
            {{localize "FILRODENSWMB.UI.RouteSpanWater"}}
        </label>
        <i class="fwmb-icon fwmb-icon--info" data-tooltip="{{localize 'FILRODENSWMB.UI.RouteSpanWaterHint'}}"></i>
    </div>
    <div class="fwmb-form-group">
        <label>{{localize "FILRODENSWMB.UI.RouteDetail"}} <i class="fwmb-icon fwmb-icon--info" data-tooltip="{{localize 'FILRODENSWMB.UI.RouteDetailEditorHint'}}"></i></label>
        <div class="fwmb-form-fields">
            <div class="fwmb-slider-group">
                <input type="range" name="routeDetail" value="{{detail.value}}" min="{{detail.MIN}}" max="{{detail.MAX}}" step="1" />
                <output>{{detail.value}}</output>
            </div>
        </div>
    </div>
    <div class="fwmb-form-group">
        <label>{{localize "FILRODENSWMB.UI.RouteClass"}} <i class="fwmb-icon fwmb-icon--info" data-tooltip="{{localize 'FILRODENSWMB.UI.RouteClassHint'}}"></i></label>
        <div class="fwmb-form-fields">
            <select name="routeClass">
                <option value="" {{#unless route.class}}selected{{/unless}}>{{localize "FILRODENSWMB.UI.RouteClassNone"}}</option>
                {{#each classes}}
                    <option value="{{this.value}}" {{#if this.selected}}selected{{/if}}>{{localize this.label}}</option>
                {{/each}}
            </select>
        </div>
    </div>

    <div class="fwmb-divider"></div>

    <div class="fwmb-form-group">
        <label>{{localize "FILRODENSWMB.UI.QuickStyles"}}</label>
        <div class="fwmb-form-fields">
            <select name="routeQuickStyle">
                <option value="custom" {{#if (eq route.quickStyle "custom")}}selected{{/if}}>
                    {{localize "FILRODENSWMB.UI.Custom"}}
                </option>
                {{#each customRouteStyles}}
                    <option value="{{this.id}}" {{#if (eq ../route.quickStyle this.id)}}selected{{/if}}>
                        {{this.name}}
                    </option>
                {{/each}}
            </select>
        </div>
    </div>

    <div class="fwmb-form-group">
        <label>{{localize "FILRODENSWMB.UI.LineColor"}}</label>
        <div class="fwmb-form-fields">
            <input type="color" name="routeColor" value="{{route.color}}" list="fwmb-standard-colors" />
        </div>
    </div>
    <div class="fwmb-form-group">
        <label>{{localize "FILRODENSWMB.UI.LineThickness"}}</label>
        <div class="fwmb-form-fields">
            <div class="fwmb-slider-group">
                <input type="range" name="routeThickness" value="{{route.thickness}}" min="{{thicknessStep}}" max="10" step="{{thicknessStep}}" />
                <output>{{route.thickness}}</output>
            </div>
        </div>
    </div>
    <div class="fwmb-form-group">
        <label>{{localize "FILRODENSWMB.UI.LineStyle"}}</label>
        <div class="fwmb-form-fields">
            <select name="routeStyle">
                <option value="solid" {{#if (eq route.style "solid")}}selected{{/if}}>{{localize "FILRODENSWMB.UI.StyleSolid"}}</option>
                <option value="dashed" {{#if (eq route.style "dashed")}}selected{{/if}}>{{localize "FILRODENSWMB.UI.StyleDashed"}}</option>
                <option value="dotted" {{#if (eq route.style "dotted")}}selected{{/if}}>{{localize "FILRODENSWMB.UI.StyleDotted"}}</option>
            </select>
        </div>
    </div>
    <div class="fwmb-form-group">
        <label class="fwmb-checkbox-label">
            <input type="checkbox" class="fwmb-checkbox" name="routeOutline" {{#if route.outline}}checked{{/if}} />
            {{localize "FILRODENSWMB.UI.RouteOutline"}}
        </label>
        <i class="fwmb-icon fwmb-icon--info" data-tooltip="{{localize 'FILRODENSWMB.UI.RouteOutlineHint'}}"></i>
    </div>
    <div class="fwmb-form-group">
        <label class="fwmb-checkbox-label">
            <input type="checkbox" class="fwmb-checkbox" name="routeSmoothing" {{#if route.smoothing}}checked{{/if}} />
            {{localize "FILRODENSWMB.UI.RouteSmoothing"}}
        </label>
        <i class="fwmb-icon fwmb-icon--info" data-tooltip="{{localize 'FILRODENSWMB.UI.RouteSmoothingHint'}}"></i>
    </div>

    <fieldset class="fwmb-fieldset fwmb-space-before-large">
        <legend>{{localize "FILRODENSWMB.UI.SettingsLabelQuickStyles"}}</legend>
        <div class="fwmb-hint fwmb-space-after">
            {{localize "FILRODENSWMB.UI.LabelEditHint"}}
        </div>

        <div class="fwmb-form-group">
            <label>{{localize "FILRODENSWMB.UI.QuickStyles"}}</label>
            <div class="fwmb-form-fields">
                <select name="labelQuickStyle">
                    <option value="custom" {{#if (eq route.label.quickStyle "custom")}}selected{{/if}}>
                        {{localize "FILRODENSWMB.UI.Custom"}}
                    </option>
                    {{#each customLabelStyles}}
                        <option value="{{this.id}}" {{#if (eq ../route.label.quickStyle this.id)}}selected{{/if}}>
                            {{this.name}}
                        </option>
                    {{/each}}
                </select>
            </div>
        </div>

        <div class="fwmb-form-group">
            <label>{{localize "FILRODENSWMB.UI.FontFamily"}}</label>
            <div class="fwmb-form-fields">
                <select name="labelFontFamily">
                    {{#each fonts}}
                        <option value="{{this}}" {{#if (eq ../route.label.fontFamily this)}}selected{{/if}}>{{this}}</option>
                    {{/each}}
                </select>
            </div>
        </div>

        <div class="fwmb-form-group">
            <label>{{localize "FILRODENSWMB.UI.FontSize"}}</label>
            <div class="fwmb-form-fields">
                <div class="fwmb-slider-group">
                    <input type="range" name="labelFontSize" value="{{route.label.fontSize}}" min="0.2" max="5.0" step="0.1" />
                    <output>{{route.label.fontSize}}</output>
                </div>
            </div>
        </div>

        <div class="fwmb-form-group">
            <label>{{localize "FILRODENSWMB.UI.Rotation"}}</label>
            <div class="fwmb-form-fields">
                <div class="fwmb-slider-group">
                    <input type="range" name="labelRotation" value="{{route.label.rotation}}" min="{{rotationRange.MIN}}" max="{{rotationRange.MAX}}" step="{{rotationRange.STEP}}" data-default="0" />
                    <output>{{route.label.rotation}}</output>
                </div>
            </div>
        </div>

        <div class="fwmb-form-group">
            <label>{{localize "FILRODENSWMB.UI.FontColor"}}</label>
            <div class="fwmb-form-fields">
                <input type="color" class="fwmb-swatch fwmb-wide" name="labelFillColor" value="{{route.label.fillColor}}" list="fwmb-standard-colors" />
            </div>
        </div>

        <div class="fwmb-form-group">
            <label>{{localize "FILRODENSWMB.UI.MaxWidth"}}</label>
            <div class="fwmb-form-fields">
                <input type="number" class="fwmb-wide" name="labelMaxChars" value="{{route.label.maxChars}}" min="0" step="1" placeholder="0" />
            </div>
        </div>

        <div class="fwmb-form-group">
            <label>{{localize "FILRODENSWMB.UI.Justify"}}</label>
            <div class="fwmb-form-fields">
                <select name="labelJustify">
                    <option value="left" {{#if (eq route.label.justify "left")}}selected{{/if}}>{{localize "FILRODENSWMB.UI.JustifyLeft"}}</option>
                    <option value="center" {{#if (eq route.label.justify "center")}}selected{{/if}}>{{localize "FILRODENSWMB.UI.JustifyCenter"}}</option>
                    <option value="right" {{#if (eq route.label.justify "right")}}selected{{/if}}>{{localize "FILRODENSWMB.UI.JustifyRight"}}</option>
                </select>
            </div>
        </div>
    </fieldset>
</div>