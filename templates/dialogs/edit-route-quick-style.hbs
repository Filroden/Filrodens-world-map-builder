<div class="fwmb-dialog-content">
    <datalist id="fwmb-standard-colors">
        {{#each palette}}
            <option value="{{this}}"></option>
        {{/each}}
    </datalist>

    <div class="form-group fwmb-dialog-content">
        <label>{{localize "FILRODENSWMB.UI.Name"}}</label>
        <input type="text" name="styleName" value="{{style.name}}" autofocus>
    </div>

    <div class="form-group fwmb-dialog-content" style="margin-top: var(--fwmb-size-10);">
        <label>{{localize "FILRODENSWMB.UI.LineColor"}}</label>
        <input type="color" name="styleColor" value="{{style.color}}" list="fwmb-standard-colors" class="fwmb-swatch fwmb-wide" style="height: 24px; padding: 0;">
    </div>

    <div class="form-group fwmb-dialog-content" style="margin-top: var(--fwmb-size-10);">
        <label>{{localize "FILRODENSWMB.UI.LineThickness"}}</label>
        <div class="fwmb-slider-group">
            <input type="range" name="styleThickness" value="{{style.thickness}}" min="{{thicknessStep}}" max="10" step="{{thicknessStep}}" />
            <output>{{style.thickness}}</output>
        </div>
    </div>

    <div class="form-group fwmb-dialog-content" style="margin-top: var(--fwmb-size-10);">
        <label>{{localize "FILRODENSWMB.UI.LineStyle"}}</label>
        <select name="styleStyle">
            <option value="solid" {{#if (eq style.style "solid")}}selected{{/if}}>{{localize "FILRODENSWMB.UI.StyleSolid"}}</option>
            <option value="dashed" {{#if (eq style.style "dashed")}}selected{{/if}}>{{localize "FILRODENSWMB.UI.StyleDashed"}}</option>
            <option value="dotted" {{#if (eq style.style "dotted")}}selected{{/if}}>{{localize "FILRODENSWMB.UI.StyleDotted"}}</option>
        </select>
    </div>
    <div class="form-group fwmb-dialog-content" style="margin-top: var(--fwmb-size-10);">
        <label class="fwmb-checkbox-label">
            <input type="checkbox" class="fwmb-checkbox" name="styleOutline" {{#if style.outline}}checked{{/if}} />
            {{localize "FILRODENSWMB.UI.RouteOutline"}}
        </label>
        <i class="fwmb-icon info" data-tooltip="{{localize 'FILRODENSWMB.UI.RouteOutlineHint'}}"></i>
    </div>

    <div class="form-group fwmb-dialog-content" style="margin-top: var(--fwmb-size-10);">
        <label class="fwmb-checkbox-label">
            <input type="checkbox" class="fwmb-checkbox" name="styleSmoothing" {{#if style.smoothing}}checked{{/if}} />
            {{localize "FILRODENSWMB.UI.RouteSmoothing"}}
        </label>
        <i class="fwmb-icon info" data-tooltip="{{localize 'FILRODENSWMB.UI.RouteSmoothingHint'}}"></i>
    </div>
</div>