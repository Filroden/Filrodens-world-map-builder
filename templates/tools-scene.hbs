{{!--
    New map (tool id "scene"): the engine, seed, size, latitude and area factor a map is made with;
    a guided map's land masks (drawn with the bar's Land and Ocean modes); and a regional map cut
    from this one (the crop is the bar's Crop mode). The grid is in Cartography.
--}}
{{#> "modules/filrodens-world-map-builder/templates/parts/section.hbs" id="generation" title="FILRODENSWMB.UI.SectionGeneration" badge="FILRODENSWMB.UI.BadgeCreatesMap"}}
    {{#if terrainUpgradeAvailable}}
        <button type="button" class="fwmb-btn fwmb-btn--danger-quiet" data-action="updateMapTerrain" data-tooltip="{{localize 'FILRODENSWMB.UI.UpdateMapHint'}}">
            <i class="fwmb-icon fwmb-icon--sync"></i> {{localize "FILRODENSWMB.UI.UpdateMap"}}
        </button>
    {{/if}}

    <div class="fwmb-form-group">
        <label for="fwmb-generation-engine">{{localize "FILRODENSWMB.UI.GenerationEngine"}}</label>
        <div class="fwmb-form-fields">
            <select id="fwmb-generation-engine" name="generationEngine">
                <option value="standard" {{#if (eq uiState.generationEngine "standard")}}selected{{/if}}>{{localize "FILRODENSWMB.UI.StandardGeneration"}}</option>
                <option value="flat" {{#if (eq uiState.generationEngine "flat")}}selected{{/if}}>{{localize "FILRODENSWMB.UI.FlatCanvas"}}</option>
                <option value="advanced" {{#if (eq uiState.generationEngine "advanced")}}selected{{/if}}>{{engineLabels.advanced}}</option>
                <option value="guided" {{#if (eq uiState.generationEngine "guided")}}selected{{/if}}>{{engineLabels.guided}}</option>
            </select>
            <i class="fwmb-icon fwmb-icon--info" data-tooltip="{{#if (eq uiState.generationEngine 'flat')}}{{localize 'FILRODENSWMB.UI.EngineFlatHint'}}{{else if (eq uiState.generationEngine 'advanced')}}{{localize 'FILRODENSWMB.UI.EngineAdvancedHint'}}{{else if (eq uiState.generationEngine 'guided')}}{{localize 'FILRODENSWMB.UI.EngineGuidedHint'}}{{else}}{{localize 'FILRODENSWMB.UI.EngineStandardHint'}}{{/if}}"></i>
        </div>
    </div>

    {{#unless (eq uiState.generationEngine "flat")}}
        <div class="fwmb-form-group">
            <label for="fwmb-map-seed">{{localize "FILRODENSWMB.UI.MapSeed"}}</label>
            <div class="fwmb-form-fields">
                <input type="text" id="fwmb-map-seed" name="mapSeed" maxlength="{{fwmbTextLimit 'name'}}" value="{{uiState.mapSeed}}" placeholder="{{localize 'FILRODENSWMB.UI.RandomSeed'}}" data-tooltip="{{localize 'FILRODENSWMB.UI.SeedHint'}}" />
                <button type="button" class="fwmb-btn fwmb-btn--square" data-action="randomizeSeed" aria-label="{{localize 'FILRODENSWMB.UI.Randomize'}}" data-tooltip="{{localize 'FILRODENSWMB.UI.Randomize'}}">
                    <i class="fwmb-icon fwmb-icon--shuffle"></i>
                </button>
            </div>
        </div>
    {{/unless}}

    <div class="fwmb-form-group">
        <label>{{localize "FILRODENSWMB.UI.MapSize"}}</label>
        <div class="fwmb-form-fields">
            <input type="number" name="mapWidth" value="{{uiState.mapWidth}}" min="500" max="4000" step="100" aria-label="{{localize 'FILRODENSWMB.UI.MapWidth'}}" />
            <span class="fwmb-times">×</span>
            <input type="number" name="mapHeight" value="{{uiState.mapHeight}}" min="500" max="4000" step="100" aria-label="{{localize 'FILRODENSWMB.UI.MapHeight'}}" />
            <span class="fwmb-unit"><span class="fwmb-unit-long">{{localize "FILRODENSWMB.UI.UnitPixels"}}</span><span class="fwmb-unit-short">{{localize "FILRODENSWMB.UI.UnitPixelsShort"}}</span></span>
        </div>
    </div>

    {{#if (eq uiState.generationEngine "flat")}}
        <!-- Read when the map is created (Create new map), not when it is ticked -->
        <div class="fwmb-form-group">
            <label class="fwmb-setting-row" data-tooltip="{{localize 'FILRODENSWMB.UI.FlatTextureHint'}}">
                <input type="checkbox" name="flatTexture" class="fwmb-checkbox" {{#if uiState.flatTexture}}checked{{/if}} />
                {{localize "FILRODENSWMB.UI.FlatTexture"}}
            </label>
        </div>
    {{/if}}

    <div class="fwmb-form-group">
        <label>{{localize "FILRODENSWMB.UI.Latitude"}}</label>
        <div class="fwmb-form-fields">
            <input type="number" name="latTop" value="{{lookup uiState 'latTop'}}" min="-90" max="90" aria-label="{{localize 'FILRODENSWMB.UI.LatTop'}}" data-tooltip="{{localize 'FILRODENSWMB.UI.LatTop'}}" />
            <span class="fwmb-times">{{localize "FILRODENSWMB.UI.LatitudeTo"}}</span>
            <input type="number" name="latBottom" value="{{lookup uiState 'latBottom'}}" min="-90" max="90" aria-label="{{localize 'FILRODENSWMB.UI.LatBottom'}}" data-tooltip="{{localize 'FILRODENSWMB.UI.LatBottom'}}" />
            <i class="fwmb-icon fwmb-icon--info" data-tooltip="{{localize 'FILRODENSWMB.UI.LatitudeHint'}}"></i>
        </div>
    </div>

    <div class="fwmb-form-group">
        <label for="fwmb-area-factor">{{localize "FILRODENSWMB.UI.AreaFactor"}}</label>
        <div class="fwmb-form-fields">
            <input type="number" id="fwmb-area-factor" name="worldAreaFactor" value="{{worldAreaFactor}}" min="{{areaFactorRange.min}}" max="{{areaFactorRange.max}}" step="1" />
            <i class="fwmb-icon fwmb-icon--info" data-tooltip="{{localize 'FILRODENSWMB.UI.AreaFactorHint'}}"></i>
        </div>
    </div>

    {{!-- The map's unit: the name every distance shown is labelled with (see MapUnit). Its input is
         not named after the state key, so a save's read of the panel never parses it as a number --}}
    <div class="fwmb-form-group">
        <label for="fwmb-map-unit">{{localize "FILRODENSWMB.UI.MapUnit"}}</label>
        <div class="fwmb-form-fields">
            <input type="text" id="fwmb-map-unit" name="mapUnitName" value="{{mapUnit}}" maxlength="{{fwmbTextLimit 'name'}}" aria-describedby="fwmb-pixel-scale" />
            <i class="fwmb-icon fwmb-icon--info" data-tooltip="{{localize 'FILRODENSWMB.UI.MapUnitHint'}}"></i>
        </div>
    </div>
    {{!-- What one pixel measures, written in place as the latitudes, area factor or unit change --}}
    <p class="fwmb-hint" id="fwmb-pixel-scale" data-pixel-scale>{{pixelScale}}</p>

    <button type="button" class="fwmb-btn fwmb-btn--wide" data-action="applyResolution">
        {{localize "FILRODENSWMB.UI.ApplyResolution"}}
    </button>
{{/"modules/filrodens-world-map-builder/templates/parts/section.hbs"}}

{{#if (eq uiState.generationEngine "guided")}}
    {{#> "modules/filrodens-world-map-builder/templates/parts/section.hbs" id="landMasks" title="FILRODENSWMB.UI.LandMasks" badge="FILRODENSWMB.UI.BadgeRebuildsMap"}}
        <div role="listbox" aria-label="{{localize 'FILRODENSWMB.UI.LandMasks'}}" data-list-nav id="fwmb-scroll-landMasks" class="fwmb-list-container fwmb-scrollable fwmb-scrollable--stable">
            {{#each landMasks}}
                <div role="option" tabindex="-1" data-list-item class="fwmb-list-item{{#if this.isActive}} fwmb-is-working{{/if}}" aria-selected="{{#if (eq this.id @root.inspected.landMask)}}true{{else}}false{{/if}}" data-id="{{this.id}}" data-type="landMask" data-action="editLandMask">
                    <div class="fwmb-route-swatch fwmb-route-swatch--solid" style="background-color: {{this.swatchColor}};" data-tooltip="{{#if (eq this.operation 'subtract')}}{{localize 'FILRODENSWMB.UI.LandMaskTypeOcean'}}{{else}}{{localize 'FILRODENSWMB.UI.LandMaskTypeLand'}}{{/if}}"></div>

                    <span class="fwmb-name fwmb-flex-1" title="{{this.name}}">{{this.name}}</span>
                    <span class="fwmb-actions">
                        <button type="button" class="fwmb-btn fwmb-btn--subtle fwmb-btn--square" data-action="zoomToFeature" aria-label="{{localize 'FILRODENSWMB.UI.ZoomTo'}}" data-tooltip="{{localize 'FILRODENSWMB.UI.ZoomTo'}}">
                            <i class="fwmb-icon fwmb-icon--center-focus"></i>
                        </button>
                        <button type="button" class="fwmb-btn fwmb-btn--square fwmb-btn--danger-quiet" data-action="deleteLandMask" aria-label="{{localize 'FILRODENSWMB.UI.Delete'}}" data-tooltip="{{localize 'FILRODENSWMB.UI.Delete'}}">
                            <i class="fwmb-icon fwmb-icon--delete"></i>
                        </button>
                    </span>
                </div>
            {{else}}
                <div class="fwmb-list-empty" role="none">{{localize "FILRODENSWMB.UI.NoLandMasks"}}</div>
            {{/each}}
        </div>

        <button type="button" class="fwmb-btn fwmb-btn--danger-quiet" data-action="deleteAllLandMasks" data-tooltip="{{localize 'FILRODENSWMB.UI.DeleteAllLandMasksHint'}}" {{#unless landMasks.length}}disabled{{/unless}}>
            <i class="fwmb-icon fwmb-icon--delete"></i> {{localize "FILRODENSWMB.UI.DeleteAllLandMasksTitle"}}
        </button>
    {{/"modules/filrodens-world-map-builder/templates/parts/section.hbs"}}
{{/if}}

{{#> "modules/filrodens-world-map-builder/templates/parts/section.hbs" id="regionalMap" title="FILRODENSWMB.UI.SectionRegionalMap" badge="FILRODENSWMB.UI.BadgeCreatesNewMap" closed=true}}
    {{#if canCreateRegionalMap}}
        <p class="fwmb-hint">{{localize "FILRODENSWMB.UI.RegionalMapCropHint"}}</p>
        <div class="fwmb-form-group">
            <label>{{localize "FILRODENSWMB.UI.RegionalResolution"}}</label>
            <div class="fwmb-form-fields">
                <input type="number" name="regionalTargetWidth" value="{{lookup uiState 'regionalTargetWidth'}}" step="100" min="500" aria-label="{{localize 'FILRODENSWMB.UI.TargetWidth'}}" data-tooltip="{{localize 'FILRODENSWMB.UI.TargetWidth'}}" />
                <span class="fwmb-times">×</span>
                <input type="number" name="regionalTargetHeight" value="{{lookup uiState 'regionalTargetHeight'}}" disabled aria-label="{{localize 'FILRODENSWMB.UI.CalculatedHeight'}}" data-tooltip="{{localize 'FILRODENSWMB.UI.CalculatedHeight'}}" />
                <span class="fwmb-unit"><span class="fwmb-unit-long">{{localize "FILRODENSWMB.UI.UnitPixels"}}</span><span class="fwmb-unit-short">{{localize "FILRODENSWMB.UI.UnitPixelsShort"}}</span></span>
            </div>
        </div>
        <div class="fwmb-form-group">
            <label>{{localize "FILRODENSWMB.UI.RegionalLatitude"}}</label>
            <div class="fwmb-form-fields fwmb-setting-row--readout">
                <span>{{localize "FILRODENSWMB.UI.LatTop"}}: <strong id="fwmb-readout-lat-top">--&deg;</strong></span>
                <span>{{localize "FILRODENSWMB.UI.LatBottom"}}: <strong id="fwmb-readout-lat-bottom">--&deg;</strong></span>
            </div>
        </div>
        <label class="fwmb-setting-row" data-tooltip="{{localize 'FILRODENSWMB.UI.RegionalInfillHint'}}">
            <input type="checkbox" name="regionalInfill" class="fwmb-checkbox" {{#if uiState.regionalInfill}}checked{{/if}} {{#unless regionalInfillOffered}}disabled{{/unless}} data-regional-infill />
            {{localize "FILRODENSWMB.UI.RegionalInfill"}}
        </label>
        <button type="button" data-action="generateRegionalMap" class="fwmb-btn fwmb-btn--wide">
            <i class="fwmb-icon fwmb-icon--map"></i> {{localize "FILRODENSWMB.UI.GenerateMap"}}
        </button>
    {{else}}
        <p class="fwmb-hint">{{localize "FILRODENSWMB.UI.RegionalMapNeedsUpdate"}}</p>
    {{/if}}
{{/"modules/filrodens-world-map-builder/templates/parts/section.hbs"}}
