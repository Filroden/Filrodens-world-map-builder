<div class="fwmb-tool-content fwmb-scrollable">

    <fieldset class="fwmb-fieldset">
        <legend>{{localize "FILRODENSWMB.UI.SettingsVisuals"}}</legend>
        {{> "modules/filrodens-world-map-builder/templates/parts/shared-range.hbs" name="contourInterval" label="FILRODENSWMB.UI.ContourInterval" value=(lookup uiState 'contourInterval') min=0.02 max=0.3 step=0.02}}
        {{> "modules/filrodens-world-map-builder/templates/parts/shared-range.hbs" name="reliefShading" label="FILRODENSWMB.UI.ReliefShading" hint="FILRODENSWMB.UI.ReliefShadingHint" value=(lookup uiState 'reliefShading') min=0 max=1 step=0.05 class="spaced"}}
        {{> "modules/filrodens-world-map-builder/templates/parts/shared-range.hbs" name="biomeAlphaActive" label="FILRODENSWMB.UI.ActiveBiomeOpacity" value=(lookup uiState 'biomeAlphaActive') min=0 max=1 step=0.05 class="spaced"}}
        {{> "modules/filrodens-world-map-builder/templates/parts/shared-range.hbs" name="biomeAlphaInactive" label="FILRODENSWMB.UI.InactiveBiomeOpacity" value=(lookup uiState 'biomeAlphaInactive') min=0 max=1 step=0.05}}
        {{> "modules/filrodens-world-map-builder/templates/parts/shared-range.hbs" name="regionOpacity" label="FILRODENSWMB.UI.RegionOpacity" value=(lookup uiState 'regionOpacity') min=0.1 max=1 step=0.1 class="spaced"}}
    </fieldset>

    <fieldset class="fwmb-fieldset">
        <legend>{{localize "FILRODENSWMB.UI.SettingsHydrology"}}</legend>
        {{> "modules/filrodens-world-map-builder/templates/parts/shared-range.hbs" name="maxLakeSize" label="FILRODENSWMB.UI.MaxLakeSize" value=(lookup uiState 'maxLakeSize') min=1000 max=20000 step=500}}
        {{> "modules/filrodens-world-map-builder/templates/parts/shared-range.hbs" name="springAltOffset" label="FILRODENSWMB.UI.SpringAltMin" value=(lookup uiState 'springAltOffset') min=0 max=0.8 step=0.05}}
        {{> "modules/filrodens-world-map-builder/templates/parts/shared-range.hbs" name="springMoistMin" label="FILRODENSWMB.UI.SpringMoistMin" value=(lookup uiState 'springMoistMin') min=0 max=1 step=0.05}}
        {{> "modules/filrodens-world-map-builder/templates/parts/shared-range.hbs" name="meanderJitter" label="FILRODENSWMB.UI.MeanderJitter" value=(lookup uiState 'meanderJitter') min=0 max=0.02 step=0.001}}
    </fieldset>

    <fieldset class="fwmb-fieldset">
        <legend>{{localize "FILRODENSWMB.UI.SettingsClimate"}}</legend>
        {{> "modules/filrodens-world-map-builder/templates/parts/shared-range.hbs" name="altCooling" label="FILRODENSWMB.UI.AltitudeCooling" value=(lookup uiState 'altCooling') min=0 max=1 step=0.05}}
        {{> "modules/filrodens-world-map-builder/templates/parts/shared-range.hbs" name="freezingThreshold" label="FILRODENSWMB.UI.FreezingThreshold" value=(lookup uiState 'freezingThreshold') min=0 max=1 step=0.05}}
    </fieldset>

</div>