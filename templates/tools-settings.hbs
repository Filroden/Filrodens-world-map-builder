{{!--
    Settings: the reader's own appearance for the studio (not part of the map; see src/ui/Theme.js).
    Every setting of the map lives in the tool it configures.
--}}
{{#> "modules/filrodens-world-map-builder/templates/parts/section.hbs" id="appearance" title="FILRODENSWMB.UI.SettingsAppearance"}}
    <div class="fwmb-form-group">
        <label data-tooltip="{{localize 'FILRODENSWMB.UI.ThemeModeHint'}}">{{localize "FILRODENSWMB.UI.ThemeMode"}}</label>
        <div class="fwmb-form-fields">
            <select name="themeMode">
                <option value="auto" {{#if (eq theme.mode "auto")}}selected{{/if}}>{{localize "FILRODENSWMB.UI.ThemeModeAuto"}}</option>
                <option value="light" {{#if (eq theme.mode "light")}}selected{{/if}}>{{localize "FILRODENSWMB.UI.ThemeModeLight"}}</option>
                <option value="dark" {{#if (eq theme.mode "dark")}}selected{{/if}}>{{localize "FILRODENSWMB.UI.ThemeModeDark"}}</option>
            </select>
        </div>
    </div>
    <div class="fwmb-form-group">
        <label data-tooltip="{{localize 'FILRODENSWMB.Settings.ThemeHue.Hint'}}">{{localize "FILRODENSWMB.Settings.ThemeHue.Name"}}</label>
        <div class="fwmb-form-fields">
            <select name="themeHue">
                <option value="gold" {{#if (eq theme.hue "gold")}}selected{{/if}}>{{localize "FILRODENSWMB.Settings.ThemeHue.Gold"}}</option>
                <option value="teal" {{#if (eq theme.hue "teal")}}selected{{/if}}>{{localize "FILRODENSWMB.Settings.ThemeHue.Teal"}}</option>
            </select>
        </div>
    </div>
{{/"modules/filrodens-world-map-builder/templates/parts/section.hbs"}}
