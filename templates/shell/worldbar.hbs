{{!--
    The world bar (v5): one row across the studio's top, above the rail and the canvas. The world
    name menu, Save world, the layer switcher, Settlement maps. (Create and Explore left it in S0
    step 6: the rail holds both again, as v4's.)
    The layer switcher's first segment is World (S0 step 4): it shows the world's own rail (its
    overview and settings editors) in place of a map's, so the switcher says whether the world or
    one of its maps is being worked on. It never wraps: as it narrows it folds (data-fold, see WorldBarFold), and
    this template draws every fold's form so a fold never redraws it:

    - 0: Open world and Save as beside Save world, full map names; 1: those two go into the name
      menu (fwmb-fold-menu items show only once folded); 2: short names; 3: Settlement maps leaves
      the bar for the layer menu; 4: the layer switcher becomes one menu button naming the map;
      5: the world name ellipsises.

    Beside the name: Out of date on a held regional world whose parent changed what it shows, and
    Back to while a regional world's parent is open for its settings (S0 step 5).

    Save world never folds. Parts later tracks fill (Geology, Add a map) are drawn in their places
    and disabled, with a tooltip saying they are not built yet (aria-disabled, so the tooltip still
    shows). Settlement maps (L-surface) is off, with why, until the world has one.
    With no world open (board N5) the name reads No world open, New world sits beside Open world,
    and Save world, Save as and the switcher are off; while a world is being made (N2)
    the same, but for World; a world with no Surface map shows it as a dashed + Surface map (N3)
    and Explore off.
    See MapStudio's #worldBarContext.
--}}
<header aria-label="{{localize 'FILRODENSWMB.UI.WorldBar'}}" data-fold="{{worldBar.fold}}">
    <div class="fwmb-dropdown fwmb-worldbar-menu" tabindex="-1">
        <button type="button" class="fwmb-world-menu" aria-haspopup="menu" aria-label="{{worldBar.nameMenuLabel}}" data-tooltip="{{worldBar.nameMenuLabel}}">
            <span class="fwmb-icon fwmb-icon--public" aria-hidden="true"></span>
            <span class="fwmb-world-name">{{worldBar.name}}</span>
            <span class="fwmb-caret" aria-hidden="true"></span>
        </button>
        <div class="fwmb-dropdown-menu" role="menu" aria-label="{{localize 'FILRODENSWMB.UI.WorldNameMenu'}}">
            <button type="button" role="menuitem" class="fwmb-fold-menu" data-action="changeTool" data-tool="manage"><span class="fwmb-icon fwmb-icon--folder-open" aria-hidden="true"></span> {{localize "FILRODENSWMB.UI.MenuOpenWorld"}}</button>
            <button type="button" role="menuitem" data-action="newWorld"><span class="fwmb-icon fwmb-icon--add" aria-hidden="true"></span> {{localize "FILRODENSWMB.UI.MenuNewWorld"}}</button>
            {{#if worldBar.savesOff}}
            <button type="button" role="menuitem" class="fwmb-fold-menu" aria-disabled="true" data-tooltip="{{worldBar.savesOff}}"><span class="fwmb-icon fwmb-icon--save-as" aria-hidden="true"></span> {{localize "FILRODENSWMB.UI.MenuSaveAs"}}</button>
            {{else}}
            <button type="button" role="menuitem" class="fwmb-fold-menu" data-action="saveMapAs"><span class="fwmb-icon fwmb-icon--save-as" aria-hidden="true"></span> {{localize "FILRODENSWMB.UI.MenuSaveAs"}}</button>
            {{/if}}
            {{#if worldBar.saved}}
            <button type="button" role="menuitem" data-action="exportOpenWorld"><span class="fwmb-icon fwmb-icon--file-export" aria-hidden="true"></span> {{localize "FILRODENSWMB.UI.MenuExportWorld"}}</button>
            {{else}}
            <button type="button" role="menuitem" aria-disabled="true" data-tooltip="{{localize 'FILRODENSWMB.UI.ExportWorldUnsaved'}}"><span class="fwmb-icon fwmb-icon--file-export" aria-hidden="true"></span> {{localize "FILRODENSWMB.UI.MenuExportWorld"}}</button>
            {{/if}}
            <button type="button" role="menuitem" data-action="importMapJson"><span class="fwmb-icon fwmb-icon--upload-file" aria-hidden="true"></span> {{localize "FILRODENSWMB.UI.MenuImportWorld"}}</button>
        </div>
    </div>
    {{!-- A held regional world Out of date (S0 step 5), and, while a regional world's parent is
         open for its settings, whose they are with Back to --}}
    {{#if worldBar.stale}}
    <span class="fwmb-state-mark fwmb-state-mark--stale fwmb-worldbar-stale" role="img" aria-label="{{localize 'FILRODENSWMB.UI.MarkOutOfDate'}}" data-tooltip="{{worldBar.stale}}"><span class="fwmb-icon fwmb-icon--sync" aria-hidden="true"></span><span class="fwmb-fold-full">{{localize "FILRODENSWMB.UI.MarkOutOfDate"}}</span></span>
    {{/if}}
    {{#if worldBar.backTo}}
    <div class="fwmb-worldbar-back">
        <span class="fwmb-worldbar-for">{{worldBar.backTo.line}}</span>
        <button type="button" class="fwmb-barbtn" data-action="backToRegional"><span class="fwmb-icon fwmb-icon--undo" aria-hidden="true"></span>{{worldBar.backTo.label}}</button>
    </div>
    {{/if}}

    {{#if worldBar.savesOff}}
    <button type="button" class="fwmb-barbtn fwmb-barbtn--icon fwmb-save" aria-disabled="true" aria-label="{{localize 'FILRODENSWMB.UI.SaveWorld'}}" data-tooltip="{{worldBar.savesOff}}">
        <span class="fwmb-icon fwmb-icon--save" aria-hidden="true"></span>
    </button>
    {{else}}
    <button type="button" class="fwmb-barbtn fwmb-barbtn--icon fwmb-save{{#if worldBar.dirty}} fwmb-is-dirty{{/if}}" data-action="saveMap" aria-label="{{worldBar.saveLabel}}" data-tooltip="{{worldBar.saveLabel}}">
        <span class="fwmb-icon fwmb-icon--save" aria-hidden="true"></span>
    </button>
    {{/if}}
    {{!-- Open world and Save as beside Save world while there is room (fold 0), else in the name menu --}}
    <div class="fwmb-worldbar-files">
        <button type="button" class="fwmb-barbtn" data-action="changeTool" data-tool="manage"><span class="fwmb-icon fwmb-icon--folder-open" aria-hidden="true"></span>{{localize "FILRODENSWMB.UI.MenuOpenWorld"}}</button>
        {{#if worldBar.noWorld}}
        <button type="button" class="fwmb-barbtn" data-action="newWorld"><span class="fwmb-icon fwmb-icon--add" aria-hidden="true"></span>{{localize "FILRODENSWMB.UI.MenuNewWorld"}}</button>
        {{else if worldBar.savesOff}}
        <button type="button" class="fwmb-barbtn" aria-disabled="true" data-tooltip="{{worldBar.savesOff}}"><span class="fwmb-icon fwmb-icon--save-as" aria-hidden="true"></span>{{localize "FILRODENSWMB.UI.MenuSaveAs"}}</button>
        {{else}}
        <button type="button" class="fwmb-barbtn" data-action="saveMapAs"><span class="fwmb-icon fwmb-icon--save-as" aria-hidden="true"></span>{{localize "FILRODENSWMB.UI.MenuSaveAs"}}</button>
        {{/if}}
    </div>

    <span class="fwmb-sep" aria-hidden="true"></span>

    {{!-- The layer switcher as segments (folds 0 to 2) --}}
    <div class="fwmb-layers" role="radiogroup" aria-label="{{localize 'FILRODENSWMB.UI.LayerSwitcher'}}">
        {{#each worldBar.layers}}
        <button type="button" class="fwmb-layer{{#if (eq this.id 'world')}} fwmb-layer--world{{/if}}{{#if this.unmade}} fwmb-layer--unmade{{/if}}" role="radio" aria-checked="{{#if this.current}}true{{else}}false{{/if}}"{{#if this.disabled}} aria-disabled="true"{{/if}}{{#if this.action}} data-action="{{this.action}}"{{/if}} aria-label="{{#if this.markWords}}{{this.tooltip}}{{else}}{{this.full}}{{/if}}" data-tooltip="{{this.tooltip}}">
            <span class="fwmb-icon fwmb-icon--{{this.icon}}" aria-hidden="true"></span>
            <span class="fwmb-fold-full">{{this.full}}</span><span class="fwmb-fold-short">{{this.short}}</span>
            {{#each this.marks}}<span class="fwmb-layer-mark fwmb-state-mark--{{this.kind}}" aria-hidden="true"><span class="fwmb-icon fwmb-icon--{{this.icon}}"></span></span>{{/each}}
        </button>
        {{/each}}
        <button type="button" class="fwmb-layer fwmb-layer--add" aria-disabled="true" aria-label="{{worldBar.addMap}}" data-tooltip="{{worldBar.addMap}}">
            <span class="fwmb-icon fwmb-icon--add" aria-hidden="true"></span>
        </button>
    </div>

    {{!-- The layer switcher as one menu naming the map (folds 3 and 4), Settlement maps in it --}}
    <div class="fwmb-dropdown fwmb-layers-menu" tabindex="-1">
        <button type="button" class="fwmb-barbtn fwmb-layer--menu" aria-haspopup="menu" aria-label="{{worldBar.layerMenuLabel}}" data-tooltip="{{worldBar.layerMenuLabel}}">
            <span class="fwmb-icon fwmb-icon--{{worldBar.current.icon}}" aria-hidden="true"></span>
            {{worldBar.current.full}}
            <span class="fwmb-caret" aria-hidden="true"></span>
        </button>
        <div class="fwmb-dropdown-menu" role="menu" aria-label="{{localize 'FILRODENSWMB.UI.LayerSwitcher'}}">
            {{#each worldBar.layers}}
            <button type="button" role="menuitemradio" aria-checked="{{#if this.current}}true{{else}}false{{/if}}"{{#if this.disabled}} aria-disabled="true"{{/if}}{{#if this.action}} data-action="{{this.action}}"{{/if}} data-tooltip="{{this.tooltip}}"><span class="fwmb-icon fwmb-icon--{{this.icon}}" aria-hidden="true"></span> {{this.full}}{{#if this.markWords}}<span class="fwmb-menu-note"> · {{this.markWords}}</span>{{/if}}</button>
            {{/each}}
            <button type="button" role="menuitem" aria-disabled="true" data-tooltip="{{worldBar.addMap}}"><span class="fwmb-icon fwmb-icon--add" aria-hidden="true"></span> {{localize "FILRODENSWMB.UI.AddMap"}}</button>
            {{#if worldBar.settlements.enabled}}
            {{#each worldBar.settlements.rows}}
            <button type="button" role="menuitemradio" class="{{#if @first}}fwmb-menu-item--separated{{/if}}" aria-checked="{{#if this.current}}true{{else}}false{{/if}}" data-action="openSettlementMap" data-settlement-id="{{this.id}}"><span class="fwmb-icon fwmb-icon--location-city" aria-hidden="true"></span> {{this.name}}<span class="fwmb-menu-note"> · {{this.meta}}</span>{{#each this.marks}} <span class="fwmb-state-mark fwmb-state-mark--{{this.kind}}"><span class="fwmb-icon fwmb-icon--{{this.icon}}" aria-hidden="true"></span>{{this.label}}</span>{{/each}}</button>
            {{/each}}
            {{else}}
            <button type="button" role="menuitem" class="fwmb-menu-item--separated" aria-disabled="true" data-tooltip="{{#if worldBar.settlements.tooltip}}{{worldBar.settlements.tooltip}}{{else}}{{worldBar.settlementMaps}}{{/if}}"><span class="fwmb-icon fwmb-icon--location-city" aria-hidden="true"></span> {{localize "FILRODENSWMB.UI.SettlementMaps"}}</button>
            {{/if}}
        </div>
    </div>

    {{!-- Settlement maps (L-surface; board L3; leaves the bar at fold 3, for the layer menu): a
         searchable menu of the world's settlement maps, naming the one open; off, with why, while
         the world has none --}}
    {{#if worldBar.settlements.enabled}}
    <div class="fwmb-dropdown fwmb-worldbar-settlements" tabindex="-1">
        <button type="button" class="fwmb-barbtn{{#if worldBar.settlements.open}} fwmb-is-current{{/if}}" aria-haspopup="menu" aria-label="{{worldBar.settlements.label}}" data-tooltip="{{worldBar.settlements.tooltip}}">
            <span class="fwmb-icon fwmb-icon--location-city" aria-hidden="true"></span>
            {{worldBar.settlements.label}}
            {{#unless worldBar.settlements.open}}<span class="fwmb-badge fwmb-badge--count">{{worldBar.settlements.count}}</span>{{/unless}}
            <span class="fwmb-caret" aria-hidden="true"></span>
        </button>
        <div class="fwmb-dropdown-menu fwmb-settlement-menu" role="menu" aria-label="{{localize 'FILRODENSWMB.UI.SettlementMaps'}}" data-settlement-list>
            <input type="search" class="fwmb-settlement-search" data-settlement-search data-panel-ui placeholder="{{localize 'FILRODENSWMB.UI.SearchSettlementMaps'}}" aria-label="{{localize 'FILRODENSWMB.UI.SearchSettlementMaps'}}" />
            {{#each worldBar.settlements.rows}}
            <button type="button" role="menuitemradio" aria-checked="{{#if this.current}}true{{else}}false{{/if}}" data-action="openSettlementMap" data-settlement-id="{{this.id}}" data-settlement-row data-search="{{this.search}}"><span class="fwmb-icon fwmb-icon--location-city" aria-hidden="true"></span> {{this.name}}<span class="fwmb-menu-note"> · {{this.meta}}</span>{{#each this.marks}} <span class="fwmb-state-mark fwmb-state-mark--{{this.kind}}"><span class="fwmb-icon fwmb-icon--{{this.icon}}" aria-hidden="true"></span>{{this.label}}</span>{{/each}}</button>
            {{/each}}
            <p class="fwmb-hint">{{localize "FILRODENSWMB.UI.SettlementMapsMenuHint"}}</p>
        </div>
    </div>
    {{else}}
    <button type="button" class="fwmb-barbtn fwmb-worldbar-settlements" aria-disabled="true" aria-label="{{localize 'FILRODENSWMB.UI.SettlementMaps'}}" data-tooltip="{{#if worldBar.settlements.tooltip}}{{worldBar.settlements.tooltip}}{{else}}{{worldBar.settlementMaps}}{{/if}}">
        <span class="fwmb-icon fwmb-icon--location-city" aria-hidden="true"></span>
        {{localize "FILRODENSWMB.UI.SettlementMaps"}}
        <span class="fwmb-caret" aria-hidden="true"></span>
    </button>
    {{/if}}

    <span class="fwmb-grow"></span>
</header>
