{{!--
    The rail: the open mode's tools grouped by stage (Create's Shape, Populate and Finish, or
    Explore's one stage), then the occasional tools, then Help at its foot. While the world is
    being worked on (World in the layer switcher, S0 step 4) it is the world's rail instead: the
    overview, the settings editors and the whole world's actions, parts still to be built drawn
    disabled with their tooltips, and only the menus and toggles among the occasional tools. The file actions
    (Save world, Save as, Worlds) are the world bar's (v5, S0 step 3). Every button is
    icon-only, named by its aria-label and tooltip, and the arrow keys move along the rail (see
    MapStudio's rail keys).

    The occasional group holds the open mode's occasional tools, the Appearance menu (the reader's
    colour theme, see AppearanceMenu) and, on the web, full screen. When the whole rail does not fit
    the studio's height (data-fwmb-short, see StudioLayout) they fold into the More menu,
    Appearance's two groups inline. Help, last, never folds. When it is narrow the
    rail goes compact and the stage names are hidden visually, but stay as the groups' names.
--}}
<nav aria-label="{{#if railWorld}}{{localize 'FILRODENSWMB.UI.RailWorldLabel'}}{{else}}{{localize 'FILRODENSWMB.UI.RailLabel'}}{{/if}}"{{#if railWorld}} class="fwmb-rail--world"{{/if}}>
    {{#each railStages}}
    <div class="fwmb-rail-group" role="group" aria-labelledby="fwmb-rail-stage-{{this.id}}">
        <span class="fwmb-rail-stage" id="fwmb-rail-stage-{{this.id}}" data-tooltip="{{localize this.label}}">{{localize this.label}}</span>
        {{#each this.tools}}
        {{#if this.disabled}}
        <button type="button" class="fwmb-rail-btn" aria-disabled="true" aria-label="{{localize this.label}}" data-tooltip="{{this.tooltip}}">
            <span class="fwmb-icon fwmb-icon--{{this.icon}}" aria-hidden="true"></span>
        </button>
        {{else}}
        <button type="button" class="fwmb-rail-btn" data-action="{{#if this.action}}{{this.action}}{{else}}changeTool{{/if}}" data-tool="{{this.id}}" aria-label="{{localize this.label}}" data-tooltip="{{#if this.tooltip}}{{this.tooltip}}{{else}}{{localize this.label}}{{/if}}" aria-current="{{#if (eq ../../activeTool this.id)}}page{{else}}false{{/if}}">
            <span class="fwmb-icon fwmb-icon--{{this.icon}}" aria-hidden="true"></span>
        </button>
        {{/if}}
        {{/each}}
    </div>
    {{/each}}

    <span class="fwmb-rail-spacer"></span>

    <div class="fwmb-rail-group fwmb-rail-occasional" role="group" aria-label="{{localize 'FILRODENSWMB.UI.RailOccasional'}}">
        {{#each railOccasional}}
        {{#if this.tool}}
        <button type="button" class="fwmb-rail-btn" data-action="changeTool" data-tool="{{this.tool}}" aria-label="{{localize this.label}}" data-tooltip="{{localize this.label}}" aria-current="{{#if (eq ../activeTool this.tool)}}page{{else}}false{{/if}}">
            <span class="fwmb-icon fwmb-icon--{{this.icon}}" aria-hidden="true"></span>
        </button>
        {{else if this.menu}}
        {{!-- The Appearance menu (see AppearanceMenu): a popover beside its button --}}
        <div class="fwmb-appearance fwmb-dropdown--beside">
            <button type="button" class="fwmb-rail-btn" data-action="toggleAppearance" aria-haspopup="menu" aria-expanded="false" aria-label="{{this.appearance.tooltip}}" data-tooltip="{{this.appearance.tooltip}}">
                <span class="fwmb-icon fwmb-icon--{{this.icon}}" aria-hidden="true"></span>
            </button>
            <div class="fwmb-dropdown-menu fwmb-appearance-menu" popover="manual" role="menu" aria-label="{{localize this.label}}">
                {{#each this.appearance.groups}}
                <div role="group" class="fwmb-menu-group" aria-labelledby="fwmb-appearance-{{this.key}}">
                    <div class="fwmb-menu-heading" id="fwmb-appearance-{{this.key}}">{{localize this.label}}</div>
                    {{#each this.items}}
                    <button type="button" role="menuitemradio" tabindex="-1" aria-checked="{{#if this.checked}}true{{else}}false{{/if}}" data-action="chooseAppearance" data-theme-key="{{../key}}" data-value="{{this.value}}">{{localize this.label}}</button>
                    {{/each}}
                </div>
                {{/each}}
            </div>
        </div>
        {{else}}
        <button type="button" class="fwmb-rail-btn" data-action="{{this.action}}" aria-label="{{localize this.label}}" data-tooltip="{{localize this.label}}" aria-pressed="{{#if this.pressed}}true{{else}}false{{/if}}">
            <span class="fwmb-icon fwmb-icon--{{this.icon}}" aria-hidden="true"></span>
        </button>
        {{/if}}
        {{/each}}
    </div>

    {{!-- The occasional tools again, in one menu, for a short studio --}}
    <div class="fwmb-dropdown fwmb-dropdown--beside fwmb-rail-more" tabindex="-1">
        <button type="button" class="fwmb-rail-btn" aria-haspopup="menu" aria-label="{{localize 'FILRODENSWMB.UI.RailMore'}}" data-tooltip="{{localize 'FILRODENSWMB.UI.RailMore'}}" aria-current="{{#if railOccasionalActive}}page{{else}}false{{/if}}">
            <span class="fwmb-icon fwmb-icon--more-vert" aria-hidden="true"></span>
        </button>
        <div class="fwmb-dropdown-menu" role="menu" aria-label="{{localize 'FILRODENSWMB.UI.RailOccasional'}}">
            {{#each railOccasional}}
            {{#if this.tool}}
            <button type="button" role="menuitem" data-action="changeTool" data-tool="{{this.tool}}" aria-current="{{#if (eq ../activeTool this.tool)}}page{{else}}false{{/if}}">
                <span class="fwmb-icon fwmb-icon--{{this.icon}}" aria-hidden="true"></span> {{localize this.label}}
            </button>
            {{else if this.menu}}
            {{else}}
            <button type="button" role="menuitemcheckbox" data-action="{{this.action}}" aria-checked="{{#if this.pressed}}true{{else}}false{{/if}}">
                <span class="fwmb-icon fwmb-icon--{{this.icon}}" aria-hidden="true"></span> <span class="fwmb-menu-text">{{localize this.label}}</span>
            </button>
            {{/if}}
            {{/each}}
            {{!-- The Appearance menu's two groups, inline --}}
            {{#each railOccasional}}{{#if this.menu}}
            {{#each this.appearance.groups}}
            <div role="group" class="fwmb-menu-group" aria-labelledby="fwmb-more-appearance-{{this.key}}">
                <div class="fwmb-menu-heading" id="fwmb-more-appearance-{{this.key}}">{{localize this.label}}</div>
                {{#each this.items}}
                <button type="button" role="menuitemradio" aria-checked="{{#if this.checked}}true{{else}}false{{/if}}" data-action="chooseAppearance" data-theme-key="{{../key}}" data-value="{{this.value}}">{{localize this.label}}</button>
                {{/each}}
            </div>
            {{/each}}
            {{/if}}{{/each}}
        </div>
    </div>

    {{!-- Help, last, in the inspector's column (see HelpPanel); never folded into More --}}
    <span class="fwmb-rail-sep"></span>
    <div class="fwmb-rail-group fwmb-rail-help" role="group" aria-label="{{localize 'FILRODENSWMB.UI.Help'}}">
        <button type="button" class="fwmb-rail-btn" data-action="toggleHelp" aria-pressed="{{#if helpOpen}}true{{else}}false{{/if}}" aria-label="{{localize 'FILRODENSWMB.UI.Help'}}" data-tooltip="{{localize 'FILRODENSWMB.UI.Help'}}">
            <span class="fwmb-icon fwmb-icon--help" aria-hidden="true"></span>
        </button>
    </div>
</nav>
