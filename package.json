    "handlebars": "^4.7.8",
    "happy-dom": "^20.14.6"
  },
  "dependencies": {
    "pixi.js": "^7.4.2",
    "playwright": "^1.64.0"
  },
  "allowScripts": {
    "pixi.js@7.4.2": true,
    "playwright@1.64.0": true,
    "classic-level@1.4.1": true
  },
  "engines": {
    "node": ">=22"
  }
