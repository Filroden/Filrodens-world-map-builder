{
  "name": "visage",
  "type": "module",
  "scripts": {
    "pack": "node scripts/pack.mjs",
    "pack:web": "node scripts/pack.mjs --web",
    "serve:web": "node scripts/serve-web.mjs",
    "foundry-id": "node scripts/foundry-id.mjs",
    "fixtures": "node tests/mesh/fixtures/build-p0jbva.mjs",
    "pretest": "node tests/mesh/fixtures/build-p0jbva.mjs --if-missing",
    "test": "node --test \"tests/**/*.test.mjs\"",
    "tutorial:build": "node tests/tutorial/run.mjs --build",
    "tutorial:texts": "node tests/tutorial/texts.mjs",
    "lint": "eslint main.js src tests scripts web"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@foundryvtt/foundryvtt-cli": "3.0.0",
    "eslint": "^10.12.0",
